  ~<sub_domain["CSS Typed OM — phases 17-24"]>{
    .note: "the Typed OM API provides structured access to CSS values — CSSStyleValue subclasses
            replace string parsing with typed objects. This sub-domain evaluates migration
            feasibility from string CSSOM to Typed OM for runtime style manipulation.
            Spec reference: CSS Typed OM Level 1 (W3C Working Draft)"
    ^root[typed_om]{ !state: imagined note: "no attributeStyleMap, computedStyleMap or CSS.number() in book/scripts" }
    ^root[string_cssom]{ !state: live .at: "book/scripts/modules/scene-light.mjs" note: "119 style.setProperty writes in 25 files and 6 getComputedStyle reads in 4; scene-light writes registered <number>s as strings and parses them back with parseFloat" }
    ~"branches"[
      { axis: "where a migration begins" scene_light: "the one module that writes and reads back the same registered tokens, so a typed write and a typed read would meet" hot_paths: "the most frequent writes first, whichever phase 23's harness finds" now: "neither; phase 17 has six reads to read, phase 18 has 119 writes" }
      { axis: "reach" typed_with_floor: "a typed write where Typed OM exists and the string write beside it elsewhere" maker_only: "Typed OM only in tools a maker runs, never in the reader's path" now: "strings everywhere; a wonder below guesses what each engine returns" }
      { axis: "shown or used" used: "typed values kept inside the code" shown: "the scribe's desk prints a token as CSS.number(0.6) beside the reader's dial, so the workshop veil reads the type the page is made of (c017)" now: "neither" }
    ]
  }

  ^phase["Typed Om Read Audit"]{
    @slug: typed_om_read_audit
    ^task{
      @intent: "audit read-path opportunities — where getComputedStyle().getPropertyValue()
                could be replaced with computedStyleMap().get() for typed value access"
      @audit: "enumerate call sites; for each: determine return type (CSSUnitValue, CSSKeywordValue,
               CSSTransformValue, etc.); assess whether typed access simplifies downstream logic"
      @evidence: "CSS Typed OM §4 (StylePropertyMapReadOnly), §5 (CSSStyleValue subclasses)"
      @recommendation: classify_adopt_guardrail_monitor_reject
    }
    ={ "book/audits/houdini/17-typed_om_read_audit.spw" }
