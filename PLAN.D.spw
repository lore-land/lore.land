    ^root[paint_worklet]{ !state: imagined note: "no registerPaint, CSS.paintWorklet or CSS paint() in book/styles or book/scripts; the paint() calls in scripts are local functions of that name" }
    ^root[paper_grain]{ !state: live .at: "book/styles/chapter/reading.css" note: "the grain and edge overlay is an feTurbulence SVG data URI weighted by --knob-grain and --knob-edge, the very case phase 05 names for a worklet" }
