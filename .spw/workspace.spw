# Lore.Land Workspace Process
#>lore_land_workspace
#:process #!reference

^"roots"{
  @spw: ~"."
  @repo: ~".."
  @index: ~"./index.spw"
  @mount: ~"./mount.spw"
  @surfaces: ~"./surfaces"
  @runtime: ~"./runtime"
  @chapters: ~"./chapters"
}

^intent{
  hypothesis: "Story pages are readable as prose, shareable as intrigue, installable as an honest PWA, and inspectable as Spw runtime systems."
  architecture: ["chapter-json", "DOM runtime", "Spw handles", "ebook navigation", "ethos probes"]
  publish_surface: ["select", "transform", "validate", "emit"]
  platform_surface: "shell (sw/manifest) + meta (og/twitter) + build (vite/sitemap) + canon-sync"
  atelier_surface: "wonder (signature moments) + alignment ledger + literacy ladder + refinement passes p1-p5"
}

^contracts{
  c001: "Keep chapter .spw references synced with chapter-data JSON (prose SoT: book/content/chapters/*.json)."
  c002: "All navigation handles remain legible in plain text."
  c003: "Claim panels map interaction events to falsifiable status updates."
  c004: "Runtime stage vocabulary remains consistent across chapter and home surfaces."
  c005: "Observable metrics stay structurally stable for tools and LSP consumers."
  c006: "Service worker precache lists only assets that exist at deploy HEAD; CACHE_VERSION tracks release token."
  c007: "Every public monument URL carries description + OG + Twitter summary_large_image packaging."
  c008: "Vite production build emits every public MPA door linked from hub navigation (incl. zine, offline)."
  c009: "Ethos claim ids match .spw/claims/chapter-claims.spw; spec/impl/probe rows resolve to walkable refs."
  c010: "Release token has a single source of truth (cache-context.mjs + build-chapters.mjs); README follows, never leads."
  c011: "Every noticed misalignment resolves to a ledger entry — defect scheduled or intention recorded (.spw/state/alignment-ledger.spw)."
  c012: "Signature wonder moments degrade to calm reading under reduced-motion, no-JS, and print."
  c013: "Media plates derive from scene canon; iterative studies use {name}-v{N} naming and graduate through the ledger."
  c014: "Literacy ladder rungs are opt-in; each rung has a visible, dismissible on-ramp on the rung below."
  c015: "Refinement passes are additive and leave precipitates; pass N+1 never requires hand re-verifying pass N."
  c016: "Chapter prose ships prerendered in the page; one renderer (chapter-render.mjs) serves build and browser, so no-JS, search, reader mode and first paint all get the story."
  c017: "Readers see words, scribes see Spw: every Spw instrument waits behind the scribe's desk (reader-tier whitelist in chapter/reading.css), and the desk relabels the reader's own controls in Spw."
  c018: "The reading nook belongs to the reader: coziness, texture and hearth persist per reader, apply before first paint, and sound starts only from the reader's gesture."
  c019: "Nobody loses what they had: returning readers keep the defaults they learned (cohort), new features ship off, trials reach engaged readers or ?try links, and a returning reader is told in plain words what moved."
  c020: "Strains leave lore.land as grammar, never nouns: a pattern travels to boon.land, bane.land or bone.land only after it roots here, as a host-neutral module plus contract (.spw/surfaces/inoculant.spw)."
  c021: "One grammar, two registers: every Spw operator and container has a literary reading, a library reading and a witness line (spw-resonance.mjs, importable by spwashi.com); every chapter ends by sending the reader into a library (shelf-list.json)."
  c022: "The Scriptorium is the reader's desk: every desk action is a Spw spell shown on its card, castable by tap or by typing; plain words search the book and open on the words (text fragments); practice checks spells without casting."
  c023: "Every chapter can be read as boon, bane or bone: paragraphs carry a lean (authored or read), the lens weights without removing, and bone brings up the notation (.spw/surfaces/resonance.spw#valence_lens)."
  c024: "Canonical prose is variant zero: a living slot's first variant reproduces the authored sentence exactly and is what the build prerenders; no slot carries plot facts, names, anchors or wonder terms (PLAN.E L15)."
  c025: "The page reads its own notation on demand: bracework blocks prerender as expression and gloss; the vendored Spw interpreter loads only when a block nears the viewport, and a block it reads as prose says so (PLAN.E L14)."
  c026: "No book file reaches main unless npm run book:check passes: chapter shape, slots, bracework, almanac terms, sighting anchors, compass words (PLAN.E L13)."
  c027: "Nothing is a dead end: every wonder links to each place it lives and to the almanac; every chapter names the wonders it holds (PLAN.E L09)."
  c028: "Soil glints, never shifts: reference-projected motion lights components without reordering or reflowing prose, and stops under reduced motion (PLAN.E L16)."
  c029: "Intergenerational Media Literacy is a core value: every made thing says how it was made (lettered or penned, study or plate, changed on purpose and how), every address reads part by part, and every curriculum plan is something to make and a question to ask about media, to talk over with whoever is at the table (.spw/surfaces/texture-website.spw#value)."
  c030: "Packs add without changing: each lives where its route says (book/content/packs/<surface>/@<who>/), answers lore.land/?/<surface>/@<who>, lists what it brings, links every source where it lives (never copies), and is removed by removing its line from book/content/packs/index.json; book:check holds every pack (packs.mjs packProblems)."
  c031: "Pages settle before they are seen: what a page's scripts fill keeps its settled room (or arrives in the top layer), nothing above the fold moves after first paint, and every public page measures under 0.1 cumulative layout shift."
  c032: "One version token per file: every reference to a stylesheet or module carries the same ?v= token, so nothing loads twice (npm run tokens:align; --check in CI)."
  c033: "A way through is a line: what a reader sets aside and keeps apart is one Spw line the panel writes and typing reads back; the prerendered page is the book as it stands and only a reader who asks sees a passage told another way, marked where it changes with a button to read it as written; no mark is touched, a chapter after one stepped over says what it held, and the lanes keep to the same line (way-through.mjs; way.json held by book:check; a swap adds no spoken line)."
}

^contract_status{
  .note: "as of platform ship audit 2026-07-16"
  c001: "passing — regenerated 2026-07-17 via spw:export; every chapter title matches JSON"
  c002: "holding — handles remain plain-text legible in rail"
  c003: "partial — untested→active on mapped signals; confirmed|refuted + history still PLAN.B"
  c004: "holding — lifecycle_bridge vocabulary shared"
  c005: "holding — observable.spw shape stable"
  c006: "passing — precache = offline shell + two icons; CACHE_VERSION tracks the release token (spw:probes flags a lag); kept chapters live in lore-pages-v1 across releases (network-first, so never stale online); offline page lists the shelf from cache"
  c007: "passing — every chapter shares a 1200x630 card: its public plate set in the cover type (npm run assets:brand → book/images/og/); home shares the v2 cover crop"
  c008: "passing — zine + offline in vite input; dist:static copies sw/manifest/seeds/images/icons/sitemap/robots"
  c009: "passing — lore-cNNN parity; hydration + walkable refs; public projection tool for dist Pages"
  c010: "passing — code + README share the release token (cache-context + build-chapters SoT); SW CACHE_VERSION follows"
  .note_atelier: "as of atelier surface mount 2026-07-16"
  c011: "instrumented — probe kit live (spw:probes); complaint route unwired until PLAN.B engine"
  c012: "passing — AL-007 closed; cross-document view transitions turn pages (none under reduced-motion); reveal never hides prerendered prose"
  c013: "starting — plates.spw drafted; material-study-v1 + wonder-path-v1 in flight; no plate graduated"
  c014: "partial — read/notice/explore rungs live; author rung on-ramp is the scribe's desk toggle in the reader rail (guide: .spw/surfaces/enchantment.spw); operate/inspect on-ramps implicit"
  c015: "holding — probe kit shipped (atelier phase 03); pass reruns are one command with .spw precipitates"
  .note_reading: "as of reading-contract release 2026-09-26"
  c016: "passing — every chapter prerendered by chapters:build; browser renders only when data-prerendered is absent"
  c017: "passing — reader register plain; scribe register tokenized Spw; component chips scribe-only"
  c018: "passing — reading-nook.mjs + head script; hearth is synthesized Web Audio, off by default"
  c019: "passing — reading-switches.mjs: cohort decided pre-paint; full-rail + logline kept for returning; trials gated at 3 chapters or ?try; changes.json return notes"
  c020: "seeded — six strains named; none grafted yet; lands receive in their own register per story-boonhonk crossing_rule"
  c021: "passing — 12 operators + 4 containers read in story, stacks, machine and signal (.spw/surfaces/resonance.spw); a shelf list per chapter; the grammar, faintly is a trial"
  c022: "passing — scriptorium-desk.mjs + desk.css; build writes book/content/catalog.json and search.json; PWA shortcut 'Your desk'; lenses renamed as Spw physics expressions"
  .note_living: "as of PLAN.E 2026-11-06"
  c024: "passing — 69 slots across 15 chapters (15 minute, 40 hour, 14 day); variant zero byte-identical to the authored prose (checked against HEAD); living.mjs waits outside the reading band; trial switch 'living' (?try=living); desk ?[living]"
  c025: "passing — six bracework plates (ch04, 06, 09, 10, 13, 15); five parse, ch04's &[boon, bane]{table} says honestly it reads as prose; spw-seed is a lazy chunk loaded near the viewport"
  c026: "passing — npm run book:check (book/schema/book-types.mjs) in CI: 0 errors, 0 warnings"
  c027: "passing — wonder cards, almanac entries and every chapter colophon (Wonders here) link each place; dead-end probe still to write (L09)"
  c028: "passing — soil glints (text-shadow only, period projected from places lived) ride the living trial; none under reduced motion"
  c023: "passing — valence-lens.mjs + lens-control.mjs genre dial (continuous boon/bane/bone weights, pre-paint); 45 boon / 29 bone / 17 bane paragraphs by vocabulary, 3 authored; story copy revised toward the Egg (ch 1, 5, 9–13) and re-paced into beats; six WAPboy sightings in marginalia"
  c029: "starting — spwashi's hand says lettered or penned for every glyph and what was changed on purpose; its address reads part by part and carries what you write and tune; eight plans, each with a question and who it is for (2026_11_09.H)"
  c030: "passing — one pack (spwashi, a maker, at ?/texture.website/@spwashi) in book/content/packs/index.json; book:check holds its route, sources, files, page, scheme and curriculum (2026_11_09.H)"
  c031: "passing — measured 2026-11-09 on a local server: home 0, chapters 0–0.08, almanac 0.001, pie 0.06, folios 0.008, scriptorium 0.005, texture 0.06, zine 0.007 (were up to 0.31); hub-main holds its room at the end (align-content: start), the desk, wall and spell reserve theirs, the reading band ships in the chapter template, the rail keeps a reserve until its panels arrive, the pie voyage settles unseen (2026_11_09.I)"
  c032: "passing — 148 files referenced, one token each; story-lexicon.mjs was instantiated four times on a chapter, likeness, characters and spw-spell twice on the desk (2026_11_09.I)"
  c033: "trial — switch way-through off by default; book:check holds every wonder to one edit, every swap to its place, and the line to the interpreter."
}

&lifecycle{
  boon: "preloader"
  bane: "fallback spinner"
  bone: "skeleton loaded"
  bonk: "acoustics and spacing check"
  honk: "resolution and harmony"
}

&maintenance{
  regenerate_chapters_spw: "npm run spw:export"
  project_public_spw: "npm run spw:project"
  verify_public_spw: "npm run spw:verify"
  chapters_html: "npm run chapters:build"
  alignment_probes: "npm run spw:probes (--strict for CI) → .spw/audits/alignment-probes-*.spw"
  full_build: "npm run build"
  build_pipeline: "chapters:build → spw:export → canon:build → vite build → spw:project → dist:static"
  dist_static: "npm run dist:static — sw.js, manifest, robots, sitemap, seeds, book/images, icons"
  dist_verify: "npm run dist:verify"
  public_spw_emit: "dist/.spw/ (lore allowlist; never _workbench or tools)"
  source_of_truth_prose: "book/content/chapters/*.json"
  source_of_truth_html_embed: "book/chapter/*/index.html#chapter-data"
  surfaces_registry: ".spw/surfaces/index.spw"
  platform_plan: ".spw/surfaces/platform.spw"
  platform_audit: ".spw/audits/platform-ship-audit-2026-07-16.spw"
  runtime_manifest: ".spw/runtime/precipitates.spw"
  observable_state: ".spw/state/observable.spw"
  alignment_ledger: ".spw/state/alignment-ledger.spw"
  atelier_plan: ".spw/surfaces/atelier.spw"
  release_token: "book/scripts/modules/cache-context.mjs"
  brand_assets: "npm run assets:brand — chapter share cards (book/images/og/) + PWA icons from the bud sigil; authoring-time, needs magick + rsvg-convert + Georgia"
  chapter_renderer: ~"book/scripts/modules/chapter-render.mjs"
  reading_contract: ~"book/styles/chapter/reading.css"
  enchantment_guide: ~".spw/surfaces/enchantment.spw"
  inoculant_theory: ~".spw/surfaces/inoculant.spw"
  resonance_contract: ~".spw/surfaces/resonance.spw"
  shelf_list: "book/content/world/shelf-list.json — each chapter's shelf-mates by LC and Dewey call number"
  desk: "scriptorium/index.html#desk — scriptorium-desk.mjs (spells, search, practice); catalog.json + search.json generated by chapters:build"
  reader_switches: ~"book/scripts/modules/reading-switches.mjs"
  return_notes: "book/content/changes.json — add a plain-words entry every release"
  seal_checklist: ~".spw/surfaces/platform.spw#seal_checklist_additions"
  public_projection: ~".spw/surfaces/publish.spw#spw_public_projection"
}

~priority{
  p0: ["social OG art plates (atelier phase 02 — ground plates.spw seeds first)"]
  p1: ["Pages seal for /.spw/** after dist deploy", "PLAN.B diagnostics engine"]
  p2: ["font self-host (ledger AL-004)", "SW update toast", "c014 literacy on-ramps beyond the scribe's desk", "complaint → refutation channel"]
}
