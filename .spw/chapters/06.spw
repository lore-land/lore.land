^[chapter/06/sections][
  s01: <
    handle: "custom-boof/01"
    type: "custom-boof"
    excerpt: "Boof stepped into Bonk City the way you step into a struck bell. The streets were a Fool’s Labyrinth of leaning glass. Every lantern turned toward the egg. The lanterns were not the light. They were glass: they showed..."
    route: ^[chapter/06/s01]{open}
  >
  s02: <
    handle: "custom-labyrinth/02"
    type: "custom-labyrinth"
    excerpt: "\"In the labyrinth, the way forward is always through the glass,\" a voice said from the twisting paths. \"Do not confuse the pane with the flame. The city offers light. The offering is not the cell.\""
    handles: ["labyrinth-intro"]
    route: ^[chapter/06/s02]{open}
  >
  s03: <
    handle: "custom-fool/03"
    type: "custom-fool"
    excerpt: "\"You’ve found my maze, Boof,\" the Fool’s voice teased from all directions, \"but the real question is whether you can tell glass from heat when every street is leaning.\""
    route: ^[chapter/06/s03]{open}
  >
  s04: [
    handle: "figure/04"
