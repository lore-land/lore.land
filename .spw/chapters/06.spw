    image: "/book/images/06.png"
    route: ^[chapter/06/s04]{open}
  ]
  s05: {
    handle: "section/05"
    type: "section"
    title: "The Shifting Maze"
    excerpt: "The city was alive in the way glass is alive when it holds a flame. No matter how far Boof walked, the lanterns rearranged around the egg. Each impact named a dent into light — spectacle with civic duty. She understoo..."
    route: ^[chapter/06/s05]{open}
  }
  s06: <
    handle: "custom-boof/06"
    type: "custom-boof"
    excerpt: "Boof paused. \"Is this part of the game?\" The Fool's laughter came from behind a pane. \"Perhaps the only way out,\" she mused, \"is to stop asking the glass to be the fire.\" Ahead, a market stone waited with a groove for..."
    route: ^[chapter/06/s06]{open}
  >
]

