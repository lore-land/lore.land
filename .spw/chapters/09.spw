^[chapter/09/sections][
  s01: <
    handle: "custom-boof/01"
    type: "custom-boof"
    excerpt: "The ridge was a puzzle before it was a skyline. Eight shards of a broken honk lay in an arc, each one a relic of a call that had reached someone. The pieces rearranged with every step Boof took. The ninth place in the..."
    route: ^[chapter/09/s01]{open}
  >
  s02: <
    handle: "custom-puzzle/02"
    type: "custom-puzzle"
    excerpt: "The puzzle was incomplete on purpose. No single keeper can hold the whole call. \"Solve this,\" a voice whispered, \"if you can.\" Solving was the wrong verb. Seeing the kernel was enough: eight receipts of listening, one..."
    handles: ["puzzle-intro"]
    route: ^[chapter/09/s02]{open}
  >
  s03: <
    handle: "custom-fool/03"
    type: "custom-fool"
    excerpt: "\"It’s not about solving, Boof,\" the Fool’s voice whispered, \"it’s about seeing which shard was never a horn.\""
    route: ^[chapter/09/s03]{open}
  >
  s04: [
    handle: "figure/04"
    type: "figure"
    image: "/book/images/09.png"
    route: ^[chapter/09/s04]{open}
  ]
  s05: {
    handle: "section/05"
    type: "section"
    title: "The Pieces Shift"
    excerpt: "Boof knelt among the shards. Some fitted. Others refused, as if the call itself resisted a single owner. Scattering forces community: no one clerk can hold the whole broadcast. The egg in the ninth place was the kerne..."
    route: ^[chapter/09/s05]{open}
  }
  s06: <
    handle: "custom-boof/06"
    type: "custom-boof"
    excerpt: "\"How can I solve this if I don’t know what it is?\" Boof murmured. She did not need the full picture. She needed the kernel, and she was already carrying it."
    route: ^[chapter/09/s06]{open}
  >
]

