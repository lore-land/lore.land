    route: ^[chapter/02/s03]{open}
  >
  s04: <
    handle: "custom-echo/04"
    type: "custom-echo"
    excerpt: "\"Follow me,\" said an echo that used Boof’s own pitch from years earlier—the careful, rhythmic clerk-voice she had used back when she thought order was a matter of correct filing. The path forked around an ancient holl..."
    route: ^[chapter/02/s04]{open}
  >
