    route: ^[chapter/08/s02]{open}
  >
  s03: <
    handle: "custom-fool/03"
    type: "custom-fool"
    excerpt: "He sat the trapdoor's edge with his boots over the dark, tapping the game's rhythm on the iron ring, taking the tavern's off-key song and handing it back on-key, with interest."
