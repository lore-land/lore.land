^[chapter/04/sections][
  s01: <
    handle: "custom-boof/01"
    type: "custom-boof"
    excerpt: "Council hill kept a table that did not pick a side. Boof set the egg on the wood between two keys and stumbled, almost, upon the Fool’s Mirror — a pane of weather that showed not a face but the size of a permission. O..."
    route: ^[chapter/04/s01]{open}
  >
  s02: <
    handle: "custom-mirror/02"
    type: "custom-mirror"
    excerpt: "The Fool’s Mirror shimmered with the shared storm. It whispered, \"What you see is not what is, but what you are still allowed to do.\" Boon saw a harvest. Bane saw a constraint. The egg saw neither. It kept its own law..."
    handles: ["mirror-intro"]
    route: ^[chapter/04/s02]{open}
  >
  s03: <
    handle: "custom-fool/03"
    type: "custom-fool"
    excerpt: "\"Look into the glass, Boof,\" the Fool’s voice carried on the crosswind. \"In it you will see not me, but the edge of your key. File it smaller if you must. Do not pretend it grew overnight.\""
    route: ^[chapter/04/s03]{open}
  >
  s04: [
    handle: "figure/04"
    type: "figure"
    image: "/book/images/04.png"
    route: ^[chapter/04/s04]{open}
  ]
  s05: {
    handle: "section/05"
    type: "section"
    title: "The Reflections of the Fool’s Mirror"
    excerpt: "As Boof gazed into the glass, her reflection shifted with the weather. Boon and bane sat under one roof and bargained without declaring war. The membrane between them was the table itself — you could share a turn acro..."
    route: ^[chapter/04/s05]{open}
  }
  s06: <
    handle: "custom-boof/06"
    type: "custom-boof"
    excerpt: "Boof left both keys on the table. A key you do not take cannot be accused of growing. She took the egg. Downslope the counting rooms had begun to disagree with themselves — two receipts that could not both post. That ..."
    route: ^[chapter/04/s06]{open}
  >
]

