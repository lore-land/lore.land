%sigils{
  probe: { sigil: "?" rooms: 6 chapters: "2 3 4 6 10 14" components: "every place that asks the reader something says what an answer does" creatures: "which wonders are questions (the Egg is one, never answered)" ecology: "what in the land is still undecided, and is it allowed to stay so" interaction: "a probe never commits anything: hovering, peeking, asking" state: "seed" }
  potential: { sigil: "~" rooms: 12 chapters: "1 2 4 6 7 8 9 10 11 12 13" components: "what lasts a while shows how long (timers, glows, tellings that may turn)" creatures: "gifts that last (lit, lag, unkept) name their giver" ecology: "what is held in reserve: berries under snow, a wish unspent" interaction: "nothing potential is lost on a reload unless it was meant to fade" state: "seed" }
  perspective: { sigil: "@" rooms: 3 chapters: "4 14 15" components: "whose eyes a component speaks from is visible (voices, doorplates @keeper)" creatures: "who watches whom: the stag unseen, the figure noticed" ecology: "Boof by nose, the ants by street, the city by glass" interaction: "a reader can always tell whose view they are in" state: "seed" }
  confluence: { sigil: "&" rooms: 7 chapters: "1 3 4 9 12 14 15" components: "where two things merge, both stay readable (combines, carries, palettes)" creatures: "wonders that only work together" ecology: "harmonies: what keeps what" interaction: "a merge is reversible or says it is not" state: "seed" }
  value: { sigil: "*" rooms: 6 chapters: "2 3 7 11 12 14" components: "what can be kept is shown as kept (cards, wonders, palettes)" creatures: "each creature has a card and a spell" ecology: "what the land treasures without owning" interaction: "keeping something never costs the reader anything they did not choose" state: "seed" }
  integration: { sigil: "^" rooms: 8 chapters: "2 5 6 9 10 12 15" components: "what binds upward says where it goes (^card, ^projects, ^upstream)" creatures: "gifts that turn a card or change a chapter" ecology: "how small things add up to a season" interaction: "every integration leaves a mark the reader can find" state: "seed" }
  action: { sigil: "!" rooms: 8 chapters: "1 3 4 10 11 13 14" components: "every action is a control a hand can reach, and says what it did (settle)" creatures: "knocks, honks, foils: what happens at once" ecology: "storms, bursts, a bag of flour" interaction: "no action is irreversible without a warning" state: "seed" }
  annotation: { sigil: "#" rooms: 6 chapters: "1 7 8 9 13 15" components: "what is said is legible on every cover (contrast), never only on hover" creatures: "each wonder says one line of its own" ecology: "sayings: rules the makers keep" interaction: "a note can be copied and travels with its origin (#from)" state: "seed" }
  ground: { sigil: "." rooms: 7 chapters: "1 6 7 8 10 13 14" components: "what a component stands on is stable (rooms, chapters, plates)" creatures: "where each creature lives (.at, first chapter)" ecology: "the field, the lanes, the gate: places before plots" interaction: "a link to a place lands in the right room" state: "seed" }
  config: { sigil: "=" rooms: 10 chapters: "1 5 7 8 9 11 14 15" components: "every tuning shows its range and its default (the desk)" creatures: "how a creature can be retuned for a visit" ecology: "the lean among fairy tale, absurd reality and low magic" interaction: "a reader setting is kept; a visit setting is said to be for the visit" state: "seed" }
  measure: { sigil: "%" rooms: 4 chapters: "2 3 5 8" components: "what is counted is shown as counted, never as a score to chase" creatures: "what each knock and gift costs, in the game own numbers" ecology: "how much of each material a chapter holds" interaction: "measures are recorded, never set by a link" state: "seed" }
  substrate: { sigil: "$" rooms: 4 chapters: "2 5 6 11" components: "what a component is made of shows in its tokens (materials)" creatures: "which material each creature belongs to" ecology: "glass, flour, berry, frost, ink, brass, steam, oak" interaction: "a material sounds and looks like itself (spell textures)" state: "seed" }
}

~notice{
  sparse_sigils: "none: every sigil moves at least three rooms"
  densest_chapter: "The Thursday Nobody Kept"
}
