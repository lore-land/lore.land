# Lore.Land Spw Canon Mount
#>lore_land_spw_index
#:canon #!mount

^workspace{
  root: ".spw/"
  purpose: "Long-form Spw references for chapter extension, storytelling semantics, and platform ship direction."
  ethos_bridge: "book/scripts/modules/spw-ethos.mjs"
  prose_sot: "book/content/chapters/*.json"
  audit_active: "@spw/audits/alignment-probes-2026-11-07.spw"
}

&surfaces{
  chapters: "@spw/chapters/index.spw"
  apocrypha: "@spw/chapters/apocrypha.spw"
  claims: "@spw/claims/chapter-claims.spw"
  process: "@spw/workspace.spw"
  surfaces: "@spw/surfaces/index.spw"
  publish: "@spw/surfaces/publish.spw"
  editorial: "@spw/surfaces/editorial.spw"
  platform: "@spw/surfaces/platform.spw"
  atelier: "@spw/surfaces/atelier.spw"
  runtime: "@spw/runtime/precipitates.spw"
  observable: "@spw/state/observable.spw"
  alignment_ledger: "@spw/state/alignment-ledger.spw"
  story_boonhonk: "@spw/story-boonhonk.spw"
  book_two: "@spw/surfaces/wonder-about-pie.spw"
  tropes: "@spw/surfaces/tropes.spw"
  ecology: "@spw/surfaces/ecology.spw"
  texture_website: "@spw/surfaces/texture-website.spw"
  spw_proposals: "@spw/surfaces/spw-proposals.spw"
  almanac: "@spw/surfaces/almanac.spw"
  fold_and_materials: "@spw/surfaces/fold-and-materials.spw"
  projection: "@spw/surfaces/projection.spw"
  collecting: "@spw/surfaces/collecting.spw"
  rooms: "@spw/surfaces/rooms.spw"
  spw_stress: "@spw/surfaces/spw-stress.spw"
  stories: "@spw/surfaces/stories.spw"
  characters: "@spw/surfaces/characters.spw"
  spw_play: "@spw/surfaces/spw-play.spw"
  sigil_audit: "@spw/audits/sigil-chapter-audit.spw"
  progression: "@spw/audits/progression.spw"
  pie_rules: "@spw/runtime/pie-rules.spw"
  layers: "@spw/surfaces/layers.spw"
  bias: "@spw/runtime/bias.spw"
  likeness: "@spw/surfaces/likeness.spw"
  spw_architecture: "@spw/surfaces/spw-architecture.spw"
  chapter_spell: "@spw/chapters/NN.spw $[chapter/NN/made_of] — what each chapter is made of, one spell per chapter; generated by book/scripts/modules/chapter-spell.mjs (chapters:build prerenders it at the chapter end, chapter-inventory.mjs lights the inventory)"
  berries: "@spw/surfaces/berries.spw"
  knobs: "@spw/surfaces/knobs.spw"
  tellings_and_bindings: "@spw/surfaces/tellings-and-bindings.spw"
  audit_platform: "@spw/audits/platform-ship-audit-2026-07-16.spw"
  dregg_release_cache: "@spw/audits/dregg-release-cache-2026-09-26.spw"
}

&plans{
  .note: "Root PLAN.*.spw files are the long-arc specs; surfaces carry ship-facing phases."
  structure: "PLAN.A.spw"
  ethos: "PLAN.B.spw"
  shadow_chrome: "PLAN.C.spw"
  houdini_firefox: "PLAN.D.spw"
  living_book: "PLAN.E.spw (direction + curriculum L01–L28)"
  sustainable_serial: "PLAN.F.spw (dimensions of narrative semantic evolution; publishing ecosystem; increments f1–f8)"
  platform_ship: "@spw/surfaces/platform.spw"
  editorial_desk: "@spw/surfaces/editorial.spw"
  atelier_production: "@spw/surfaces/atelier.spw"
}

~navigation{
  chapter_chain: "^[chapter/*]{open}"
  section_chain: "^[chapter/*/s*]{open}"
  probe_chain: "^[claim-chain]{claim -> spec -> impl -> probe}"
  platform_chain: "^[platform/*]{sw | social | vite | canon-sync}"
  atelier_chain: "^[atelier/*]{wonder | ledger | ladder | passes}"
}

~direction{
  from_audit: "2026-08-26 alignment probes (supersedes 2026-07-22 — plates public, theme_parity closed)"
  order: [
    "PLAN.E is the season's direction: a living book that models future books, taught as a curriculum of lessons (L01–L08 read back from what exists; L09–L18 next, one lesson per increment)",
    "Book Two (Wonder About Pi(e)) is under way: ch14 The Thursday Nobody Kept, ch15 Pupil, Parcel, or Door (set 2026-11-05). Next stone ch16 on 2026-11-13 — the second place at BoonWAP's table; see wonder-about-pie.spw#book_two chambers.c16",
    "on every stone: update book/content/serial.json `next`, add the chapter to index.html Contents + #latest, run assets:brand --og --chapters=NN, chapters:build, spw:export",
    "plates 14 and 15 are drawn studies over seed paintings — graduate to painted plates when grounded (plates-manifest !state study)",
    "View Transitions chamber crossing (atelier signature phase 05) now that plates are public"
  ]
  keep: [
    "progressive enhancement",
    "modern CSS behind reduced-motion and @supports",
    "dual-register reading (adventure surface · workshop veil)"
  ]
}

~production{
  from: "@spw/surfaces/atelier.spw"
  audience: "seen-the-web — wants wonder, audits seams, complains about unaccounted misalignment"
  double_account: "every signature moment is paired with alignment accounting (.spw/state/alignment-ledger.spw)"
  arcs: [
    "plates for chambers + doors (graduates studies {name}-v{N} → OG art)",
    "alignment ledger live with complaint → refutation route (lore-c008)",
    "literacy ladder on-ramps: read → notice → explore → operate → inspect → author",
    "refinement passes p1-p5 named, probed, and rerunnable"
  ]
}
