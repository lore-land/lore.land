# Lore.Land Spw Canon Mount
#>lore_land_spw_index
#:canon #!mount

^workspace{
  root: ~"."
  purpose: "Long-form Spw references for chapter extension, storytelling semantics, and platform ship direction."
  ethos_bridge: ~"../book/scripts/modules/spw-ethos.mjs"
  ast_bridge: ~"../book/scripts/modules/spw-ast.mjs"
  prose_sot: ~"../book/content/chapters"
  audit_active: ~"./audits/alignment-probes-2026-11-09.spw"
}

&surfaces{
  chapters: ~"./chapters/index.spw"
  apocrypha: ~"./chapters/apocrypha.spw"
  claims: ~"./claims/chapter-claims.spw"
  process: ~"./workspace.spw"
  surfaces: ~"./surfaces/index.spw"
  publish: ~"./surfaces/publish.spw"
  editorial: ~"./surfaces/editorial.spw"
  platform: ~"./surfaces/platform.spw"
  domains: ~"./surfaces/domains.spw"
  plugin_protocol: ~"./surfaces/plugin-protocol.spw"
  atelier: ~"./surfaces/atelier.spw"
  plates: ~"./surfaces/plates.spw"
  runtime: ~"./runtime/precipitates.spw"
  observable: ~"./state/observable.spw"
  alignment_ledger: ~"./state/alignment-ledger.spw"
  plates_manifest: ~"./state/plates-manifest.spw"
  story_boonhonk: ~"./story-boonhonk.spw"
  book_two: ~"./surfaces/wonder-about-pie.spw"
  book_three: ~"./surfaces/book-three.spw"
  chapter_ecologies: ~"./ecologies/index.spw"
  dragon_egg: ~"./surfaces/dragon-egg.spw"
  cullet_deck: ~"./surfaces/cullet-deck.spw"
  tropes: ~"./surfaces/tropes.spw"
  ecology: ~"./surfaces/ecology.spw"
  texture_website: ~"./surfaces/texture-website.spw"
  autonomous_feedback: ~"./surfaces/autonomous-feedback.spw"
  affordances: ~"./surfaces/affordances.spw"
  sound_and_voice: ~"./surfaces/sound-and-voice.spw"
  spw_proposals: ~"./surfaces/spw-proposals.spw"
  almanac: ~"./surfaces/almanac.spw"
  fold_and_materials: ~"./surfaces/fold-and-materials.spw"
  projection: ~"./surfaces/projection.spw"
  collecting: ~"./surfaces/collecting.spw"
  rooms: ~"./surfaces/rooms.spw"
  spw_stress: ~"./surfaces/spw-stress.spw"
  stories: ~"./surfaces/stories.spw"
  characters: ~"./surfaces/characters.spw"
  genie_practice: ~"./surfaces/genie-practice.spw"
  texture_finds: ~"./surfaces/texture-finds.spw"
  formulas: ~"./surfaces/formulas.spw"
  cadence: ~"./surfaces/cadence.spw"
  competency: ~"./surfaces/competency.spw"
  inventions: ~"./surfaces/inventions.spw"
  liminal_physics: ~"./surfaces/liminal-physics.spw"
  prompts: ~"./surfaces/prompts.spw"
  ast_play: ~"./surfaces/ast-play.spw"
  gradients: ~"./surfaces/gradients.spw"
  three_lands: ~"./surfaces/three-lands.spw"
  realm_powers: ~"./surfaces/realm-powers.spw"
  shelves: ~"./surfaces/shelves.spw"
  cadences: ~"./surfaces/cadences.spw"
  gossip_and_kitchens: ~"./surfaces/gossip-and-kitchens.spw"
  seasons: ~"./surfaces/seasons.spw"
  finds: ~"./surfaces/finds.spw"
  jokes: ~"./surfaces/jokes.spw"
  classes: ~"./surfaces/classes.spw"
  reactions_in_the_lanes: ~"./surfaces/reactions-in-the-lanes.spw"
  places_in_the_lanes: ~"./surfaces/places-in-the-lanes.spw"
  elaboration: ~"./surfaces/elaboration.spw"
  scored: ~"./surfaces/scored.spw"
  grants: ~"./state/grants.spw"
  panel_art: ~"./surfaces/panel-art.spw"
  reasons: ~"./surfaces/reasons.spw"
  spw_play: ~"./surfaces/spw-play.spw"
  sigil_audit: ~"./audits/sigil-chapter-audit.spw"
  progression: ~"./audits/progression.spw"
  pie_rules: ~"./runtime/pie-rules.spw"
  layers: ~"./surfaces/layers.spw"
  bias: ~"./runtime/bias.spw"
  pie_levels: ~"./runtime/pie-levels.spw"
  mechanics: ~"./runtime/mechanics.spw"
  audio_tropes: ~"./runtime/audio-tropes.spw"
  enchantment: ~"./surfaces/enchantment.spw"
  folios: ~"./surfaces/folios.spw"
  inoculant: ~"./surfaces/inoculant.spw"
  resonance: ~"./surfaces/resonance.spw"
  sounds: ~"../book/audio/index.spw"
  share_cards: ~"../book/images/og/index.spw"
  app_icons: ~"../book/pwa/icons/index.spw"
  likeness: ~"./surfaces/likeness.spw"
  spw_architecture: ~"./surfaces/spw-architecture.spw"
  chapter_spell: ~"./chapters"
  .chapter_spell_note: "@spw/chapters/NN.spw $[chapter/NN/made_of] — what each chapter is made of, one spell per chapter; computed by book/scripts/modules/chapter-spell.mjs and written by spw:export"
  site_clusters: ~"./surfaces/site-clusters.spw"
  berries: ~"./surfaces/berries.spw"
  knobs: ~"./surfaces/knobs.spw"
  tellings_and_bindings: ~"./surfaces/tellings-and-bindings.spw"
  audit_platform: ~"./audits/platform-ship-audit-2026-07-16.spw"
  session_residue: ~"./audits/session-opus-fable-2026-11-10.spw"
  tooling_audit: ~"./audits/tooling-2026-11-10.spw"
  dregg_release_cache: ~"./audits/dregg-release-cache-2026-09-26.spw"
  caches: ~"./caches/index.spw"
  workbench_direction: ~"./caches/workbench-direction.spw"
  mount: ~"./mount.spw"
}

&plans{
  .note: "Root PLAN.*.spw files are the long-arc specs; surfaces carry ship-facing phases. PLAN.E and PLAN.F are live and held by npm run spw:plans. PLAN.A to PLAN.D do not parse and are read as reference, never as a source of slices."
  structure: ~"../PLAN.A.spw"
  ethos: ~"../PLAN.B.spw"
  shadow_chrome: ~"../PLAN.C.spw"
  houdini_firefox: ~"../PLAN.D.spw"
  living_book: ~"../PLAN.E.spw"
  sustainable_serial: ~"../PLAN.F.spw"
  platform_ship: ~"./surfaces/platform.spw"
  editorial_desk: ~"./surfaces/editorial.spw"
  atelier_production: ~"./surfaces/atelier.spw"
}

~navigation{
  chapter_chain: "^[chapter/*]{open}"
  section_chain: "^[chapter/*/s*]{open}"
  probe_chain: "^[claim-chain]{claim -> spec -> impl -> probe}"
  platform_chain: "^[platform/*]{sw | social | vite | canon-sync}"
  atelier_chain: "^[atelier/*]{wonder | ledger | ladder | passes}"
}

~direction{
  from_audit: "2026-11-09 alignment probes; older runs are in git history"
  tooling: "2026-11-10: npm run check is the door; npm run spw is the workbench CLI, to be used read-only"
  order: [
    "npm run spw:plans checks open slices, grants, open questions, and (only when serial.next is set) any scheduled release",
    "PLAN.E is the season's direction and PLAN.F its publishing dimensions. Open work is cut into one-session slices there, each naming its files, who decides, and the command that checks it. Pick one slice; do not survey",
    "Book Two (Wonder About Pi(e)) is under way: ch14 The Thursday Nobody Kept, ch15 Pupil, Parcel, or Door. serial.next stays null while unscheduled; see wonder-about-pie.spw#book_two for chamber notes",
    "books are rings of thirteen: Book One 1 to 13, Book Two 14 to 26, and a third would be 27 to 39; a chapter's place in its book is its number mod 13 (13 for a multiple), and book:check warns when a book is not thirteen",
    "when adding or revising a chapter: update index.html Contents + #latest if needed, run assets:brand --og --chapters=NN, chapters:build, spw:export",
    "plates 14 and 15 are drawn studies over seed paintings — graduate to painted plates when grounded (plates-manifest !state study)",
    "View Transitions chamber crossing (atelier signature phase 05) now that plates are public"
  ]
  keep: [
    "progressive enhancement",
    "modern CSS behind reduced-motion and @supports",
    "dual-register reading (adventure surface · workshop veil)"
  ]
}

~production{
  from: ~"./surfaces/atelier.spw"
  audience: "seen-the-web — wants wonder, audits seams, complains about unaccounted misalignment"
  double_account: "every signature moment is paired with alignment accounting (.spw/state/alignment-ledger.spw)"
  arcs: [
    "plates for chambers + doors (graduates studies {name}-v{N} → OG art)",
    "alignment ledger live with complaint → refutation route (lore-c008)",
    "literacy ladder on-ramps: read → notice → explore → operate → inspect → author",
    "refinement passes p1-p5 named, probed, and rerunnable"
  ]
}
