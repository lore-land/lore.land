# Lore.Land Spw architecture
# What makes a Spw script file in this canon recognizable at a glance; the three layers a file,
# or any thing in the book, can be read in (syntax, semantics, pragmatics) and how a file enhances
# along them; why a projection of linked Spw is naturally hyperbolic; and the arcs and loops the
# canon already has, counted from the files and the book's data on 2026-11-08.
# The projection that walks them: book/scripts/modules/spw-projection-disk.mjs (/scriptorium/#projection).
#>lore_land_surfaces_spw_architecture
#:surface #!architecture
#:layer #!semantics
#:status #!seeded

~<rationale>{
  A Spw file in this canon can be recognized before a word of it is read. It opens with a title in plain comment, an anchor that names it, and a few lines of metadata that say what kind of file it is and which layer it serves. Its first block, when it has one, is a rationale: a capsule of prose that says why the file exists. After that come blocks named by the role of their sigil, registries that bind upward, probes that ask, gates that fire, tunings, measures and confluences, and references that walk into a named node of another file. Read as a web, the canon branches the way the hyperbolic plane grows, so it fits a disk that keeps the near thing large and the far field crowded but present. And it should loop, because a reader who comes back to where they began comes back knowing more than when they left.
}

^meta{
  source: "spw-architecture.spw (written 2026-11-08)"
  counted: "a measuring pass over the 72 files spw:lint reads (.spw/ less the workbench) and over the graph spw-projection-disk.mjs buildGraph draws from the book's data; the numbers below are as of that day"
  &projection: ~"book/scripts/modules/spw-projection-disk.mjs"
  &styles: ~"book/styles/components/spw-disk.css"
  &likeness: ~".spw/surfaces/likeness.spw#lore_land_surfaces_likeness"
  &rooms: ~".spw/surfaces/rooms.spw#lore_land_surfaces_rooms"
  &stress: ~".spw/surfaces/spw-stress.spw#lore_land_surfaces_spw_stress"
}

^features{
  .note: "what marks a lore.land Spw file, each with how many of the 72 have it"
  title: { seen: "line one is a # comment that names the file in words; a few more # lines say what it holds and what reads it" %files: 72 }
  anchor: { seen: "#>name, one to a file: the name a ~path#fragment reference resolves to" %files: 72 }
  metadata: { seen: "#:kind #!value lines under the anchor: the first says what kind of file it is (#:surface 26, #:chapter-canon 17, #:audit 13), #:layer which layer it serves (#!pragmatics 41, #!semantics 3), #:status how far along it is" %lines: 141 }
  rationale_first: { seen: "~<rationale>{ … }: plain prose saying why the file exists, a capsule because it is a passage, read through and never stood in; in every file that has one it is the first block; prose inside it cannot hold an apostrophe, which the lexer reads as an open string" %files: 26 %first: 26 }
  blocks_by_role: { seen: "top-level blocks are named by the role of their sigil: ^ registries and records that bind upward, ~ rationales and potentials, & confluences that cite and merge, ? probes and open questions, % measures, $ substrates, # annotations, ! gates and actions, * values, = tunings and leans, @ perspectives" }
  %blocks{ integration: 307 potential: 72 confluence: 55 probe: 32 measure: 20 substrate: 17 annotation: 17 action: 14 value: 5 config: 3 perspective: 2 }
  containers: { seen: "a block opens { } when it is a registry looked up by name and [ ] when order matters or every record has one shape; < > is kept for a directed coupling, the rationale above all" %body: 468 %frame: 76 }
  names: { seen: "a block name is bare (^features), quoted (^\"stages\") or a frame ([chapter/04/spine]); a ? or # block is always bare, since a quoted one spanning lines turns the whole file to prose" %bare: 151 %quoted: 212 %framed: 181 }
  sigil_fields: { seen: "short, reference-shaped fields carry their role on the key (. ground, & confluence, # annotation, % measure, ! action); prose fields never do" %ground: 240 %confluence: 178 %annotation: 119 %measure: 72 %action: 31 }
  references: { seen: "a tilde and a quoted path walk to another file, and a #fragment walks into the named node inside it; the registries mount whole files as @spw/ paths" %paths: 231 %with_fragment: 156 %mounts: 87 }
  bias_edges: { seen: "={ ~path } leans a node toward where its own canon lives, the reflexive bias edge" %edges: 5 }
  made_of: { seen: "$[chapter/NN/made_of] in each chapter mirror: what the chapter is made of, as one spell, written by chapter-spell.mjs" %mirrors: 15 }
  banners: { seen: "a generated file says so in its header (Generated by, Generated from) and is never edited by hand: the chapter mirrors and every probe run" %files: 27 }
  notes: { seen: ".note: a ground field that says how to read the block it opens" %notes: 99 }
  strings: { seen: "every string on one physical line, however long; a raw newline inside a string is a parse error, not a style" }
  refusals: { seen: "!never[ … ]: a gate of things the file promises not to do, kept beside what it does" }
}

^layers[
  syntax: { reads: "what can be seen: sigils, containers, labels, strings, paths; spw-spell.mjs draws it and is never wrong about a spell it cannot parse, because what it does not know stays plain" in_a_file: "the title, the anchor, the metadata and the shapes of the blocks: a file is legible as a shape before it is read" on_the_disk: "every thing shows its Spw first: a room its signature, a wonder its spell, someone their identity spell, a chapter its rooms; a thing not yet found shows a veil, a probe that says where to look" }
  semantics: { reads: "what it means: what each sigil does by its role, what a room is by its container and its motion (room-signature.mjs roomSentence), what a wonder is by its note" in_a_file: "the rationale and the .note fields, read once the shape is known; a sigil on a field says its role before its value is read" on_the_disk: "once a thing has been stood on, its meaning shows in plain words; the Egg alone stays a probe and has no meaning line" }
  pragmatics: { reads: "what it is for: where to read it, what it does in the lanes, who says it, which page or tool reads the file" in_a_file: "the & references to what reads and renders it, the ! gates that fire, the ? probes that check it; #:layer #!pragmatics marks the files that are mostly for use" on_the_disk: "once a loop through a thing is walked, it says what it is for" }
]

^enhancement[
  "a file is whole at its first layer: the title and the anchor alone let it be found, mounted and linted"
  "a rationale and .note fields add its meaning without changing its shape; a reader who skips them loses nothing structural"
  "references, gates and probes add its use; each can be walked or fired, and each can be missing without breaking what the file says"
  "a thing in the book enhances the same way: its spell is always there, its meaning once it has been stood on, its use once a loop has been walked round it"
]

^geometry{
  .note: "why a projection of linked Spw is naturally hyperbolic"
  branching: "references branch: each thing points to several, and each of those to several more, so the things n steps away grow like b to the n"
  measured: "in the book's projection (261 things, 847 ties) the mean number of things exactly one, two, three and four steps away is 6.5, 38.5, 107.6 and 91.1: six times as many at the second step, nearly three at the third, until the book runs out; without the likeness ties, 3.7, 24.9, 66.7 and 96.8"
  flat_plane: "a flat circle grows with its radius, so a flat layout of an exponential web crowds by its second ring and has to shrink everything at once"
  hyperbolic_plane: "a hyperbolic circle of radius r has circumference 2π sinh r, about π e^r: with rings 1.2 apart, each ring has e^1.2, about 3.3 times, the room of the one inside it, close to how the book branches"
  poincare_disk: "the Poincaré disk draws the whole plane inside a circle: distance r from the centre is drawn at tanh(r/2), and a thing of fixed size at (1 − |z|²) of its size at the centre, so the focus is large and legible and the far field crowds toward a rim it never reaches; there is always more beyond"
  geodesics: "a tie is a geodesic, the arc of the circle through both ends that meets the rim at right angles (its centre c solves c·p = (|p|²+1)/2 and c·q = (|q|²+1)/2, its radius is √(|c|²−1)), or a diameter through the centre"
  moving: "re-centring is a Möbius map, T_a(z) = (z − a)/(1 − ā z), which carries a to the centre and keeps the disk; the walk follows the geodesic, a(t) = tanh(t·atanh|w|)·w/|w|, so the motion itself is an arc"
  moseying: "on the disk every walk is an arc, and the shortest way between two far things bends toward the centre, through what they share: the geometry itself asks a reader to mosey"
}

^loops{
  .note: "why references should form loops, and which loops the canon already has (counted 2026-11-08)"
  why: "a reference that only points outward is a door; a loop is a walk that brings a reader back to where they began, carrying what they met on the way, so the first thing reads differently the second time; a web of loops can be wandered without being lost in"
  ties: "contains 81 (a chapter to its rooms) · first met 82 · returns 96 · grounded 27 (a line the pies let slip, to the room it is about) · said 38 · kept 52 (a room to its keeper) · palette 15 · planted 27 (an atlas study to its chapter) · the Egg 3 · the same sigil again 68 (each room to the next room with its motion) · like 358 (the three nearest likenesses)"
  %in_the_book{ things: 261 ties: 847 loops_of_3: 364 loops_of_4: 841 loops_of_5: 2723 loops_of_6: 11256 things_with_a_loop: 250 }
  %without_likeness{ loops_of_3: 24 loops_of_4: 126 loops_of_5: 227 loops_of_6: 644 }
  counted_how: "simple cycles through distinct things, each counted once whichever way round, with at most one crowd on a loop (Boof, Mr. BaneWAP, Mr. BoonWAP and the few rooms with more than fourteen ties), since a loop through two crowds joins any two things at all; without that rule there are 375, 927 and 3288 loops of three, four and five"
  offered: "the disk offers up to four loops from each thing, unlike each other, scored step for step by how many kinds of thing, kinds of tie and chapters they cross, less for likeness alone; 985 offered across the book, most of four or five steps (306 and 499)"
  typical: "a room, the wonder first met there, another chapter room it returns to, the line the pies let slip about that room, and back; for instance No Key Covers the Egg, Crosswind Council, Mr. BaneWAP, his line on the theft, the Egg, and back; or a line of Mr. BoonWAP on the pie at the table, The Pie at the Table, the lanterns of Bonk City, Mr. BoonWAP, and back"
  %in_the_files{ files: 72 references_between_files: 177 files_pointing_to_another: 39 files_pointed_to: 60 two_way_pairs: 19 cycles_of_2: 19 cycles_of_3: 4 cycles_of_4: 3 cycles_of_5: 10 cycles_of_6: 17 }
  spine: "the fifteen chapter mirrors are one strongly connected run: each leans =prev and =next, so the spine reads both ways (14 of the 19 two-way pairs)"
  workshop_knot: "ten files make the other strong knot and cite each other round: story-boonhonk, plates, atelier, platform, publish, editorial, enchantment, resonance, inoculant and the workspace (story-boonhonk to plates to platform to the workspace to resonance, and back)"
  egg_pair: "the Egg surface and the dregg release audit point at each other"
  index_star: "index.spw points to nearly everything and nothing points back to it by path: a star, not a loop; a registry is the one place a loop is not wanted"
  leaves: "the surfaces written since November (rooms, likeness, layers, stories, spw-play, characters, berries, tellings and bindings, projection) point outward to code and plans and are pointed to by the index alone, so they hang as leaves until something cites them back"
}

?open[
  "eleven lines the pies let slip are grounded nowhere and tied only to who says them, so no loop can pass through them: should each be grounded in a chapter"
  "should a surface written today cite back the surface that moved it to be written, so the newer files close loops instead of hanging as leaves"
  "a loop walked on the disk could be one more reason the pies let a line slip; the lanes and the disk do not yet speak to each other"
]

^projection{
  .note: "the disk that walks these loops"
  &module: ~"book/scripts/modules/spw-projection-disk.mjs"
  &styles: ~"book/styles/components/spw-disk.css"
  where: "/scriptorium/#projection, and from the end of every chapter inventory as ◎ Walk the projection from here (?focus=chapter:NN)"
  graph: "from the canon only: likeness.json (items and near), the chapter JSONs (rooms, and a room air once it is stood on), semantic.json (where each wonder is marked), the almanac, pie-lore.json, the catalog and the palettes"
  look: "each thing wears its likeness seal; the rim is the twelve sigils in their role hues, each at its hour; behind the disk the four containers nest, { [ ( < > ) ] }"
  marks: "lore.disk.loops.v1 keeps what was stood on, what was walked and which loops were closed, in this browser only; a walked loop leaves a gold ring on everything on it; a loop closed by hand counts the same"
  limits: "about sixty things at once, the deepest rings pruned first; drawn only while moving; at once under reduced motion; a parallel list of buttons for the keyboard and for screen readers (arrows cycle the first ring, Enter walks there, L lists the loops)"
}

!never[
  "a child as a thing on the disk"
  "the figure in plain lines named, in a title, a label or a loop"
  "the Egg given a meaning line: it stands, and it asks"
  "cardinal directions: dawnward and hearthward"
  "anything read from other readers, or sent anywhere"
]
