# Lore.Land Domain Architecture
#>lore_land_domain_architecture
#:registry #!domains
#:layer #!pragmatics

^"producer_position"{
  producer: "Spwashi"
  medium: "worldbuilding monument — seeded serial, inspectable craft"
  thesis: "Demonstrate the capability of developing and seeding a durable world."
  focus: {
    world: "districts, ledgers, objects, weather -> sedimented canon"
    craft: "readable systems, Spw operators, inspectable chapter machinery"
    signal: "thresholds, public rhythm, release cadence on the 13th and 26th"
    intrigue: "who keeps the record, who rewrites it, what remains unfiled"
  }
  posture: "show the monument; avoid product-category labeling at the entrance"
  dual_register: {
    surface: "classic fantasy RPG serial — adventure first"
    civic: "offices encode functional company dynamics with magic as obfuscation"
    craft_recognition: "optional second reading for values, process, brand storytelling"
    patronage: "patron seals = marked sponsorship / paid links; editorial stays with scriptorium"
    commission: "scriptorium atelier door — hire imagination without B2B homepage"
  }
  deferred: {
    interactive_fiction: "dregg.net — later implementation detail, not this surface"
  }
}

^"capacity"{
  total_slots: 40
  policy: "Use structural slots first. Map literal identities by context."
}

^"literal_valence_realms"{
  boon: "boon.land"
  bane: "bane.land"
  bone: "bone.land"
  bonk: "bonk.land"
  honk: "honk.land"
}

^"clusters"{
  valence_realms: { capacity: 8, role: "world-state semantics; each land its own weather" }
  spw_core_network: { capacity: 12, role: "kernel, parser, routing, runtime; one address law" }
  mindful_social_play: { capacity: 8, role: "local profile, cadence, word of mouth; no feed" }
  absurd_earnest_labs: { capacity: 6, role: "motion and one-gesture doors; factshift.center carries the line" }
  trope_knowledge_commons: { capacity: 6, role: "addresses, palettes, describable captures" }
}

^"routing"{
  lore_land: { pipeline: "default", selector: "$^[\"_\"]@spw/chapters" }
  boon_land: { pipeline: "default", selector: "$^[\"valence\"]@spw/surfaces" }
  bane_land: { pipeline: "default", selector: "$^[\"valence\"]@spw/surfaces" }
  bone_land: { pipeline: "default", selector: "$^[\"valence\"]@spw/surfaces" }
  bonk_land: { pipeline: "default", selector: "$^[\"valence\"]@spw/surfaces" }
  honk_land: { pipeline: "default", selector: "$^[\"valence\"]@spw/surfaces" }
  texture_website: { pipeline: "probe", selector: "lore.land/?/texture.website/…", canon: ~".spw/surfaces/texture-website.spw" }
  autonomous_feedback: { pipeline: "probe", selector: "lore.land/?/autonomous.feedback/@lore.land/*subject", canon: ~".spw/surfaces/autonomous-feedback.spw" }
}

^"neighbours"{
  .note: "Surfaces near lore.land, reached through it before (or besides) a host of their own: lore.land/?/<surface>/… reads the address part by part (texture-routes.mjs) and a pack answers it."
  texture_website: "grain: material, texture, the tactile side of making and publishing; a lab for routes and URL structure, played through lore.land (trope_knowledge_commons)"
  trope_wiki: "tropes as a commons: tropes.json is portable for it (trope_knowledge_commons); no route yet"
  spw_quest: "the reader that keeps state in the address; as middleware, the ? passes in a route (quest-middleware.mjs: edit, enhance, clarify, align, mutate, ground, resonate), each with a receipt"
  autonomous_feedback: "the post the Scriptorium reads: a reader writes a card and keeps a copy; lore.land is a client (/.well-known/autonomous-feedback.json, held to what the post keeps by book:check), the home of charms (/charm/), and played through the route lab with a door in every subject"
  factshift_center: "the design and interaction hub: a canvas that turns a line toward motion and lends that momentum back as a receipt; texture.website's materials ground in its own address (alpha … linkStrength, ?spw=) through &factshift.center/?ground. It does not host the story, the folio, or the curriculum (site-clusters.spw)"
  spwashi_click: "the one-gesture door (portal cluster): a first impression that should resolve to another site's first live address, not a copy of its page"
  spwashi_work: "the folio beside the portal: selected works, quiet; a candidate shelf for capture cards the maker chooses to publish"
  spwashi_college: "the academy shelf, still a stub; until it has pages it should point at lore.land's night school rather than pretend to teach"
  site_clusters: "the design theory for the doors above: say-line, look, overlays, local profile, mouth card, captures (site-clusters.spw)"
}
