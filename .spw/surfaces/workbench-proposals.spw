# Workbench Proposals, Factshift Semantics & Symbolic Manipulation
# Cross-repository synthesis of spw-workbench, spwashi.com, factshift.center, spw.quest, and lore.land.
#>lore_land_surfaces_workbench_proposals
#:surface #!workbench
#:layer #!pragmatics

^"meta"{
  .updated: "2026-11-17"
  .role: "Cross-host architectural proposals for spw-workbench, factshift.center interaction semantics, and CS foundations of guided Spw manipulation"
  .rationale: "spw-workbench now serves four live host surfaces: spw.quest (Cloudflare Worker guide and interactive pivot/entry puzzles), factshift.center (force-directed spatial canvas, edge-rail scrubbing, body-pinch folding, and joint/seam rewriting), spwashi.com (personal hub, 1,322-surface corpus, upstream-workbench-recommendations, and algorithmic/linguistic affordance caches), and lore.land (illustrated serial, musical AST sonification, and lane play). Reviewing their histories, telemetry, and stress audits together exposes where parser mechanics, spatial gestures, Computer Science abstractions, and guided symbolic manipulation converge into one shared substrate."
  .hosts_reviewed: [
    "spw-workbench (cf41ca22 .. bcf0da18b840)",
    "spwashi.com (248c2379 .. upstream-workbench-recommendations 2026-11-17)",
    "factshift.center (d4e3979 .. c4b0ca1)",
    "spw.quest (248c2379 .. cf23af1c)",
    "lore.land (cebb1de .. ffaa254)"
  ]
}

&refs{
  index: ~"../index.spw#lore_land_spw_index"
  surfaces: ~"./index.spw#lore_land_surfaces_index"
  plugin_protocol: ~"./plugin-protocol.spw#lore_land_surfaces_plugin_protocol"
  spw_proposals: ~"./spw-proposals.spw#spw_proposals"
  workbench_direction: ~"../caches/workbench-direction.spw#lore_land_workbench_direction"
  factshift_quest_navigation: ~"../caches/factshift-quest-navigation.spw#lore_land_factshift_quest_navigation"
  sound_and_voice: ~"./sound-and-voice.spw#lore_land_surfaces_sound_and_voice"
  poetics: ~"./poetics.spw#lore_land_surfaces_poetics"
}

^"commit_history_synthesis"{
  spw_quest_and_site: {
    commits: ["248c2379", "de8f9490", "e7038495", "bbbf9e97", "7fe2032d"]
    findings: [
      "Cloudflare Worker error 1102 (CPU limit exceeded) and error 1027 (request quota exhausted) forced spw.quest to memoize parsed guide shelves per isolate (e7038495) and pre-render / into static assets/index.html (248c2379).",
      "Profiling in motion-and-marks-2026-11.spw (bbbf9e97) proved that parseStream(input, { collect: false }) still allocates enter/exit trace events with performance.now() on every grammar rule (281ms) and re-yields them through every lazy rule generator (135ms), while pathological rule backtracking makes the 242-char revision specimen take 41ms vs 2ms for the 460-char notebook specimen.",
      "spw.quest's front-page pivot toy (pivot.js, forms.js) duplicates mark-stripping and brace-swapping logic that spw-workbench later formalized in spw.pivots/1 (f0bba2d3)."
    ]
  }
  factshift_center: {
    commits: ["d4e3979", "423f520", "1a4157a", "3d71517", "eb31c06", "bd2e7ad", "c4b0ca1", "517c036"]
    findings: [
      "Pinned at spw-workbench 2026.11.07-pre.1 (3f53adf2), before spw-seed/line and spw.pivots/1 existed.",
      "Built rich tactile grammar manipulation locally: edge-scrub.ts (left rail = where, right rail = how, 1 kind per rail), pinch.ts (3-tier target resolution + 0.65/1.35 frame enter/up thresholds), body-gestures.ts (slow drag/pinch = metric resize; quick flick/pinch = structural fold/unfold/stratum step/sibling frame), line-edit.ts (outward/inward AST selection, part swap, owed-closer completion), and line-joints.ts (withFrontMark, withRoom, turned, withSeam, withBetween).",
      "Because it predates spw-seed/line and pivots.ts, factshift.center maintains its own bespoke parser in line-anatomy.ts / line-slots.ts and emits unparseable UI breadcrumbs (@node › #select[2/6]) rather than valid Spw lines."
    ]
  }
  spw_workbench: {
    commits: ["cf41ca22", "f0bba2d3", "339728cf", "84cf313e", "1f87112f", "6716d590", "8daec374", "42204b66"]
    findings: [
      "Delivered spw.pivots/1 (pivotsOf, readFragments, splitMarks, pivotReadCounts) with 7 conservative pivot kinds (side, mark, walls, bond, spacing, exchange, attach), 3-way read-back checks (line, parser, spoken), and strict name-set conservation.",
      "Established act-chain theory (docs/theory/spw/act-chains.spw): two adjacent marks are never a compound operator; prefix marks act before operand evaluation (arms / intent) and postfix marks act after operand evaluation (discharges / consequence).",
      "Delivered spw.quantity-sheet/1 (exact rational exponents over 7 SI base dimensions, Buckingham Pi null-space basis, natural-unit projection, forward-derivative uncertainty propagation)."
    ]
  }
  spwashi_com_recommendations: {
    sources: [
      "spwashi.com/.spw/reviews/upstream-workbench-recommendations.spw (+ 14 theme asks, 2026-11-17)",
      "spwashi.com/.spw/workbench-report.spw#corpus_audit_2026_11_17 (pin bcf0da18b840)",
      "spwashi.com/.spw/caches/workbench-algorithmic-practicality-2026-11.spw",
      "spwashi.com/.spw/caches/linguistic-affordances-2026-11.spw"
    ]
    findings: [
      "Corpus census across 1,322 tracked .spw files (8.41 MB): 1,311 clean, 3 hard errors, 9 prose-degradation surfaces, and 1,018 distinct HTML expressions with 0 errors/warnings.",
      "Benchmark on a 153 KB surface (site-semantics.spw) confirms trace-skipping speedup: 715.6ms (default trace) -> 117.7ms (diagnostics) -> 105.8ms (none) (~6.8x faster).",
      "Greedy digraph priority (>>, ((, <=, >=) overrides paired bracket stacks in algorithmic/type notation such as list<Module<T>>, O((V + E) log V), and ?[latency <= 400], while )) already obeys the bracket stack.",
      "Six diverging tokenizers coexist (spw-seed lex, lite scan, spw-lsp regex semantic tokens, spw.tmLanguage.json, operator-detection.js, expression-query.js), and 3,977 alias declarations / 2,947 uses across 252 files lack a file-scoped binder.",
      "434-file affordance scan exposes non-recursive {([^}]*)} secondary extractors, 9/27 partial herbarium specimens (part: true), single-operator compound-join splitting, and demand for parameterized template expansion / anti-unification F(X), coproducts {a|b}, and ranges a..b."
    ]
  }
}

^"workbench_core_proposals"{
  p1_zero_trace_fast_path: {
    target: "packages/spw-seed/src/combinators.ts, packages/spw-seed/src/grammar/*"
    problem: "parseStream allocates trace objects and calls performance.now() on every rule enter/exit even when collect: false, costing ~416ms across the 26 guide files and triggering Worker 1102 CPU timeouts."
    solution: [
      "Compile a synchronous, non-generator fast path (or branch on options.collect === false before rule wrapping) that skips trace allocation, performance.now(), and yield* trace propagation.",
      "Add a backtracking budget lint in spw:check that flags any corpus specimen whose rule-enter count per byte exceeds 25x (catching the 242-char revision specimen bottleneck)."
    ]
  }
  p2_unify_line_and_pivots_with_byte_spans: {
    target: "packages/spw-seed/src/line/index.ts, packages/spw-seed/src/experimental/pivots.ts"
    problem: "Four hosts maintain divergent line/slot/joint readers because Fragment and Bond in pivots.ts do not yet carry byte spans { start, end } or seam cycling (withSeam, withBetween) needed by factshift.center's inline editor."
    solution: [
      "Promote spw.pivots/1 into spw-seed/line and attach exact UTF-16/byte spans { start, end, markSpan, bodySpan } to every Fragment, Wall, and Bond.",
      "Add seam-cycling pivots (seam: . | , | ; | ~> and between: ~ | ^ | & | @) to pivotsOf so factshift.center's line-joints.ts and spw.quest's pivot.js both consume one canonical engine.",
      "Advance factshift.center's workbench pin from 3f53adf2 to current HEAD and delete bespoke line-anatomy.ts / line-slots.ts duplication."
    ]
  }
  p3_four_register_operator_table: {
    target: "packages/spw-seed/src/canon/operators.ts"
    problem: "Hosts drift between spirit-sequence mnemonics (~ potential, # vibration, . ground, ? wonder, ! action, * value, & something, @ someone, ^ integration), parser canon names (reference, perspective, subject), literary roles, and physics force laws (LAW_SAYS)."
    solution: "Publish one versioned operator table carrying all four registers per sigil: { glyph, canon, mnemonic, arms_prefix, discharges_postfix, force_law, earcon_interval }."
  }
  p4_parseable_crumbs_and_stills: {
    target: "packages/spw-seed/src/line/contracts.ts"
    problem: "factshift.center edge rails emit @node › #select[2/6] (unparseable › separator), and screenshot tools split between still[pocket]{...}, spell[wander]{...}(pocket)<still>, and lore.land's capture card props (say, cue, address, palette, span, kind)."
    solution: [
      "Standardize spw.crumb/1 as a parseable Spw path chain: @node#select[2/6] or @node/select[2/6]!all[1/5] so every rail stop can be copied, parsed, and replayed as a command.",
      "Standardize spw.still/1 as still[device]{route.state}(reason)<slug> with lossless round-trip mapping to spell[mode]{...} and lore.land capture cards."
    ]
  }
  p5_bracket_stack_digraphs_and_capsule_symmetry: {
    target: "packages/spw-seed/src/lexer/*, packages/spw-seed/src/grammar/containers.ts, packages/spw-seed/src/grammar/expressions.ts"
    problem: "Greedy digraphs (>>, ((, <=, >=) break paired brackets (list<Module<T>>, O((V + E) log V)), comparisons (?keep{qty > 0}) collide with >, %errors[0.1%] lexes % as an operator, and capsule (<...>) uses dual-interior backtracking and different operator attachment than (), [], {} (causing .<boon> drops and capsule_attachment_varies)."
    solution: [
      "Make digraph resolution bracket-stack aware (matching how )) already closes nested parens cleanly) and allow unit/comparison tokens in measure/check frames.",
      "Unify capsule (<>) attachment with scope (), frame [], and body {} in expressions.ts so all four PAIRED_BOUNDARY_KINDS obey one attachment and postfix-@ seam law."
    ]
  }
  p6_block_recovery_and_scoped_dialects: {
    target: "packages/spw-seed/src/grammar/seed.ts, packages/spw-seed/src/grammar/prose.ts, packages/spw-seed/src/combinators/stream.ts"
    problem: "seedNode rewinds the whole TokenStream to offset 0 on any failure (discarding valid ASTs), combinators lack partial memoization, and backward token scans (startsItsLine, lastSignificantLine) + global dialect preprocessors block clean per-container dialect switching."
    solution: [
      "Recover at top-level statement/block boundaries instead of file-wide binary rewinds so healthy sibling blocks keep full ASTs for highlighting and refactoring.",
      "Emit line-start / indent flags once in the lexer and scope prose/query/strict contexts to containers (~<...>{...}, Spw.q, Spw.m) with lightweight block memoization."
    ]
  }
  p7_unified_particles_and_file_binder: {
    target: "packages/spw-seed/src/canonical/particles.ts, packages/spw-lsp/*"
    problem: "Deixis (#>), case (#:), and mood (#!) parse as ParticleNode while aspect (~#) remains on legacy AnnotationNode; 3,977 alias declarations and 2,947 uses lack file-scoped definition/reference resolution; and spw-lsp, TextMate, and site readers use 6 unaligned tokenizers."
    solution: [
      "Unify ~# aspect with #>, #:, and #! under ParticleNode so dialect signatures and ParticleMix never rescan raw source.",
      "Build a file-scoped alias binder over the AST and generate TextMate / semantic tokens from one operator table checked by compareLex against lex() and lite/scan()."
    ]
  }
  p8_anti_unification_and_scientific_affordances: {
    target: "packages/spw-seed/src/experimental/*, packages/spw-seed/src/grammar/expressions.ts"
    problem: "Site and science corpora reach beyond current support for parameterized template/element shapes F(X), multi-way compound joins (A ~ B ^ C), coproducts {a|b}, intervals a..b, and periodic/molecular stoichiometry equations."
    solution: [
      "Support n-ary associative joins in readLine/expression readers, coproduct/range primitives, and parameterized shape templates (connecting spw expand, anti-unification LGG, spw.quantity-sheet/1, and periodic element/valence schemas)."
    ]
  }
}

^"left_right_gradient_and_step_abstraction"{
  thesis: "Unify the four competing spatial readings across factshift.center and spw-workbench (Where vs How, Opening vs Closing Brace, Objective vs Subjective, and Prefix Arms vs Postfix Discharges) into a single Contravariant-to-Covariant Frame Gradient."
  unified_polarity: {
    left_rail: {
      pole: "Opening / Prefix / Contravariant / Where / Arms"
      syntax: "prefix marks ($ ~ ? @ # . ^) + opening walls ([ ( < {)"
      semantics: "Selects the domain, coordinate frame, address, and preconditions BEFORE evaluation. Moves from coarse context toward the focal site."
      factshift_examples: ["@modes", "places", "spwTreeItems", "bodyRegions", "selectedLabels", "concept-step"]
    }
    center_canvas: {
      pole: "Focal Nucleus / Site / Redex"
      syntax: "focus body + inner slots + active seam"
      semantics: "The live locus of evaluation where left-rail context (where/domain) meets right-rail action (how/codomain)."
    }
    right_rail: {
      pole: "Closing / Postfix / Covariant / How / Discharges"
      syntax: "closing walls (} > ) ]) + postfix marks (* % # ! $)"
      semantics: "Selects the verb, projection, commitment, swatch, or receipt AFTER evaluation. Moves from the focal site outward into consequence and synthesis."
      factshift_examples: ["hotkey-verb", "swatches", "press-control", "recentActivations", "pivotsOf(focus)"]
    }
  }
  gradient_vs_step: {
    continuous_gradient: {
      gesture: "Continuous thumb/pointer scrub along the rail or slow two-finger pinch"
      mark_state: "~ (potential / preview)"
      law: "Parameterized path γ(t) ∈ [0, 1] across a single homogeneous fiber (1 kind per rail). Previews camera framing, force field weighting, or candidate pivot highlight without mutating source text until release/commit."
    }
    discrete_step: {
      gesture: "Detent crossing, tap, flick (← → ↑ ↓), or keyboard step ([ / ])"
      mark_state: "! -> * (action committed to value receipt)"
      law: "Quantized index transition k -> k ± 1 over an algebraic orbit (sibling part, stratum level, or valid pivot). Emits a parseable Spw receipt (* line) and preserves nameSet invariance."
    }
  }
}

^"scrubbing_pinching_merging"{
  scrubbing: {
    role: "1D Fiber Traversal & Ephemera Time-Reversal"
    mechanics: [
      "Spatial fiber scrub: Holding one rail kind locks a typed 1D slice (e.g., all #spwTreeItems on Left, or all valid pivotsOf(site) on Right) so 34 heterogeneous stops never jumble into hyperbolic disorientation.",
      "Temporal residue scrub: Scrubbing the ephemera clock (motion-and-marks-2026-11.spw) replays recentActivations and * receipts without an explicit undo stack, turning history into a scrubbable spatial dimension."
    ]
  }
  pinching: {
    role: "Metric-to-Topological Scale Functor (Continuous Zoom -> Discrete Stratum Phase Transition)"
    mechanics: [
      "Velocity-gated bifurcation (body-gestures.ts + pinch.ts): Slow pinch (dt >= 280ms) acts on metric geometry (continuous box radius r and camera zoom k). Quick pinch/spread (dt < 280ms across 0.8 / 1.25 or 0.65 / 1.35 thresholds) acts on AST topology.",
      "Stratum ladder (brace-folds.ts): Pinching closed steps up the abstraction lattice (particles -> parts -> as-written -> folded {…} -> parent frame ^up); spreading open steps down the concretization lattice (folded {…} -> as-written -> by-parts -> enter child frame #>enter)."
    ]
  }
  merging: {
    role: "Conservative Algebraic Confluence (& Join, Seam Cycling, and Tight-Bond Attachment)"
    mechanics: [
      "Line/Node Confluence: Dragging two bodies or lines into mutual proximity previews their join under & (confluence), ~> (stream pipe), or shared outer walls { a, b }.",
      "Seam & Bond Resolution: Once merged, scrubbing across the seam cycles withSeam (. , ; ~>), withBetween (~ ^ & @), or tight attachment (a@(b) <-> a@ (b) <-> a @(b)).",
      "Conservation Law: Every merge is gated by pivots.ts invariance — nameSet(merged) === nameSet(left) ∪ nameSet(right) and all 3 readers (line, parser, spoken) must return ok: true."
    ]
  }
}

^"computer_science_abstractions"{
  huet_zipper_and_comonads: {
    spw_construct: "Site in pivots.ts ({ focus, up: (text) => string }) and outward/inward in line-edit.ts"
    cs_theory: "Huet's Functional Zipper & Comonadic Context (W a = (Context, a)). extract(site) yields the focused fragment; duplicate(site) yields the neighborhood of sibling and parent sites; extend(pivotsOf, site) computes all valid local rewrites in context in O(1) hole-plugging time."
  }
  bidirectional_lenses: {
    spw_construct: "line-kit contracts (readLine / writeLine, write-back identity, one-span edits)"
    cs_theory: "Well-behaved Asymmetric Lenses & Concrete Syntax Preserving Printing (PutGet, GetPut, PutPut laws). Modifying a single slot or mark updates only its byte span while preserving surrounding whitespace, comments, and sibling formatting."
  }
  term_rewriting_and_egraphs: {
    spw_construct: "spw rewrite (_1, _2, _0 templates) and pivotsOf 7-kind neighborhood graph"
    cs_theory: "Term Rewriting Systems (TRS) & Equality Saturation (E-Graphs). pivotsOf enumerates the 1-step equivalence class of an expression under mark/side/wall/bond permutations, partitioned by whether they preserve AST structure (syntactic congruence) or intentionally shift operator polarity."
  }
  operational_semantics_and_effect_systems: {
    spw_construct: "act-chains.spw prefix arms ($ ~ ?) vs postfix discharges (* % # !)"
    cs_theory: "Call-by-Push-Value (CBPV) & Algebraic Effect Handlers. Prefix marks type the computation suspension/thunk (~ lazy, ? prompt/continuation, $ meta-quote/address); the bracketed body is the carrier; postfix marks handle or discharge the result (* memoize/value, % sample/telemetry, # project/index, ! linear channel emit). Non-commutativity (~*x != *~x) directly reflects handler-thunk composition order."
  }
  abstract_interpretation_and_galois_connections: {
    spw_construct: "line-summary.ts & brace-folds.ts (as-written <-> by-parts <-> particles <-> folded {…})"
    cs_theory: "Galois Connection (α, γ) between Concrete ASTs and Bounded-Width Abstract Summaries. Pinching applies α_budget(tree) to monotonically fold deepest subtrees first until length <= budget; spreading applies γ to restore exact subtrees."
  }
}

^"guided_symbolic_manipulation"{
  thesis: "Spw turns abstract syntax manipulation into a self-validating tactile calculus — bridging algebra tiles, structural editors (Paredit/Tree-sitter), and interactive proof assistants."
  four_pillars: [
    "1. Conservation of Names (No Silent Drops): Every gesture (pivot, swap, fold, merge) checks nameSet(after) === nameSet(before). Users can freely experiment with mark placement and bracketing knowing their domain identifiers cannot vanish.",
    "2. Three-Way Read-Back Receipts (line + parser + spoken): Every candidate pivot in pivotsOf is pre-checked against the line reader, the full AST parser, and the spoken-gloss generator. Invalid moves remain visible in the orbit with their exact failure diagnosis rather than failing silently or breaking the file.",
    "3. Physical & Acoustic Intuition for Algebraic Laws: In factshift.center (LAW_SAYS local forces) and lore.land (spw-sound.mjs / ^ear), each operator carries a distinct physical force and harmonic interval, allowing users to feel and hear when an expression shifts from potential (~) to committed value (*) or action (!).",
    "4. Dimensional & Structural Verification (spw.quantity-sheet/1): Combining symbolic Spw frames with exact rational dimensional analysis and Buckingham Pi null-space derivation lets users manipulate physical formulas and system invariants with live unit and dimensionless-group feedback."
  ]
}

^"ecosystem_harmonies_and_factshift_mutation"{
  .sources: [
    "spwashi.com/.spw/caches/cross-product-rederivation-2026-11.spw",
    "spwashi.com/.spw/caches/gemini-4-argon-2026-11.spw",
    "spwashi.com/.spw/caches/bidirectional-parsing-runtime-evolution-2026-11.spw",
    "spwashi.com/.spw/caches/pie-loop-memory-2026-11.spw"
  ]
  re_derivation_rule: "text_first and derived_not_authored: only what sits in the Spw line or URL (#spw64= / ?spell=) crosses hosts, so any interpreter holding one shared table re-derives the same geometry, physics, or music from bare text."
  slot_and_kind_reconciliation: {
    slot_grammar: "Converge on word[mode]{body}(scene)<concept> where [ ] holds mode/instances, { } holds body joins (. , ; ~>), ( ) holds gathering/scene (matching lore.land's ast-play.spw reading where (tool{windows, submenus, edges}) arrives whole), and < > holds kind/concept."
    bidirectional_braces: "Labeled boundaries {_label ... }_label isolate missing closers to one named class when scanned forward or backward, complementing factshift.center's ionic ghost -q particles on unclosed frames."
  }
  factshift_representation_and_mutation: {
    optical_slot_materials: "Even with glyph labels hidden, each slot shows its structural physics optically: [mode] as a bonded glass collar, {body} as a recessed matte well lifted into a specular card when folded, (scene) as a wrapping paper mat over word+body, and <concept> as an enterable threshold rim."
    mutating_lore_land_spw: "Trope ladders (~ -> ? -> # -> & -> ^), road-word sayings (#saying[cN]{ .read #marked *fed }), =meme[pov] valence registers, ^board{}, ^ear{}, and ~{room}@cast lines export via #spw64= to factshift.center, where nested ~ bodies arrive folded at Stratum 0 until touched, owed closers act as ionic charges, local @/! marks clamp inside their brace hull, and Right Rail pivots return edited lines cleanly to /scriptorium/ or spw.quest."
    digraph_round_trip: "Entering a nested concept like !fix[timeout]{checkout; retries}(service)<team<cache>> and saving back through writeLineSlots must preserve >> as two capsule closes rather than STREAM_CLOSE prose degradation."
  }
  sensory_export_parity: "spwashi.com already bundles spokenLine, scanPairLabels, pairSound, readEarcons, TEXTURES, PAIR_SOUND, and wavBytes with zero active host callers; lore.land's spw-sound.mjs, pie-sound.mjs, and sound-check.mjs establish the live Web Audio & ^ear testing loop that bridges stratum steps (0 <-> 1 <-> 2), dipole tension, and math-as-music (continued fractions / harmonic ratios) back to factshift.center and spw.quest."
  four_plane_memory_and_wap_loop: {
    planes: "visit (sessionStorage / #spw64= / ?direction) -> browser (localStorage, visible & per-item clearable) -> file (~/.spw/ exported snapshots) -> repository (static canon)."
    pie_loop_doors: "wap.mom issues (Pi, 22/7, 355/113, Needles) open doors into lore.land plays and unlocks; lore.land's mathematical undercurrents (frill_lichen, remainder_moths, sliver_tin) return via carried ^pie[...]{...} / #spw64= keys."
  }
}
