# Lore.Land reasons (generated by .spw/tools/way-canon.mjs from book/content/world/way.json; re-run, do not edit)
# Why each chapter is in the book, what it holds for the chapters after it, one wonder a single edit past a room of it, and who can be kept apart.
# Wonder form: .spw/_workbench/docs/theory/spw/wonder-field.spw. A wonder is a line one edit past what already reads; its measures name the ways it could come out; its probe is the act that tells.
#>lore_land_surfaces_reasons
#:surface #!canon
#:layer #!pragmatics
#:status #!live

~<rationale>{
  A book can say why it is the way it is without explaining itself. Each chapter here has a reason in the register of its maker, shown folded at the end of the chapter, and one question a reader can guess at before reading on. The guess is the expect, a later chapter is the probe, and the answer is what the reader says. Nothing here scores it. Some wonders have no probe. They are kept open on purpose, and nothing may close them in passing.
}

^reasons[
  @c01{ #why["A wish has to be something you can hold and cannot file, so the first chapter makes it warm and has the maps refuse it. The reader learns early that being recorded and being real are different jobs."] .holds["Boof dug a warm egg out of a frozen furrow. It was an unspent wish, and no map in Boon.land would take it down."] }
  @c02{ #why["Before anyone can want the egg, the land has to practise wanting. The grove repeats things a beat late so a reader gets used to futures that sound like memories."] .holds["The grove answered the egg a beat late, rehearsing futures it had not decided to grant."] }
  @c03{ #why["Wish stories usually take the genie for granted. This one opens his practice in the sand, so the reader meets a professional who can price anything and cannot see a small want."] .holds["Boof's weight settled two old roads into one turn, and she dug up a retired Genie who could grant anything and could not read what she wanted."] }
  @c04{ #why["The book needs a fair hearing for the worst idea in it. Mr. BaneWAP gets a council and a good argument, because a villain nobody could agree with would teach nothing."] .holds["The council had no law for the egg. Mr. BaneWAP argued it should be filed and auctioned to himself, and every key on the hill failed to fit it."] }
  @c05{ #why["Two claims need somewhere to be equally wrong. The floor parts so the argument has a physics, and the Genie can say the rule the rest of the book stands on: a small turn costs a little, a grand one is still being paid."] .holds["Two claims pulled at the egg until the floor parted. The Genie taught what wishing costs: a small turn costs a little, and a grand one is still being paid."] }
  @c06{ #why["Up to here everything given has cost something. Mr. BoonWAP is the counter-example, delightful and slightly alarming, so a reader can enjoy abundance before asking what it would take to be him."] .holds["In Bonk City, Mr. BoonWAP fed a plaza from himself and was no smaller, and asked Boof the one question she could not answer yet. She kept a slice, warm in waxed paper."] }
  @c07{ #why["A promise is the first thing Boof does on purpose. The oath is cheap to swear and costly to keep, and the shadow clause says aloud that someone else usually pays."] .holds["At the market stone Boof swore to spend the wish only when the want is true, and learned that every spent wish owes a coincidence to a stranger."] }
  @c08{ #why["The Genie's trade needs a day at work. Pricing a tavern's wishes shows that ordinary wants resist his machinery more than empires do, which is what makes hers impossible to read."] .holds["At the well that folds faces, the Genie priced the locals' wishes and found Boof's small asks would not come out to a number."] }
  @c09{ #why["A missing thing needs an outline before it can be missed. Eight honks laid on a ridge give the reader a hole the exact size of what they have been carrying."] .holds["Eight honks lay on the ridge as shards, and put together they left one hole, exactly egg-sized."] }
  @c10{ #why["Could and cost have both had their say. Bone.land asks only what remains, and the hall is honest so there is one room in the book that will not flatter anybody."] .holds["In Bone.land the great frame bore the egg, and the answer rang through every beam: the smallest wishes have the longest arcs. Mr. BaneWAP stopped waiting."] }
  @c11{ #why["The reader has to see a grand wish granted in full, or wishing for less would look like a failure of nerve. So it arrives at once, and the book lets him have it."] .holds["Mr. BaneWAP took the egg and wished an empire. It came at once, hollow as a rented crown. His hoarded berries woke inside him, and the egg rolled back warm to Boof."] }
  @c12{ #why["A confluence is the book's idea of an ending: everyone arrives, nothing is flattened, and the receipts hang side by side. Boof's wish is small on purpose. It has to fit in a mouth."] .holds["At the meeting of two rivers Boof named her wish, one warm furrow kept open for whatever arrives next without a receipt. The Genie priced it honestly and walked upstream to become an echo."] }
  @c13{ #why["The book closes everything except one brace, on purpose, because a serial needs a door and a reader needs somewhere to stand afterwards."] .holds["The spent wish sounded as the ninth honk, the maps took the ink at last, and the last line was left blank."] }
  @c14{ #why["Book Two starts by collecting a debt the first book ran up. A day goes missing so the reader can see who keeps time for its own sake, and the field and the dog keep it without being asked."] .holds["The Genie's price came due and a Thursday went missing from everyone's week but not from the field. On the day nobody kept, Boof found someone standing under a hat."] }
  @c15{ #why["A record can be accurate and still miss what came through. Three careful hands write down one stranger three ways, so the reader has to hold all three and leave a box open."] .holds["A porter held the parcel gate through a storm for a stranger, and by morning three honest records disagreed about what came through."] }
]

?wonders[
  ?c01{ ~#with: "~{warm_furrow}@boof" ~#edit: "~{warm_furrow}@the_ants" #says["The same warm ground, read by the ones who live under it."] #asks["Who is the furrow warm for?"] $%["The ants, who keep it", "Whatever is lying in it", "Nobody. It is just warm"] ~#probe(read): "book/chapter/12" }
  ?c02{ ~#with: "~<forked_path>@the_echo" ~#edit: "!<forked_path>@the_echo" #says["An echo that acts where it used to repeat."] #asks["If the echo chose, what would it choose?"] $%["What she would have chosen", "Whatever she would not", "Still a beat too late to matter"] ~#probe(read): "book/chapter/13" }
  ?c03{ ~#with: "&<one_turn>@boof" ~#edit: "&<one_turn>@genie" #says["The same turn, seen by someone who used to sell them."] #asks["What does he make of a road settled with no miracle asked?"] $%["He is relieved", "He knows he is out of work", "He does not notice"] ~#probe(read): "book/chapter/08" }
  ?c04{ ~#with: "@[weather_pane]@the_mirror" ~#edit: "@[weather_pane]@banewap" #says["The mirror that shows what wanting becomes, read by the one who wants the most."] #asks["What does the mirror show Mr. BaneWAP?"] $%["A balance sheet", "His own crust, from the outside", "Something sweet he does not recognise"] ~#probe(read): "book/chapter/11" }
  ?c05{ ~#with: "%{crack_gauge}@genie" ~#edit: "!{crack_gauge}@genie" #says["Measure becomes action: he mends it before he has finished listening."] #asks["What happens if the crack is mended first?"] $%["The hum moves somewhere else", "It closes and nothing changes", "It cannot be done"] ~#probe(read): "book/chapter/10" }
  ?c06{ ~#with: "?(round_plaza)@boonwap" ~#edit: "!(round_plaza)@boonwap" #says["He stops asking and answers it for her."] #asks["If he answered his own question, what would her wish become?"] $%["Smaller", "Larger", "Somebody else's"] ~#probe(read): "book/chapter/12" }
  ?c07{ ~#with: "=(oath_stone)@boof" ~#edit: "=(oath_stone)@the_stranger" #says["The same oath, read from where its shadow lands."] #asks["What does the stranger get?"] $%["Paid back, somehow", "Nothing, and never knows", "They are someone you have met"] ~#probe(read): "book/chapter/15" }
  ?c08{ ~#with: "%(taproom)@genie" ~#edit: "%(taproom)@the_beavers" #says["The same room's prices, quoted by the ones who finish the job themselves."] #asks["What would a beaver charge?"] $%["One evening", "Nothing", "It would not quote"] ~#open: "on purpose" }
  ?c09{ ~#with: "&(eight_shards)@boof" ~#edit: "%(eight_shards)@boof" #says["A gathering becomes a count."] #asks["What is the ninth?"] $%["Eight is enough", "A ninth can still be made", "The gap is the piece"] ~#probe(read): "book/chapter/13" }
  ?c10{ ~#with: "?{sill_beam}@bonewap" ~#edit: "!{sill_beam}@bonewap" #says["A felt mallet asks. An iron one tells."] #asks["Does a struck beam answer the same way?"] $%["The same", "It lies", "It stops answering"] ~#open: "on purpose" }
  ?c11{ ~#with: "!(bloom_garden)@banewap" ~#edit: "~(bloom_garden)@banewap" #says["The bloom only might. Nothing has been granted yet."] #asks["If it had only been a might, what would he have done?"] $%["Waited", "Wished harder", "Been kinder, and hated it"] ~#probe(read): "book/chapter/12" }
  ?c12{ ~#with: "&(bridge_deck)@boof" ~#edit: "&(bridge_deck)@the_ferryman" #says["The same crossing, from the person who has never bailed one water with the other's can."] #asks["What does the ferryman think he saw?"] $%["A settlement", "Traffic", "Forty years of the same thing"] ~#open: "on purpose" }
  ?c13{ ~#with: "~{last_line}@boof" ~#edit: ".{last_line}@boof" #says["A might becomes a ground: the unwritten line is somewhere to stand."] #asks["Who fills in the last line?"] $%["Someone walks in", "Nobody, and it is fine", "You do"] ~#probe(read): "book/chapter/14" }
  ?c14{ ~#with: "=[quarter_turn]@the_berries" ~#edit: "=[quarter_turn]@the_hat" #says["The berries' quarter turn, read from the hat."] #asks["Which turned first?"] $%["The hat", "The berries", "They were never facing the same way"] ~#probe(read): "book/chapter/15" }
  ?c15{ ~#with: "#{three_records}@the_city" ~#edit: "#{three_records}@the_porter" #says["The same three records, from the one who held the gate."] #asks["What would the porter write?"] $%["A fourth entry", "His name, under all three", "Nothing in the box"] ~#open: "on purpose" }
]

!company{
  *two_pies{ &who["boon, bane"] #name["The two pies, in separate rooms"] #primes["Mr. BoonWAP and Mr. BaneWAP are never in the same room. One passage is told another way, and marked where it changes."] #why["Their one shared room is the bridge in Chapter Twelve, where a bitter pie is received warm. It is the book's idea of forgiveness, and some readers would rather not be asked to watch it."] #costs["You keep the apology and lose the welcome. In the lanes their themes no longer answer each other in Six, Ten and Twelve."] %swaps[5] }
  *boof_and_bane{ &who["boof, bane"] #name["Boof and Mr. BaneWAP, never in a room"] #primes["Two chapters step out and are told in a line each, and one passage is told another way."] #why["He argues against her at the council and takes the egg from her sling by hand. A household may want the dog and the announcer kept apart, and the book can bear it, since the rest of what he does reaches her by envelope, by rumour, or down a road."] #costs["You give up the council and the seizure, which are where the book argues with itself. A line at the next chapter says what each held."] !aside[4, 11] %swaps[1] }
  *clowns_and_mimes{ &who["clown, mime"] #name["Clowns and mimes, on different days"] #primes["The lanes send no mimes. The pie words stay as they are, and nobody contests a chapter."] #why["They are the lanes' own quarrel and never share a room in the book. Some people like one and not the other, and some would rather not have either coming at them with feeling."] #costs["No march, no walls, nobody to out-do. A chapter the mimes already hold can still be won back with clowns."] %swaps[0] }
}

# Every choice of the way is also a fork: what forks, on what, and where each side goes (book/scripts/modules/forks.mjs).
# boon leans forward, the book as it stands; bane leans inverse, the book turned from itself. Drawn at a chapter end under the forks trial.
?forks[
  ?c01[way]{ =boon@kept{ @c01 } =bane@aside{ @c02[held] } }
  ?c02[way]{ =boon@kept{ @c02 } =bane@aside{ @c03[held] } }
  ?c03[way]{ =boon@kept{ @c03 } =bane@aside{ @c04[held] } }
  ?c04[way]{ =boon@kept{ @c04 } =bane@aside{ @c05[held] } }
  ?c05[way]{ =boon@kept{ @c05 } =bane@aside{ @c06[held] } }
  ?c06[way]{ =boon@kept{ @c06 } =bane@aside{ @c07[held] } }
  ?c07[way]{ =boon@kept{ @c07 } =bane@aside{ @c08[held] } }
  ?c08[way]{ =boon@kept{ @c08 } =bane@aside{ @c09[held] } }
  ?c09[way]{ =boon@kept{ @c09 } =bane@aside{ @c10[held] } }
  ?c10[way]{ =boon@kept{ @c10 } =bane@aside{ @c11[held] } }
  ?c11[way]{ =boon@kept{ @c11 } =bane@aside{ @c12[held] } }
  ?c12[way]{ =boon@kept{ @c12 } =bane@aside{ @c13[held] } }
  ?c13[way]{ =boon@kept{ @c13 } =bane@aside{ @c14[held] } }
  ?c14[way]{ =boon@kept{ @c14 } =bane@aside{ @c15[held] } }
  ?c15[way]{ =boon@kept{ @c15 } =bane@aside{ @c14[last] } }
  ?two_pies[way]{ =boon@meet{ @c12 } =bane@apart{ @c12[told] } }
  ?boof_and_bane[way]{ =boon@meet{ @c04 @c11 @c12 @lanes } =bane@apart{ @c04[aside] @c11[aside] @c12[told] @lanes[apart] } }
  ?clowns_and_mimes[way]{ =boon@meet{ @lanes } =bane@apart{ @lanes[apart] } }
]

^held[
  { &who["boof, ants"] #why["She works for the land and they keep it warm. A chapter without them would be set somewhere else."] }
  { &who["boof, genie"] #why["His price is the plot of both books. Set Chapter Three aside if you like, and the Thursday will still come due."] }
  { &who["boof, figure"] #why["Book Two's question is what she notices before anyone has a word for it. Set Fourteen or Fifteen aside if you would rather not meet them yet."] }
  { &who["porter, figure"] #why["The gate held for a stranger is the chapter. Without the stranger he is a man lifting a gate."] }
]
