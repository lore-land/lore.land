# Lore.Land Spw as play
# What makes the language useful and fun here: spells that can be heard (spw-sound.mjs), touched and
# turned (scrubbable numbers), copied and pasted with their origin, read aloud by the card
# interpreter, worn as textures, woven as stories (story-loom.mjs), and discussed by a design table.
# The last block is what this repository asks of the workbench, as distinct from the language's
# other readers.
#>lore_land_surfaces_spw_play
#:surface #!mechanic
#:layer #!pragmatics
#:status #!live

~<rationale>{
  A notation becomes a toy before it becomes a tool when every part of it answers a touch. Here a spell lights by role, says what each part does, can be played as music, and its numbers turn like dials; copied, it carries where it came from, and pasted, it goes where it belongs. None of it is required to read the book; all of it rewards the reader who leans in.
}

^music{
  .note: "book/scripts/modules/spw-sound.mjs; a play button on any spell (spw-spell.mjs play option)"
  voices: "? a rising fourth left open · ~ a slow pad · @ a pluck placed by name · & a third · * a bell · ^ three notes climbing · ! a knock and a thump · # a glass ping · . a low ground note · = the filter turned · % ticks, n of them · $ a texture by material"
  time: "[ ] one after another · { } held over a ground · ( ) all at once · < > a passage, each note gliding into the next"
  pitch: "a label chooses a degree of the spell own pentatonic key; the whole text chooses the key, so every spell has its own"
  words: "a quoted string is breathed, a syllable at a time, under the music"
  lit: "each atom lights as it sounds, so a spell can be followed by ear and eye at once"
}

^textures{
  .note: "the eight materials (materials.mjs) as sound and as surface"
  sound: "glass shimmers · flour puffs · berry plucks · frost crackles · ink hums low · brass rings · steam breathes · oak knocks"
  surface: "a spell that names a $material wears its ground and sheen (materials.css tokens)"
  scenes: "each place in the game has a material (!scenes{} in pie-rules.spw) and plays its texture as it begins"
}

^dials{
  .note: "scrub option of spw-spell.mjs; the tuning desk on /pie/ (=tune, =lean, !scenes)"
  turn: "scroll over a number, drag it up or down, or focus it and use the arrow keys (shift for ten); it is held to its range"
  effect: "the game retunes at once, and the spell is kept as the visit own, beside the bench"
  tunables: "aim step, knock swing, pad pace, slow land, foretelling, flinch, in kind, swipe across, swipe along, ahead bonus, drama"
}

^copy_and_paste{
  copy: "a copy button on a spell copies only the spell, with #from[where it came from] on its own line"
  paste: "pasted anywhere on /pie/ (outside a text box), a spell is read and routed: rules to the bench and into play, a card to its place in the deck, a carry beside the provenance cards, a chapter reading to a link that reads it that way"
  design: "?design on /pie/ names every section of a card and copies a note for it: ?design[card.kind.section]{ #now[…] #note[…] @by[…] }"
}

^prime_and_cast{
  .note: "spw-spell.mjs enablePriming, after spwashi.com: .spw/conventions/charge-cycle.spw, the factshift lifecycle (primed, held, actualized, residue), spw.quest pivot (a tap primes, a second tap acts)"
  tap: "a first tap primes an atom: nothing is written, and its next step is said (what it would do in the game, and its discharge kind); a second tap while it is charged casts it: one change, a receipt in the sigil own verb, and residue (a faint halo stays)"
  lifetime: "a prime holds a charge of 0.82 that bleeds 0.18 every 2.8 s and goes quiet below 0.08, back to ground; Escape or a tap elsewhere lets it go at once"
  kinds: "release ? ! (at once, and over) · transfer ~ @ & $ (carries something on, for a while) · ground # = . % (sets a value, and stays) · project ^ * (binds upward, and is kept)"
  verbs: "? answered · ! struck · ~ taken · @ seen · & joined · $ made · # marked · = tuned · . let go · % measured · ^ lifted · * kept"
  event: "a cast dispatches spw:cast with sigil, label, atom, kind and verb, for whatever page the spell is on to act on"
}

^card_interpreter{
  .note: "pie-game.mjs interpretCard"
  narrative: "as a card turns in the lanes, the lanes read its spell aloud, one atom at a time, each lit and said in plain words: what it is, what it costs, what it gives, whose voice says it"
  identity: "every card has a spell: its rule (a knock, a power) or who it is, @kind{ .type[…] .first[…] ^sprite[…] #name[…] }"
}

^whimsy{
  .note: "!whimsy{} and !scenes{} in pie-rules.spw; impact() in pie-game.mjs"
  impacts: "a word pops (BONK!, SPLAT!, BZZT!), bits fly (juice, crumbs, feathers, glass, confetti, stars, flour), the view leans in, and at the best moments the world holds its breath"
  scale: "=drama times the sprite own drama times the scene own; calm under reduced motion and zen"
}

^points{
  .note: "pie-game.mjs noteFeed, captionOf, paintPoints, paintPointsRules, worthOf; the weights are =lean in pie-rules.spw"
  ways: "every point leans the chapter one of three ways: fairy tale (boon), absurd reality (bane), low magic (bone); the sums are how the chapter will be kept, never a score to chase"
  contest: "pie against Mimes Against WAP is the one contest: for the pie a slice over the mimes, a baneberry sweetened, a clown satisfied, Mr. BaneWAP foiled; for the mimes a slice boxed, a knock from a mime, a baneberry they brought him, a march let past or run its course"
  said: "whatever moves in one moment is one entry, placed where its impact was: a chip rises from there in that way's ink, the panel beside the screen says it in words newest first, and the spill card says how the whole carry was scored"
  rules: "How points work is drawn from the rules in play, so a weight tuned on the desk is marked tuned there at once"
  cards: "a card turned in the lanes says what it can be worth before it is played"
}

^show{
  .note: "pie-show.mjs; the ▢ Show button or V cycles off, inset, board"
  inset: "a window beside the caption, never over the lanes: the last interaction as a still with its points; between times the board in small"
  board: "the alternate view: the lanes as a plain board, every thing a token by what it does, its height as its edge (underfoot dashed, in the air shadowed), ⤒ where a hop clears it and ⤒⤒ where only a high hop does, its name under it; the lanes as drawn shrink into the window"
  reel: "the last six stills, each captioned with what happened and what it was worth"
}

^mechanics_drawn{
  .note: "pie-game.mjs drawMechanics, drawFace, moodOf; carrierStats and the knacks in CARRIERS"
  gifts: "every gift in force is a badge over the hat with what is left of it as an arc (echoes as a count)"
  catch: "when the pie leans, a chevron on the side to step to says CATCH"
  combo: "a combo is pips over the hat and a bar of the time left to keep it going"
  poise: "stillness fills a ring under the feet; poised, it is gold"
  faces: "the carrier face follows the carry: calm, focused on the needle, glad after a WAP, worried as it tilts (a bead of sweat near the top), ouch at a knock"
}

^heights{
  .note: "pie-heights.mjs, fed a snapshot by pie-game.mjs heightsSnap; the ⤒ Heights strip under the screen"
  view: "the carrier lane turned on its side: time to the right (1.8 s ahead), height up: air (step aside), body (⤒⤒ only a high hop clears the lighter ones), low (⤒ a hop clears), underfoot (⤒ a hop passes over)"
  arc: "the arc of a hop taken now, higher if it would chain; what falls under it is marked ✓, and ✓♪ where it falls in the top third"
  words: "a line says what is next and what to do about it: hop in 0.3 s, hop now, step aside, only a high hop"
  chain: "three pips and the window to keep the chain; the third clean hop is a high hop"
  configure: "two ways to see height, each its own option: the ⤒ ⤒⤒ ▮ marks worn in the lanes (learnable at a glance), and the side view (the strip); in the strip each part turns on or off (arc, words, bands, chain, meanwhile) and it looks 1.2, 1.8 or 2.4 s ahead; kept in this browser"
  reward: "planned: parts of the side view earned rather than given, the arc after a first hop in time, the words after a chapter carried, a longer look after a high hop; everything stays configurable once earned, and nothing a player has now is taken away"
}

^cabinet_setup{
  .note: "pie-game.mjs SETUP, applySetup, paintSetup, the hand pinch; reading-gestures.mjs for the chapter pages"
  top: "the controls sit at the top of the cabinet, two rows of five: pause, sound, story, zen, full; ask, labels, show, hands (touch), setup"
  pause: "a ❚❚ Pause button for screens without Esc; it reads ▶ Resume while paused"
  configurable: "cabinet size (small, medium, large, larger), pace (gentle 0.8×, as written, brisk 1.2×: the whole world on one clock), the story (beside the screen, under the screen in the cabinet, folded away), the story words (four sizes), the heights strip (shown or hidden, and its parts in its own row), the show (off, inset, board), labels, ask, zen, the hand the pad sits under"
  mobile: "on a touch screen the cabinet stacks: controls, setup, screen, pad, the story strip if chosen, heights, caption, steps; its width comes from the window height times the cabinet size, never wider than the window"
  pinch: "by hand: two fingers over the story size its words, over the cabinet frame size the cabinet, never over the lanes or the pad where fingers play; Safari pinch and ctrl+wheel do the same"
  reading: "the story not passing stays legible (two-thirds ink); the passage going by is full ink with a gold edge"
  fit: "the default size fits the window: everything play needs in view (controls, screen, pad or steps) is measured, and the screen takes the rest of the window height, never wider than there is room for; measured again on every resize"
  panels: "on a wide screen the caption and the heights strip sit beside the cabinet, at the head of the wonders column, so the cabinet is the controls and the screen; on a narrow one they follow the steps, below the fold"
  controls: "icons in one row (compact, the default; each keeps its words as its name) or icons and words; above the screen or below it"
  story: "a passage at a time (each paragraph comes to the line and holds still while it passes, the default) or smoothly with the carry; the passing line high, middle or low"
  immersion: "on Play the cabinet comes fully into view, measured from where it sticks; Setup can leave the page where it is"
  sheet: "⚙ Setup is a sheet over the screen, anchored to the controls, scrolling within itself; the cabinet keeps its shape while it is open; a tap outside or Escape puts it away"
}

^rooms_in_lanes{
  .note: "pie-game.mjs ROOM_PLAY, roomNow, roomThing, castIfRoomAsks, announceRoom, outcomeSpell; canon in .spw/runtime/pie-rules.spw ?outcomes and !rooms; lanes-lore.mjs shows a cast on the page"
  gradient: "while a room passes, its sigil's own things come up the lanes now and then, and in its last third the next room's begin to: the play changes with the story, not at a cut"
  cast: "each sigil has a verb (struck, answered, taken, seen, joined, kept, lifted, marked, let go, tuned, measured, made); do it while the room passes and the room is cast, once a carry, kept in lore.rooms.cast.v1 and worn on the room's doorplate in the chapter"
  outcomes: "every outcome is a probe and a measure that returns a bias and a reference: !satisfied{ ?appetite %pips[1] =fairy_tale[1] ~\"book/chapter/01#the-warm-furrow\" #room[1] }"
  progressive: "a room's banner says its signature at first (syntax); what its sigil makes of the lanes once a room of that sigil has passed before (semantics); and how to cast it from the third, or as soon as one is cast (pragmatics)"
}

^lanes_story{
  .note: "pie-game.mjs laneStoryTick, laneStoryStep, paveSentence, drawLaneCaption, drawRoadWords; ⚙ Setup: story in the lanes"
  why: "the carry goes through a chapter far faster than anyone reads (a passage a second or so), and on a phone the story beside is out of sight while playing; so the lanes tell it at reading speed"
  caption: "the sentence (a long one in clauses) as a subtitle at the top of the screen, up for as long as its words take to read; when it falls more than four behind it skips ahead to the carry, and says … where it did"
  road: "a phrase at a time painted on the cobbles, coming down with the world, five or so on the road at once; a stream of glimpses that keeps up by dropping the oldest; a wonder's own words glow, and stepping onto one underfoot reads it: a little crust, and the chapter leans toward the fairy tale (=lean read)"
  defaults: "a caption on a narrow screen, nothing in the lanes on a wide one where the story runs beside"
}

^layouts{
  lanes_first: "the screen as large as the window allows, the story as a caption, nothing else in the way"
  reader: "the story beside the screen (under it on a phone), large, a passage at a time"
  tactician: "heights with every part, the show window, the story on the road to step on"
  comic_page: "every panel: caption, heights and its meanwhile, the show window, the story as a caption"
  grips: "the cabinet's corner ◢ drags (or arrow-keys) its size; the story strip's foot drags its height"
  snapping: "a drag of the corner holds at the sizes the window offers (fit the window, medium, as wide as there is room) and between them steps on a grid where each lane is a whole number of pixels; the size it holds is said beside the corner"
  buttons: "throw and hop in the middle of the steps, on either side of them, or as an A/B pair on a diagonal (B low, A high), either way round, mirrored by Hands; on a touch screen the same, beside or around the pad; two-row layouts keep their buttons short; the buttons come small, medium or large"
}

?views{
  across: "easier on the drawn lanes and the board; harder on the heights strip, which is one lane"
  ahead: "easier on the lanes and the board; harder in the show window and with the story in the lanes"
  height: "hardest from above: the ⤒ marks and the heights strip are there for it"
  timing: "easier on the heights strip and in the show window (after the fact); harder with the story beside, where the eyes leave the lanes"
  story: "easier beside and in the lanes; harder on the board and the heights strip"
}

^app{
  shortcuts: "the installed app leads with Play (the game) and Atlas (the seed atlas), each with its own icon drawn from the book: Mr. BoonWAP glad, and a study seal; then the desk, Chapter One and the zine"
  front_page: "launched from its icon, the front page offers the game and the atlas at its top"
  offline: "keeping the book offline keeps the game and the atlas pages too"
}

^end_of_carry{
  .note: "pie-game.mjs paintCarrySheet, paintNextPrompt, carryPrompt; the card and The carry, inspected"
  card: "a prompt, top to bottom: what happened in a line, what to try next (from why it spilled, a chapter the mimes took, rooms unread) with a way to do it, play again; then how to play again and the ways out"
  inspected: "every achievement a tile with best yet marked; tap one for what it is, what each is worth in points, this carry against your best and your whole record, the stills of those moments if the show kept them, and its Spw atom; the carry itself as a provenance spell"
  prompt: "copy the carry as a scene to write or draw from, in the book voice, with where it came from"
}

^exchange{
  .note: "the game and the story feed each other both ways; .spw/audits/progression.spw counts it (npm run spw:progression)"
  story_to_game: "rooms read in a chapter steady the pie there, up to a third; a chapter read room by room makes the pies say its lore; the chapter toast says how many rooms you have read"
  game_to_story: "lore heard in the lanes is set beside its room on the chapter page (lanes-lore.mjs), in the speaker voice; unheard lore leaves a quiet note with both ways to it"
  lore: "every chapter now has at least one line grounded in a room, so every chapter read whole gives the lanes something, and the lanes give every chapter something back"
  progress: "the almanac writes where you are as a spell: .rooms *wonders &cards $palettes #lore @met ^next"
}

^in_time{
  rule: "a hazard cleared in the middle third of a hop is IN TIME: it leans low magic (=lean in_time), and a run of them is a rhythm the meanwhile panel answers"
  why: "timing nested in timing: the lanes are a rhythm the carrier keeps, and the panels keep it together"
}

^comic{
  panels: "the cabinet is a comic page: the lanes from above, the lane from the side, the show close up, and the caption as a narration box; inked frames, gutters, a shadow like ink"
  beat: "on an impact or a hop in time every panel frame inks gold at once, so the eye reads them as one moment"
  meanwhile: "an inset panel that breaks the frame of the heights strip and cuts to someone elsewhere in a mood with a word: Boof glad at a rhythm, surprised at a high hop; a clown glad at a WAP; Mr. BaneWAP thinking at a scheme; a mime silent where the mimes hold the chapter; whoever is under the hat, worried at a knock"
}

^carriers{
  figure: "fine hands: the needle turns a finer notch"
  porter: "long hold: an arrow holds the needle half as long again"
  clerk: "quick feet: a wider moment to chain hops"
  genie: "true after a WAP: each clown satisfied, the needle points true for two seconds"
  clown: "big feelings: every impact lands bigger"
  model: "each carrier card shows the knack and four bars: steady, quick, calm, unhurried"
}

^spell_display{
  .note: "spw-spell.mjs and components/spell.css"
  verse: "a long spell is laid out a line an atom inside its bodies, indented by depth; copying still gives it exactly as written"
  shape: "a pip an atom in its role ink heads every spell, and answers for its atom on hover"
  spectrum: "a hairline along the top in the spell roles in the order they are cast, so spells of one shape look kin"
  keycaps: "each sigil sits on a small tinted cap; the gloss speaks in the role of the atom it is about"
}

^stories{
  .note: "stories.spw, read by story-loom.mjs at /scriptorium/#loom"
  pattern: "touch a value and the stories that share it light; what they share is written as one spell, with ~_ where they part, and can be played"
}

?workbench_asks[
  runtime_reader: { why: "this book reads Spw in the browser at runtime (game rules, stories, signatures), where the 634 KB bundle costs a cold 300 ms or more" ask: "a small runtime entry for reading (lite.ts exists) with the same tree, published as its own bundle" }
  honest_success: { why: "a broken spell on the bench was called a success" ask: "success false, or a structural flag, whenever a structured read falls back to prose" }
  attach_rules: { why: "four walkers here each special-case @, ( ), and postfix observers" ask: "one attachment rule: a frame or body after any sigil and label belongs to that term; a postfix @ belongs to what it follows" }
  everyday_valence: { why: "a goose honks and a berry is a boneberry: the valence words are everyday nouns in this book" ask: "identifiers where identifiers are expected; modifiers only where a modifier can stand" }
  ranges_and_units: { why: "every number in the game rules is a dial with a range, and some are seconds" ask: "a way to write a range and a unit with a number, so a dial knows its bounds without a side table: ~lit[7s] =aim_step[0.13 of 0.04..0.4]" }
  holes: { why: "the loom writes what stories share with ~_ where they part" ask: "a pattern variable (a hole) as grammar, so anti-unification can be written and read back" }
  provenance: { why: "copy and paste carries #from[…] on its own line" ask: "a standard provenance annotation a reader can rely on, and a way to attach it to an expression" }
  sound_and_texture: { why: "spells are played here as music and worn as textures" ask: "a shared registry of sigil voices and material textures, so another reader of the language can play a spell the same way" }
  prose_canon: { why: "canon here is prose-heavy: apostrophes in rationale capsules still degrade a file" ask: "prose capsules that tolerate apostrophes and quotes as text" }
]
