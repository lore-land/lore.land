# Lore.Land Plugin Protocol
#>lore_land_plugin_protocol
#:protocol #!extensibility
#:layer #!pragmatics

^"registration"{
  template: {
    name: "kebab-case plugin id"
    version: "semver"
    selectors: ["$-query patterns"]
    output: "html | markdown | json | rss"
    transform: "@spw/surfaces/plugins/<name>.spw"
    hooks: {
      before_select: "optional"
      after_select: "optional"
      before_transform: "optional"
      after_transform: "optional"
      before_emit: "optional"
      after_emit: "optional"
      on_error: "optional"
    }
  }
}

^"lifecycle"{
  discovery: "scan .spw/surfaces/plugins/*.spw"
  validation: "verify selectors and output format"
  execution: ["select", "transform", "emit"]
  composition: "explicit chaining only"
}

^"invariants"{
  p01: "A workspace with zero plugins still publishes with default pipelines."
  p02: "Plugin composition is explicit."
  p03: "Backward compatibility of chapter references is required."
}

^"seed_plugins"[
  "spw-wonder-rss": {
    selectors: ["$?[\"_\"]@spw/chapters"]
    output: "rss"
    status: "planned"
  }
  "spw-chapter-diff": {
    selectors: ["$^[\"chapter\"]@spw/chapters"]
    output: "markdown"
    status: "planned"
  }
  "spw-pivot-gutter": {
    workbench_plan: ~"../_workbench/.agents/plans/first-plugin/wip.spw"
    kernel: "spw.pivots/1 (readFragments, pivotsOf, pivotReadCounts @ cf41ca22)"
    selectors: ["$^[\"observed_open_room\"]@spw/ecologies", "$^[\"rooms\"]@spw/surfaces"]
    role: "Surface one-nuance prefix/postfix & wall pivots beside three-reader status (line, parser, spoken) as authoring lenses."
    status: "proposed"
  }
  "spw-cadence-lens": {
    workbench_plan: ~"../_workbench/.agents/plans/editor-inspection-instruments/wip.spw"
    selectors: ["$*[\"levels\"]@spw/runtime", "$^[\"music\"]@spw/ecologies"]
    role: "CodeLens + WebAudio preview rendering root pitch, mode, %swing, and character cadence right from chapter & level blocks."
    status: "proposed"
  }
  "lore-ring-parity": {
    workbench_plan: ~"../_workbench/.agents/plans/citation-navigation/wip.spw"
    selectors: ["$^[\"grammar\"]@spw/ecologies", "$&[\"ecologies\"]@spw/ecologies"]
    role: "Verify Ring 1 (01..13) <-> Ring 2 (14..26) construct symmetry, octave twin citations, and unkept Thursday invariants."
    status: "proposed"
  }
  "lore-valence-atlas": {
    workbench_plan: ~"../_workbench/.agents/plans/vscode-workspace-atlas/wip.spw"
    selectors: ["$=[\"walk\"]@spw/surfaces/joinery.spw", "$=[\"valence_edges\"]@spw/ecologies"]
    role: "Interactive tree and LSP hover projecting signed =boon / =bane / =bone edges across story, ecology, and acoustics."
    status: "proposed"
  }
]
