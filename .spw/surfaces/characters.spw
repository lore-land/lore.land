# Lore.Land characters (generated by .spw/tools/characters-canon.mjs from book/scripts/modules/characters.mjs; re-run, do not edit)
# Everyone in the book, each as who they are in Spw, where the book first has them, and where to meet them.
# Portraits: portraitSVG() in characters.mjs; standalone SVGs in book/content/world/characters.json.
#>lore_land_surfaces_characters
#:surface #!canon
#:layer #!pragmatics
#:status #!live

~<rationale>{
  A character is the same everywhere: on a card, in a notice, on the cast, on a print, on another site. One registry, one portrait style, and one spell for who they are, so meeting someone anywhere is meeting the same someone. A character not yet met is a silhouette with a hint of where to meet them.
}

^characters[
  @boof{ .type[character] .first[chapter_1] $berry #name["Boof"] &card[boof] #where["/characters/boof.html"] #line["A working dog. Works for the land wherever the fences stand, and trusts an honest scent before a name."] }
  @ants{ .type[character] .first[chapter_1] $steam #name["The torch-ants"] &card[ants] #where["/world/boonberry-commons.html#ant-hearths"] #line["Keep lit streets along the berry roots all winter. Businesslike; very particular about torches."] }
  @genie{ .type[character] .first[chapter_3] $glass #name["The Genie, off-season"] &card[carrier-genie] #where["/book/chapter/03/"] #line["Could grant anything except a want as small as Boof’s. Paid for hers with everything he had left, and one Thursday."] }
  @bane{ .type[character] .first[chapter_4] $ink #name["Mr. BaneWAP"] &card[bane] #where["/book/chapter/04/"] #line["A pie made of baneberries. What he announces comes true the bad way, because he said it; he keeps an off switch in every scheme."] }
  @boon{ .type[character] .first[chapter_6] $flour #name["Mr. BoonWAP"] &card[boon] #where["/book/chapter/06/"] #line["A warm pie who holds court in Bonk City, serves himself in slices, and is never smaller."] }
  @bonewap{ .type[character] .first[chapter_10] $oak #name["BoneWAP"] &card[bonewap] #where["/book/chapter/10/"] #line["A pie with its joints showing: no sugar it has not declared. Taps the sill beam and lets the timber answer."] }
  @porter{ .type[character] .first[chapter_15] $oak #name["The porter"] &card[carrier-porter] #where["/book/chapter/15/"] #line["Keeps the parcel gate, hung for three porters and kept by one. Held it in a storm for a stranger."] }
  @clerk{ .type[character] .first[chapter_15] $ink #name["A feast clerk"] &card[carrier-clerk] #where["/book/chapter/15/"] #line["Keeps the DAMAGE slips for the Feast of the Uneven Slice: a word at the top, a line for the cause."] }
  @figure{ .type[character] .first[chapter_14] $ink #name["The figure in plain lines"] &card[carrier-figure] #where["/book/chapter/14/"] #line["One circle, one rectangle, four lines, two dots. Nobody has said who. The hat rests above, and never lands."] }
  @clown{ .type[character] .first[the_lanes] $flour #name["A clown"] &card[clown] #where["/pie/"] #line["Clowns love WAP: Bonk City’s word for a pie in the face. The pie on the plate is never smaller for it."] }
  @mime{ .type[character] .first[the_lanes] $glass #name["A mime"] &card[mime] #where["/pie/"] #line["Silent, white-gloved, palms flat on a wall that is not there. Gathers baneberries for Mr. BaneWAP, in pantomime."] }
]
