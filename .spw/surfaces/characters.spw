# Lore.Land characters (generated by .spw/tools/characters-canon.mjs from book/scripts/modules/characters.mjs; re-run, do not edit)
# Everyone in the book, each as who they are in Spw, where the book first has them, and where to meet them.
# Portraits: portraitSVG() in characters.mjs; standalone SVGs in book/content/world/characters.json.
#>lore_land_surfaces_characters
#:surface #!canon
#:layer #!pragmatics
#:status #!live

~<rationale>{
  A character is the same everywhere: on a card, in a notice, on the cast, on a print, on another site. One registry, one portrait style, and one spell for who they are, so meeting someone anywhere is meeting the same someone. A character not yet met is a silhouette with a hint of where to meet them.
}

^characters[
  @boof{ .type[character] .first[chapter_1] $berry #name["Boof"] &card[boof] #where["/characters/boof.html"] #line["A working dog. Works for the land wherever the fences stand, and trusts an honest scent before a name."] #traits["nose first, works for the land, patient"] #temperament["Unhurried until she is not; trusts a scent before a name."] ?want["To finish the rounds with nothing unaccounted for."] .limit["Cannot read, and will not be told what a smell means."] ~escape["She crosses your lanes on her own business. For a moment you are someone a dog has no opinion about."] #reason["The book needed a witness with no stake in being believed. A working dog notices and does not interpret, so the reader gets to."] }
  @ants{ .type[character] .first[chapter_1] $steam #name["The torch-ants"] &card[ants] #where["/world/boonberry-commons.html#ant-hearths"] #line["Keep lit streets along the berry roots all winter. Businesslike; very particular about torches."] #traits["businesslike, particular, many"] #temperament["Keep the lights on; a detour is just a street nobody has lit yet."] ?want["The street lit by evening."] .limit["Will not go anywhere unlit."] ~escape["While they walk with you the way is lit, and it is somebody else’s job."] #reason["A wish this large needs something small that goes on working around it. The ants keep the book’s scale honest."] }
  @genie{ .type[character] .first[chapter_3] $glass #name["The Genie, off-season"] &card[carrier-genie] #where["/book/chapter/03/"] #line["Could grant anything except a want as small as Boof’s. Paid for hers with everything he had left, and one Thursday."] #traits["glides, off-season, generous to a fault"] #temperament["Settles a pie the way he settles a price."] #knack["True after a WAP: each clown satisfied, the needle points true for two seconds."] ?want["To close the practice with the books even."] .limit["Cannot read a want as small as hers, and cannot stop pricing."] ~escape["For a carry you are unhurried and very good at your job."] #reason["Wish stories usually take the genie for granted. This one keeps asking who pays for a granted thing."] }
  @bane{ .type[character] .first[chapter_4] $ink #name["Mr. BaneWAP"] &card[bane] #where["/book/chapter/04/"] #line["A pie made of baneberries. What he announces comes true the bad way, because he said it; he keeps an off switch in every scheme."] #traits["announces, self-fulfilling, keeps an off switch"] #temperament["Says what will happen, and so it does, the bad way."] ?want["To hold the thing longest."] .limit["What he announces comes true, and he cannot help leaving an off switch."] ~escape["He is the trouble, and the trouble has a switch on it."] #reason["A villain who always leaves an off switch can be foiled by anyone paying attention. The fear has a floor, so it can be played with."] }
  @boon{ .type[character] .first[chapter_6] $flour #name["Mr. BoonWAP"] &card[boon] #where["/book/chapter/06/"] #line["A warm pie who holds court in Bonk City, serves himself in slices, and is never smaller."] #traits["holds court, warm, never smaller"] #temperament["Serves himself in slices and is never the less for it."] ?want["To feed everyone, and be thanked in passing."] .limit["Cannot get smaller, so nothing he gives costs him, and he has never noticed."] ~escape["Near him there is enough. For once nobody is counting."] #reason["Generosity with no cost is a comfort and a problem. He is funny so a reader can enjoy him before asking what it would take to be him."] }
  @bonewap{ .type[character] .first[chapter_10] $oak #name["BoneWAP"] &card[bonewap] #where["/book/chapter/10/"] #line["A pie with its joints showing: no sugar it has not declared. Taps the sill beam and lets the timber answer."] #traits["declared, savoury, listens to timber"] #temperament["No sugar it has not declared; lets the beam answer."] ?want["A frame that holds."] .limit["Will not say what it cannot show."] ~escape["Nothing near it is pretending."] #reason["Between what could be and what it will cost, the book needed someone who asks only what remains. BoneWAP is exact so the other two can be excessive."] }
  @porter{ .type[character] .first[chapter_15] $oak #name["The porter"] &card[carrier-porter] #where["/book/chapter/15/"] #line["Keeps the parcel gate, hung for three porters and kept by one. Held it in a storm for a stranger."] #traits["steady, broad, holds the gate"] #temperament["Steady as a sack of flour, and as quick."] #knack["Long hold: an arrow on the track holds the needle half as long again."] ?want["The gate before the storm."] .limit["One rule kept thirty years, and he has broken it once."] ~escape["For a carry you are the one who does not get moved."] #reason["Book Two asks who gets let in. The porter answers with his shoulder before any record does."] }
  @clerk{ .type[character] .first[chapter_15] $ink #name["A feast clerk"] &card[carrier-clerk] #where["/book/chapter/15/"] #line["Keeps the DAMAGE slips for the Feast of the Uneven Slice: a word at the top, a line for the cause."] #traits["precise, quick, nervous"] #temperament["A word at the top, a line for the cause."] #knack["Quick feet: a wider moment to chain one hop into the next."] ?want["Every slip filed by evening."] .limit["Can write only what fits on the line."] ~escape["For a carry your nerves are your job, and they make you quick."] #reason["Records are comedy and care here. The clerk is anxious so the paperwork can be tender."] }
  @figure{ .type[character] .first[chapter_14] $ink #name["The figure in plain lines"] &card[carrier-figure] #where["/book/chapter/14/"] #line["One circle, one rectangle, four lines, two dots. Nobody has said who. The hat rests above, and never lands."] #traits["plain lines, unnamed, under the hat"] #temperament["Nobody has said who; the hat has an opinion."] #knack["Fine hands: the needle turns a finer notch, steadier with every stroke noticed."] ?want["Nobody has said."] .limit["Four lines, two dots, and a hat that will not land."] ~escape["For a carry nobody knows who you are, and your hands are very fine."] #reason["Nobody in the book has said, and this card will not either."] }
  @clown{ .type[character] .first[the_lanes] $flour #name["A clown"] &card[clown] #where["/pie/"] #line["Clowns love WAP: Bonk City’s word for a pie in the face. The pie on the plate is never smaller for it."] #traits["loves WAP, big feelings, forgiving"] #temperament["A pie in the face is a kindness, done right."] #knack["Big feelings: every impact lands bigger."] ?want["A pie in the face, done right."] .limit["Cannot have a small feeling."] ~escape["For a carry everything lands bigger and nobody minds."] #reason["The clown wants exactly what is about to happen to them, which turns slapstick into a gift. Nobody in the lanes is a victim."] }
  @mime{ .type[character] .first[the_lanes] $glass #name["A mime"] &card[mime] #where["/pie/"] #line["Silent, white-gloved, palms flat on a wall that is not there. Gathers baneberries for Mr. BaneWAP, in pantomime."] #traits["silent, white-gloved, very clear about walls"] #temperament["Says nothing, and is very clear about it."] ?want["Quiet, where the pie words were."] .limit["Cannot say so."] ~escape["Someone else has decided not to explain."] #reason["A contest needs someone who cannot be argued with. The mimes take the words away so a reader feels what a chapter loses without them, and can carry them back."] }
]

^moods{
  marks: "calm · glad · worried · surprised · thinking: drawn as the marks comics use beside a head (strokes, a bead of sweat, a bang, a question), so any portrait can wear any mood; portraitSVG(id, { mood }) and <lore-portrait mood>"
  in_the_lanes: "the carriers faces in Exactly One Pie follow the carry: calm, focused on the needle, glad after a WAP, worried as the pie tilts, ouch at a knock"
}
