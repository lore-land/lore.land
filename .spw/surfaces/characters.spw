# Lore.Land characters (generated by .spw/tools/characters-canon.mjs from book/scripts/modules/characters.mjs; re-run, do not edit)
# Everyone in the book, each as who they are in Spw, where the book first has them, and where to meet them.
# Portraits: portraitSVG() in characters.mjs; standalone SVGs in book/content/world/characters.json.
#>lore_land_surfaces_characters
#:surface #!canon
#:layer #!pragmatics
#:status #!live

~<rationale>{
  A character is the same everywhere: on a card, in a notice, on the cast, on a print, on another site. One registry, one portrait style, and one spell for who they are, so meeting someone anywhere is meeting the same someone. A character not yet met is a silhouette with a hint of where to meet them.
}

^characters[
  @boof{ .type[character] .first[chapter_1] $berry #name["Boof"] &card[boof] #where["/characters/boof.html"] #line["A working dog. Works for the land wherever the fences stand, and trusts an honest scent before a name."] #traits["nose first, works for the land, patient"] #temperament["Unhurried until she is not; trusts a scent before a name."] ?want["To finish the rounds with nothing unaccounted for."] .limit["Cannot read, and will not be told what a smell means."] ~escape["She crosses your lanes on her own business. For a moment you are someone a dog has no opinion about."] #reason["The book needed a witness with no stake in being believed. A working dog notices and does not interpret, so the reader gets to."] %carries["The rounds: every fence line, every morning, nothing unaccounted for."] &hands_on["Never all of it. She works for the land, and the land does the keeping."] ~eased["Her wish, when she knows it, is small: one warm furrow kept open for whatever arrives next without a receipt."] #ground["Chapter 12, the logline; Chapter 14, a dog keeps mornings, not weeks"] }
  @ants{ .type[character] .first[chapter_1] $steam #name["The torch-ants"] &card[ants] #where["/world/boonberry-commons.html#ant-hearths"] #line["Keep lit streets along the berry roots all winter. Businesslike; very particular about torches."] #traits["businesslike, particular, many"] #temperament["Keep the lights on; a detour is just a street nobody has lit yet."] ?want["The street lit by evening."] .limit["Will not go anywhere unlit."] ~escape["While they walk with you the way is lit, and it is somebody else’s job."] #reason["A wish this large needs something small that goes on working around it. The ants keep the book’s scale honest."] %carries["The light, street by street, all winter."] &hands_on["Torch to torch: no ant holds a street alone, and a detour is a street nobody has lit yet."] ~eased["Lines that run straight on a day nobody else keeps."] #ground["Chapter 14, the torch-lines running straight; Chapter 1, the ant hearths"] }
  @genie{ .type[character] .first[chapter_3] $glass #name["The Genie, off-season"] &card[carrier-genie] #where["/book/chapter/03/"] #line["Could grant anything except a want as small as Boof’s. Paid for hers with everything he had left, and one Thursday."] #traits["glides, off-season, generous to a fault"] #temperament["Settles a pie the way he settles a price."] #knack["True after a WAP: each clown satisfied, the needle points true for two seconds."] ?want["To close the practice with the books even."] .limit["Cannot read a want as small as hers, and cannot stop pricing."] ~escape["For a carry you are unhurried and very good at your job."] #reason["Wish stories usually take the genie for granted. This one keeps asking who pays for a granted thing."] %carries["The price of every granted thing, worked out to the coincidence."] &hands_on["He paid for hers himself: everything he had left, and one Thursday."] ~eased["The week forgets his Thursday, but a dog keeps mornings, not weeks, and the field keeps everything."] #ground["Chapter 5, the slate and the weight; Chapter 14, the opening"] }
  @bane{ .type[character] .first[chapter_4] $ink #name["Mr. BaneWAP"] &card[bane] #where["/book/chapter/04/"] #line["A pie made of baneberries. What he announces comes true the bad way, because he said it; he keeps an off switch in every scheme."] #traits["announces, self-fulfilling, keeps an off switch"] #temperament["Says what will happen, and so it does, the bad way."] ?want["To hold the thing longest."] .limit["What he announces comes true, and he cannot help leaving an off switch."] ~escape["He is the trouble, and the trouble has a switch on it."] #reason["A villain who always leaves an off switch can be foiled by anyone paying attention. The fear has a floor, so it can be played with."] %carries["He offers to. He proposed the wish be sold to someone prepared to bear its responsibilities, and supplied his own name."] &hands_on["Not willingly; it has to be foiled out of his hands, and he always leaves the switch."] ~eased["Splitting himself as an apology, and being received warm."] #ground["Chapter 4, the council; Chapter 12, re-sweetened"] }
  @boon{ .type[character] .first[chapter_6] $flour #name["Mr. BoonWAP"] &card[boon] #where["/book/chapter/06/"] #line["A warm pie who holds court in Bonk City, serves himself in slices, and is never smaller."] #traits["holds court, warm, never smaller"] #temperament["Serves himself in slices and is never the less for it."] ?want["To feed everyone, and be thanked in passing."] .limit["Cannot get smaller, so nothing he gives costs him, and he has never noticed."] ~escape["Near him there is enough. For once nobody is counting."] #reason["Generosity with no cost is a comfort and a problem. He is funny so a reader can enjoy him before asking what it would take to be him."] %carries["Everyone’s supper, and he never feels it."] &hands_on["In slices, to anyone, and he is never smaller for it."] ~eased["Nothing needs easing, which is his limit: giving is not subtraction if the filling is true, and he has never had to ask what it costs anyone else."] #ground["Chapter 6; Chapter 12, receiving BaneWAP"] }
  @bonewap{ .type[character] .first[chapter_10] $oak #name["BoneWAP"] &card[bonewap] #where["/book/chapter/10/"] #line["A pie with its joints showing: no sugar it has not declared. Taps the sill beam and lets the timber answer."] #traits["declared, savoury, listens to timber"] #temperament["No sugar it has not declared; lets the beam answer."] ?want["A frame that holds."] .limit["Will not say what it cannot show."] ~escape["Nothing near it is pretending."] #reason["Between what could be and what it will cost, the book needed someone who asks only what remains. BoneWAP is exact so the other two can be excessive."] %carries["Only what the frame will bear, declared."] &hands_on["Posts the receipt, so the weight is written where everyone can see it."] ~eased["A beam that answers when tapped."] #ground["Chapter 10, set the wish on the frame; Chapter 12, both receipts"] }
  @porter{ .type[character] .first[chapter_15] $oak #name["The porter"] &card[carrier-porter] #where["/book/chapter/15/"] #line["Keeps the parcel gate, hung for three porters and kept by one. Held it in a storm for a stranger."] #traits["steady, broad, holds the gate"] #temperament["Steady as a sack of flour, and as quick."] #knack["Long hold: an arrow on the track holds the needle half as long again."] ?want["The gate before the storm."] .limit["One rule kept thirty years, and he has broken it once."] ~escape["For a carry you are the one who does not get moved."] #reason["Book Two asks who gets let in. The porter answers with his shoulder before any record does."] %carries["A gate hung for three porters and kept by one."] &hands_on["Into the wall: the storm-weight, an iron counterweight, does what two more porters would."] ~eased["Holding it for a stranger, and signing for the spoiled flour in his own name."] #ground["Chapter 15, the parcel gate"] }
  @clerk{ .type[character] .first[chapter_15] $ink #name["A feast clerk"] &card[carrier-clerk] #where["/book/chapter/15/"] #line["Keeps the DAMAGE slips for the Feast of the Uneven Slice: a word at the top, a line for the cause."] #traits["precise, quick, nervous"] #temperament["A word at the top, a line for the cause."] #knack["Quick feet: a wider moment to chain one hop into the next."] ?want["Every slip filed by evening."] .limit["Can write only what fits on the line."] ~escape["For a carry your nerves are your job, and they make you quick."] #reason["Records are comedy and care here. The clerk is anxious so the paperwork can be tender."] %carries["Every slip, filed by evening."] &hands_on["A line for the cause: the slip carries the knock so nobody has to remember it."] ~eased["A word at the top, and the line filled."] #ground["Chapter 15, the DAMAGE slips"] }
  @figure{ .type[character] .first[chapter_14] $ink #name["The figure in plain lines"] &card[carrier-figure] #where["/book/chapter/14/"] #line["One circle, one rectangle, four lines, two dots. Nobody has said who. The hat rests above, and never lands."] #traits["plain lines, unnamed, under the hat"] #temperament["Nobody has said who; the hat has an opinion."] #knack["Fine hands: the needle turns a finer notch, steadier with every stroke noticed."] ?want["Nobody has said."] .limit["Four lines, two dots, and a hat that will not land."] ~escape["For a carry nobody knows who you are, and your hands are very fine."] #reason["Nobody in the book has said, and this card will not either."] %carries["Nobody has said."] &hands_on["Nobody has said."] ~eased["Nobody has said."] #ground["Chapters 14 and 15"] }
  @clown{ .type[character] .first[the_lanes] $flour #name["A clown"] &card[clown] #where["/pie/"] #line["Clowns love WAP: Bonk City’s word for a pie in the face. The pie on the plate is never smaller for it."] #traits["loves WAP, big feelings, forgiving"] #temperament["A pie in the face is a kindness, done right."] #knack["Big feelings: every impact lands bigger."] ?want["A pie in the face, done right."] .limit["Cannot have a small feeling."] ~escape["For a carry everything lands bigger and nobody minds."] #reason["The clown wants exactly what is about to happen to them, which turns slapstick into a gift. Nobody in the lanes is a victim."] %carries["A feeling bigger than the moment."] &hands_on["Straight back, as delight: a pie in the face, done right, is a kindness."] ~eased["Nobody minds how big it lands."] #ground["The lanes"] }
  @mime{ .type[character] .first[the_lanes] $glass #name["A mime"] &card[mime] #where["/pie/"] #line["Silent, white-gloved, palms flat on a wall that is not there. Gathers baneberries for Mr. BaneWAP, in pantomime."] #traits["silent, white-gloved, very clear about walls"] #temperament["Says nothing, and is very clear about it."] ?want["Quiet, where the pie words were."] .limit["Cannot say so."] ~escape["Someone else has decided not to explain."] #reason["A contest needs someone who cannot be argued with. The mimes take the words away so a reader feels what a chapter loses without them, and can carry them back."] %carries["The words a chapter loses."] &hands_on["Only to someone who carries them back."] ~eased["A slice over their heads, very clearly."] #ground["The lanes"] }
]

^moods{
  marks: "calm · glad · worried · surprised · thinking: worn on the face, and drawn as the marks comics use beside a head (strokes, a bead of sweat, a bang, a question), so any portrait can wear any mood; the figure in plain lines has only the marks; portraitSVG(id, { mood }) and <lore-portrait mood>"
  in_the_lanes: "the carriers faces in Exactly One Pie follow the carry: calm, focused on the needle, glad after a WAP, worried as the pie tilts, ouch at a knock"
}
