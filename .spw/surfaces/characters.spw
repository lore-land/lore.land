# Lore.Land characters (generated by .spw/tools/characters-canon.mjs from book/scripts/modules/characters.mjs; re-run, do not edit)
# Everyone in the book, each as who they are in Spw, where the book first has them, and where to meet them.
# Portraits: portraitSVG() in characters.mjs; standalone SVGs in book/content/world/characters.json.
#>lore_land_surfaces_characters
#:surface #!canon
#:layer #!pragmatics
#:status #!live

~<rationale>{
  A character is the same everywhere: on a card, in a notice, on the cast, on a print, on another site. One registry, one portrait style, and one spell for who they are, so meeting someone anywhere is meeting the same someone. A character not yet met is a silhouette with a hint of where to meet them.
}

^characters[
  @boof{ .type[character] .first[chapter_1] $berry #name["Boof"] &card[boof] #where["/characters/boof.html"] #line["A working dog. Works for the land wherever the fences stand, and trusts an honest scent before a name."] #traits["nose first, works for the land, patient"] #temperament["Unhurried until she is not; trusts a scent before a name."] }
  @ants{ .type[character] .first[chapter_1] $steam #name["The torch-ants"] &card[ants] #where["/world/boonberry-commons.html#ant-hearths"] #line["Keep lit streets along the berry roots all winter. Businesslike; very particular about torches."] #traits["businesslike, particular, many"] #temperament["Keep the lights on; a detour is just a street nobody has lit yet."] }
  @genie{ .type[character] .first[chapter_3] $glass #name["The Genie, off-season"] &card[carrier-genie] #where["/book/chapter/03/"] #line["Could grant anything except a want as small as Boof’s. Paid for hers with everything he had left, and one Thursday."] #traits["glides, off-season, generous to a fault"] #temperament["Settles a pie the way he settles a price."] #knack["True after a WAP: each clown satisfied, the needle points true for two seconds."] }
  @bane{ .type[character] .first[chapter_4] $ink #name["Mr. BaneWAP"] &card[bane] #where["/book/chapter/04/"] #line["A pie made of baneberries. What he announces comes true the bad way, because he said it; he keeps an off switch in every scheme."] #traits["announces, self-fulfilling, keeps an off switch"] #temperament["Says what will happen, and so it does, the bad way."] }
  @boon{ .type[character] .first[chapter_6] $flour #name["Mr. BoonWAP"] &card[boon] #where["/book/chapter/06/"] #line["A warm pie who holds court in Bonk City, serves himself in slices, and is never smaller."] #traits["holds court, warm, never smaller"] #temperament["Serves himself in slices and is never the less for it."] }
  @bonewap{ .type[character] .first[chapter_10] $oak #name["BoneWAP"] &card[bonewap] #where["/book/chapter/10/"] #line["A pie with its joints showing: no sugar it has not declared. Taps the sill beam and lets the timber answer."] #traits["declared, savoury, listens to timber"] #temperament["No sugar it has not declared; lets the beam answer."] }
  @porter{ .type[character] .first[chapter_15] $oak #name["The porter"] &card[carrier-porter] #where["/book/chapter/15/"] #line["Keeps the parcel gate, hung for three porters and kept by one. Held it in a storm for a stranger."] #traits["steady, broad, holds the gate"] #temperament["Steady as a sack of flour, and as quick."] #knack["Long hold: an arrow on the track holds the needle half as long again."] }
  @clerk{ .type[character] .first[chapter_15] $ink #name["A feast clerk"] &card[carrier-clerk] #where["/book/chapter/15/"] #line["Keeps the DAMAGE slips for the Feast of the Uneven Slice: a word at the top, a line for the cause."] #traits["precise, quick, nervous"] #temperament["A word at the top, a line for the cause."] #knack["Quick feet: a wider moment to chain one hop into the next."] }
  @figure{ .type[character] .first[chapter_14] $ink #name["The figure in plain lines"] &card[carrier-figure] #where["/book/chapter/14/"] #line["One circle, one rectangle, four lines, two dots. Nobody has said who. The hat rests above, and never lands."] #traits["plain lines, unnamed, under the hat"] #temperament["Nobody has said who; the hat has an opinion."] #knack["Fine hands: the needle turns a finer notch, steadier with every stroke noticed."] }
  @clown{ .type[character] .first[the_lanes] $flour #name["A clown"] &card[clown] #where["/pie/"] #line["Clowns love WAP: Bonk City’s word for a pie in the face. The pie on the plate is never smaller for it."] #traits["loves WAP, big feelings, forgiving"] #temperament["A pie in the face is a kindness, done right."] #knack["Big feelings: every impact lands bigger."] }
  @mime{ .type[character] .first[the_lanes] $glass #name["A mime"] &card[mime] #where["/pie/"] #line["Silent, white-gloved, palms flat on a wall that is not there. Gathers baneberries for Mr. BaneWAP, in pantomime."] #traits["silent, white-gloved, very clear about walls"] #temperament["Says nothing, and is very clear about it."] }
]

^moods{
  marks: "calm · glad · worried · surprised · thinking: drawn as the marks comics use beside a head (strokes, a bead of sweat, a bang, a question), so any portrait can wear any mood; portraitSVG(id, { mood }) and <lore-portrait mood>"
  in_the_lanes: "the carriers faces in Exactly One Pie follow the carry: calm, focused on the needle, glad after a WAP, worried as the pie tilts, ouch at a knock"
}
