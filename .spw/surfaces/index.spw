# Lore.Land Surfaces Registry
#>lore_land_surfaces_index
#:registry #!surfaces
#:layer #!pragmatics

^"roots"{
  @spw: ~".."
  @surfaces: ~"."
  @audits: ~"../audits"
  @runtime: ~"../runtime"
  @claims: ~"../claims"
  @state: ~"../state"
}

^"surfaces"{
  &publish: ~"./publish.spw"
  &plugin_protocol: ~"./plugin-protocol.spw"
  &domains: ~"./domains.spw"
  &editorial: ~"./editorial.spw"
  &platform: ~"./platform.spw"
  &atelier: ~"./atelier.spw"
  &plates: ~"./plates.spw"
  &dragon_egg: ~"./dragon-egg.spw"
  &wonder_about_pie: ~"./wonder-about-pie.spw"
  &tropes: ~"./tropes.spw"
  &ecology: ~"./ecology.spw"
  &texture_website: ~"./texture-website.spw"
  &spw_proposals: ~"./spw-proposals.spw"
  &almanac: ~"./almanac.spw"
  &knobs: ~"./knobs.spw"
  &cullet_deck: ~"./cullet-deck.spw"
  &affordances: ~"./affordances.spw"
  &autonomous_feedback: ~"./autonomous-feedback.spw"
  &berries: ~"./berries.spw"
  &characters: ~"./characters.spw"
  &reasons: ~"./reasons.spw"
  &collecting: ~"./collecting.spw"
  &enchantment: ~"./enchantment.spw"
  &fold_and_materials: ~"./fold-and-materials.spw"
  &folios: ~"./folios.spw"
  &inoculant: ~"./inoculant.spw"
  &layers: ~"./layers.spw"
  &likeness: ~"./likeness.spw"
  &projection: ~"./projection.spw"
  &resonance: ~"./resonance.spw"
  &rooms: ~"./rooms.spw"
  &sound_and_voice: ~"./sound-and-voice.spw"
  &spw_architecture: ~"./spw-architecture.spw"
  &spw_play: ~"./spw-play.spw"
  &spw_stress: ~"./spw-stress.spw"
  &stories: ~"./stories.spw"
  &tellings_and_bindings: ~"./tellings-and-bindings.spw"
  &site_clusters: ~"./site-clusters.spw"
  &ast_play: ~"./ast-play.spw"
  &cadence: ~"./cadence.spw"
  &cadences: ~"./cadences.spw"
  &classes: ~"./classes.spw"
  &competency: ~"./competency.spw"
  &elaboration: ~"./elaboration.spw"
  &finds: ~"./finds.spw"
  &jokes: ~"./jokes.spw"
  &formulas: ~"./formulas.spw"
  &genie_practice: ~"./genie-practice.spw"
  &gossip_and_kitchens: ~"./gossip-and-kitchens.spw"
  &gradients: ~"./gradients.spw"
  &inventions: ~"./inventions.spw"
  &liminal_physics: ~"./liminal-physics.spw"
  &panel_art: ~"./panel-art.spw"
  &places_in_the_lanes: ~"./places-in-the-lanes.spw"
  &prompts: ~"./prompts.spw"
  &reactions_in_the_lanes: ~"./reactions-in-the-lanes.spw"
  &realm_powers: ~"./realm-powers.spw"
  &scored: ~"./scored.spw"
  &seasons: ~"./seasons.spw"
  &shelves: ~"./shelves.spw"
  &texture_finds: ~"./texture-finds.spw"
  &three_lands: ~"./three-lands.spw"
}

^"audits"{
  &platform_ship: ~"../audits/platform-ship-audit-2026-07-16.spw"
  &alignment_probes: ~"../audits/alignment-probes-2026-11-09.spw"  # rerunnable: npm run spw:probes
  &dregg_release_cache: ~"../audits/dregg-release-cache-2026-09-26.spw"  # snapshot; reread 2026-10-13
}

^"output_formats"{
  html: { mime: "text/html", extension: ".html", use_case: "chapter and home reading surfaces" }
  markdown: { mime: "text/markdown", extension: ".md", use_case: "long-form reference exports" }
  json: { mime: "application/json", extension: ".json", use_case: "selector and metrics sidecars" }
  rss: { mime: "application/rss+xml", extension: ".xml", use_case: "chapter progression feed" }
  webmanifest: { mime: "application/manifest+json", extension: ".webmanifest", use_case: "PWA install surface" }
  sitemap: { mime: "application/xml", extension: ".xml", use_case: "discoverability of monument doors + chapters" }
  plate: { mime: "image/png", extension: ".png", use_case: "share intrigue art + material studies ({name}-v{N} until graduated)" }
  capture: { mime: "video/webm", extension: ".webm", use_case: "signature-moment motion captures incl. reduced-motion cut" }
}

^"pipeline_stages"[
  select:    { input: "selector",           output: "matched frames" }
  transform: { input: "frames",             output: "rendered artifacts" }
  validate:  { input: "artifacts",          output: "validated artifacts" }
  emit:      { input: "validated artifacts", output: "publish targets" }
]

^"lifecycle_stage_aliases"{
  boon: "select"
  bone: "transform"
  bonk: "validate"
  honk: "emit"
  bane: "fallback"
}

^"ship_gates"{
  .note: "validate stage checks for public monument — see platform.spw seal checklist"
  validate_checks: [
    "no-broken-internal-routes",
    "sw-precache-urls-exist",
    "vite-emits-public-doors",
    "og-image-nonblank",
    "chapter-spw-title-matches-json",
    "release-token-consistent",
    "no-undeclared-misalignment-on-changed-surfaces"
  ]
}
