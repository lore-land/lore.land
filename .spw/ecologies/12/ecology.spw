# Chapter 12 Ecology — One Furrow Kept Open
# Composed by .spw/tools/ecology-compose.mjs (npm run spw:ecology) from the chapter JSON, likeness, almanac, pie levels
# and the plates manifest. ^"biome" and ^"craft" are authored and kept; every other block is measured and rewritten.
#>chapter_12_ecology
#:ecology #!book-1
#:layer #!pragmatics
#:status #!live

~<rationale>{
  Chapter 12 measured from its canon. Ring 12 of 13, {} body: containment, state accumulation, and release. Its rooms can be read as the stations of one line, in order; its twin an octave away is Chapter 25.
}

^"identity"{
  chapter: 12
  book: 1
  ring: 12
  title: "One Furrow Kept Open"
  mood: "path"
  period: "spring"
  logline: "Boof finally knows her wish, and it is small: one warm furrow kept open, always, for whatever arrives next without a receipt."
  epigraph: "The honest price of a small true wish: everything he had left, plus one Thursday."
}

^"grammar"{
  construct: "{}"
  construct_name: "body"
  construct_kind: "container"
  opening_lens: "enclosed chamber gathering full semantic mass"
  closing_perspective: "discharges upward into integration (^)"
  represents: "Containment, state accumulation, and release"
  next_construct: "^ (integration)"
  observed_open_room: "*{plank_bridge}@boof"
  observed_close_room: "~<moon_lane>@boof"
  sigils_present: "* ^ ~ &"
  sigils_absent: "# . ? ! @ = % $"
}

^"biome"{
  terrain: "converging timber ferry bridge spanning tidal mist between groves"
  metabolite: "sweetened baneberry pulp, warm river steam, and pinned iron ferrule oil"
  symbiotes: "seam-otters stitching waterlines, ink-herons wading reeds, ferrymen ringing crossing bells"
  irritant: "a bridge receipt stamped twice while one furrow on the far bank deliberately stays unplanted"
  circulation: "two springs meet under the deck so bitter and sweet currents swirl without canceling"
}

^"craft"{
  modulators: { config: "path (confluence)" measure: "%echoes[14]" substrate: "$wet_timber_and_ferry_iron" }
  compost: "fourteen echoes braided here plus the explicitly open warm furrow for ch14 arrival"
  !watch: "high permeability (14 echoes); ends on ~<moon_lane> leading to final Book 1 door"
  mode: "Dorian polyrhythm"
  tonal_role: "V/V supertonic E4 braiding two rivers across 3+3+2"
}

^"stations"[
  s01: { title: "The plank bridge" .spw: "*{plank_bridge}@boof" container: "room" $material: "ink" =lean: "boon" %words: 449 %sentences: 32 %paragraphs: 8 }
  s02: { title: "The far furrow" .spw: "^<far_furrow>@the_land" container: "passage" $material: "steam" =lean: "boon" %words: 163 %sentences: 12 %paragraphs: 3 }
  s03: { title: "The upstream grove" .spw: "~<upstream_grove>@genie" container: "passage" $material: "brass" =lean: "" %words: 83 %sentences: 4 %paragraphs: 2 }
  s04: { title: "Both Receipts Posted" .spw: "&(bridge_deck)@boof" container: "gathering" $material: "flour" =lean: "bane" %words: 686 %sentences: 41 %paragraphs: 13 }
  s05: { title: "The moon lane" .spw: "~<moon_lane>@boof" container: "passage" $material: "flour" =lean: "bone" %words: 135 %sentences: 14 %paragraphs: 3 }
]

