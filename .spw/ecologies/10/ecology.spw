  observed_close_room: "~<rear_archway>@boof"
  sigils_present: ". ? ! ^ ~"
  sigils_absent: "# * & @ = % $"
}

^"biome"{
  terrain: "exposed oak truss hall rooted atop dry chalk strata"
  metabolite: "seasoned timber creak, chalk mark powder, and tapped mallet echoes"
  symbiotes: "load-beetles testing mortises, BoneWAP munching savory lunches, joiners with mallets"
  irritant: "ornament pretending to bear weight when tapped with a mallet"
  circulation: "every beam transfers stress aloud across joints until the weakest chalk mark flakes off"
}

