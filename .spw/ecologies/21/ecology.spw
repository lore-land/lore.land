#>chapter_21_ecology
#:ecology #!book-2
#:layer #!pragmatics
#:status #!live

~<rationale>{
  Chapter 21 measured from its canon. Ring 8 of 13, @ perspective: standpoint and observer-relative truth. Its rooms can be read as the stations of one line, in order; its twin an octave away is Chapter 8.
}

^"identity"{
  chapter: 21
  book: 2
  ring: 8
  title: "At the Nose of the Work"
  mood: "path"
  period: "winter"
  logline: "Read strictly from fourteen inches off the cobblestones, Bonk City's dropped berry crumbs, boot polish, and grate steam tell the whole civic plot tall tables hide."
  epigraph: "Above the cloth they debate who leads the feast; below it, every crumb already points to the ovens."
}

^"grammar"{
  construct: "@"
  construct_name: "perspective"
  construct_kind: "operator"
  opening_lens: "observer shift—through a beast, mirror, well, or hat"
  closing_perspective: "opens a directional crossing (<>)"
  represents: "Standpoint and observer-relative truth"
  next_construct: "<> (capsule)"
  observed_open_room: "@{cobble_level}@boof"
  observed_close_room: ".{drain_steam}@boof"
  sigils_present: "@ & ."
  sigils_absent: "~ # ? ! * ^ = % $"
}

^"biome"{
  terrain: "low-angle cobblestone run seen exclusively from fourteen inches off the paving slabs"
  metabolite: "shoe leather polish, dropped berry crumbs, drain grate steam, and dog-ear breeze"
  symbiotes: "Boof trailing three scents at once, street ants routing around giant boots, puddles reading sky"
  irritant: "tall tables hiding both faces and intentions while lower crumbs tell the whole political plot"
  circulation: "scent plumes hug warm drains and reveal where clerks hurried before bells rang"
}

^"craft"{
  modulators: { config: "perspective (animal empiricism)" measure: "%scent_trails[3]" substrate: "$cobble_damp_and_tallow" }
  compost: "grounds Ch08 observer inversion in embodied dog-height phenomenology"
  !watch: "Ring 2 Slot 8 (@): keep children absent from civic alleys; Boof stays literal, never coy"
  mode: "Mixolydian reflection"
  tonal_role: "mirrored subtonic C4 echoing depths from the well (transposed into Book Two's C-axis continuation)"
}

^"stations"[
  s01: { title: "The cobble level" .spw: "@{cobble_level}@boof" container: "room" $material: "steam" =lean: "boon" %words: 133 %sentences: 6 %paragraphs: 3 }
  s02: { title: "The three scents" .spw: "&[three_scents]@boof" container: "window" $material: "flour" =lean: "boon" %words: 164 %sentences: 8 %paragraphs: 3 }
  s03: { title: "Under the Tall Tables" .spw: "@(under_table)@the_land" container: "gathering" $material: "ink" =lean: "boon" %words: 139 %sentences: 8 %paragraphs: 3 }
  s04: { title: "The drain steam" .spw: ".{drain_steam}@boof" container: "room" $material: "flour" =lean: "bone" %words: 83 %sentences: 4 %paragraphs: 2 }
]

