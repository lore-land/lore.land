#>chapter_13_ecology
#:ecology #!book-1
#:layer #!pragmatics
#:status #!live

~<rationale>{
  Chapter 13 measured from its canon. Ring 13 of 13, ^ integration: summary, emission, and octave recursion. Its rooms can be read as the stations of one line, in order; its twin an octave away is Chapter 26.
}

^"identity"{
  chapter: 13
  book: 1
  ring: 13
  title: "The Shell-Shaped Door"
  mood: "reflection"
  period: "spring"
  logline: "The spent wish sounds as the ninth honk; the maps take the ink at last, and the empty shell waits beside a blank last line — for the next wish, and for whoever is coming to make it."
  epigraph: "Every trope you sample must be returned changed, with interest."
}

^"grammar"{
  construct: "^"
  construct_name: "integration"
  construct_kind: "integration"
  opening_lens: "capstone bind gathering the twelve preceding steps"
  closing_perspective: "hinges into the next ring (~)"
  represents: "Summary, emission, and octave recursion"
  next_construct: "~ (potential)"
  observed_open_room: "!{round_archive}@the_land"
  observed_close_room: "!<shell_door>@boof"
  sigils_present: "! # . ~"
  sigils_absent: "? * & @ ^ = % $"
}

^"biome"{
  terrain: "curved starlight archive capped by a shell-shaped calcium door"
  metabolite: "pressed linen oil, shell lime powder, and drying black ink across stacked plates"
  symbiotes: "shelf-owls reading over shoulders, pressing screws, Boof spotting a hat down the road"
  irritant: "the impulse to close a book neatly instead of leaving one brace unlatched for return"
  circulation: "every thread in chapters 01..12 folds through the spiral lintel and warms the outer threshold"
}

^"craft"{
  modulators: { config: "reflection (capstone)" measure: "%echoes[21]" substrate: "$shell_lime_and_linen_ink" }
  compost: "21 echoes + an unclosed shell brace opening directly onto Ch14 without losing prior warmth"
  !watch: "Ring 1 hinge (13 ^): strong visual closure, though rooms end on !<shell_door> instead of ^{...}"
  mode: "Ionian tonic cadence"
  tonal_role: "authentic octave return to D4 preparing the Book Two step-down"
}

^"stations"[
  s01: { title: "The round archive" .spw: "!{round_archive}@the_land" container: "room" $material: "ink" =lean: "bone" %words: 793 %sentences: 53 %paragraphs: 19 }
  s02: { title: "The great book" .spw: "#[great_book]@the_book" container: "window" $material: "ink" =lean: "bone" %words: 119 %sentences: 15 %paragraphs: 4 }
