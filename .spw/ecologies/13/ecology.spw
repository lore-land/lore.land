  s04: { title: "The Blank Last Line" .spw: "~{last_line}@boof" container: "room" $material: "ink" =lean: "bone" %words: 332 %sentences: 28 %paragraphs: 5 }
  s05: { title: "The shell door" .spw: "!<shell_door>@boof" container: "passage" $material: "steam" =lean: "boon" %words: 230 %sentences: 25 %paragraphs: 7 }
]

