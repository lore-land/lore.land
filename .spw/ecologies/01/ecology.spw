# Chapter 01 Ecology — Dawn in Boon.land
# Composed by .spw/tools/ecology-compose.mjs (npm run spw:ecology) from the chapter JSON, likeness, almanac, pie levels
# and the plates manifest. ^"biome" and ^"craft" are authored and kept; every other block is measured and rewritten.
#>chapter_01_ecology
#:ecology #!book-1
#:layer #!pragmatics
#:status #!live

~<rationale>{
  Chapter 1 measured from its canon. Ring 1 of 13, ~ potential: what waits before being named. Its rooms can be read as the stations of one line, in order; its twin an octave away is Chapter 14.
}

^"identity"{
  chapter: 1
  book: 1
  ring: 1
  title: "Dawn in Boon.land"
  mood: "boon"
  period: "spring"
  logline: "At dawn, Boof digs a warm egg out of a frozen furrow — an unspent wish, humming like a held breath, that every map in Boon.land refuses to write down."
  epigraph: "A wish is not a thing. It is a direction the world has not agreed to turn yet."
}

^"grammar"{
  construct: "~"
  construct_name: "potential"
  construct_kind: "operator"
  opening_lens: "unspent latency without a receipt"
  closing_perspective: "invites an external mark (#)"
  represents: "What waits before being named"
  next_construct: "# (annotation)"
  observed_open_room: "~{warm_furrow}@boof"
  observed_close_room: "&(grove_mouth)@boof"
  sigils_present: "~ . = # ! &"
  sigils_absent: "? * @ ^ % $"
}

^"biome"{
  terrain: "frosted furrow loam beside the map-house threshold and sloe hedge"
  metabolite: "sub-surface ant-warmth and candle-snuff wax meeting morning frost"
  symbiotes: "Boof (nose-first surveyor), torch-ants heating tree roots, leaning berry rows"
  irritant: "uncatalogued egg refusing wet archival ink on map paper"
  circulation: "warmth runs from deep soil through roots to pond to mill wheel"
}

^"craft"{
  modulators: { config: "boon (dawnward hope)" measure: "%heat[unspent]" substrate: "$loam_and_beeswax" }
  compost: "an unspent wish without a receipt that keeps one furrow warm across all books"
  !watch: "balanced entry (~ opening present); closes on &(grove_mouth) before formal echo (#)"
  mode: "Lydian #4"
  tonal_role: "suspended shimmer opening a held wish before it is receipted"
}

^"stations"[
  s01: { title: "The Warm Furrow" .spw: "~{warm_furrow}@boof" container: "room" $material: "steam" =lean: "boon" %words: 584 %sentences: 47 %paragraphs: 13 }
  s02: { title: "The furrow rim" .spw: ".[furrow_rim]@boof" container: "window" $material: "flour" =lean: "boon" %words: 138 %sentences: 11 %paragraphs: 3 }
  s03: { title: "When a Berry Remembers" .spw: "=[berry_row]@the_berries" container: "window" $material: "berry" =lean: "boon" %words: 319 %sentences: 30 %paragraphs: 6 }
  s04: { title: "The Maps That Look Away" .spw: "#{map_house}@the_archivist" container: "room" $material: "ink" =lean: "bone" %words: 469 %sentences: 43 %paragraphs: 13 }
  s05: { title: "Following the Hum" .spw: "!<sloe_hedge>@boof" container: "passage" $material: "berry" =lean: "boon" %words: 207 %sentences: 19 %paragraphs: 5 }
  s06: { title: "The grove mouth" .spw: "&(grove_mouth)@boof" container: "gathering" $material: "berry" =lean: "boon" %words: 177 %sentences: 19 %paragraphs: 6 }
]

