  %tempo: 96
  %swing: 50
  mode: "Lydian #4"
  tonal_role: "suspended shimmer opening a held wish before it is receipted"
  ~motif: [0 2 4 7 9 7]
  @theme: boof
  *rhythm: torch_march
  pattern: "X...x...X...x..."
}

^"valence_edges"{
