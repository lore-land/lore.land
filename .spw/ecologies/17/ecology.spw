#>chapter_17_ecology
#:ecology #!book-2
#:layer #!pragmatics
#:status #!live

~<rationale>{
  Chapter 17 measured from its canon. Ring 4 of 13, ? probe: inquiry before commitment. Its rooms can be read as the stations of one line, in order; its twin an octave away is Chapter 4.
}

^"identity"{
  chapter: 17
  book: 2
  ring: 4
  title: "Ledger of Unasked Questions"
  mood: "inquiry"
  period: "winter"
  logline: "In the checkered inquiry pavilion, clerks file every answer before anyone poses a question, and an unspent coincidence from the market stone turns up in a tray nobody owns."
  epigraph: "An answer filed early has nowhere to put the stranger who arrives with four corners."
}

^"grammar"{
  construct: "?"
  construct_name: "probe"
  construct_kind: "operator"
  opening_lens: "council, riddle, or ambiguity held without forcing"
  closing_perspective: "provokes a decisive act (!)"
  represents: "Inquiry before commitment"
  next_construct: "! (action)"
  observed_open_room: "?[blank_ledger]@clerk"
  observed_close_room: ".{blotter_dust}@clerk"
  sigils_present: "? & ."
  sigils_absent: "~ # ! * @ ^ = % $"
}

^"biome"{
  terrain: "checkered inquiry pavilion where clerks file answers before anyone poses a question"
  metabolite: "cross-breeze dust motes, stamped blotter paper, and hesitating pen nibs"
  symbiotes: "petition owls sorting blanks, clerks polling passersby about which coincidence is due today"
  irritant: "municipal questionnaires designed to force binary answers out of four-way drawings"
  circulation: "unasked riddles linger under benches until someone drops a coin or asks the dog by mistake"
}

^"craft"{
  modulators: { config: "probe (civic doubt)" measure: "%blanks_filed[uncounted]" substrate: "$blotter_rag_and_ash" }
  compost: "revisits the unspent ch07 coincidence as an administrative puzzle nobody owns"
  !watch: "Ring 2 Slot 4 (?): needs a puzzle with zero clean civic answer to preserve Ch04 echo"
  mode: "Phrygian / sus2"
  tonal_role: "+1 semitone wind shear against D4 tonic open without resolution (transposed into Book Two's C-axis continuation)"
}

^"stations"[
