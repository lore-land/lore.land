#:layer #!pragmatics
#:status #!live

~<rationale>{
  Chapter 19 measured from its canon. Ring 6 of 13, * value: reified objects and portable tokens. Its rooms can be read as the stations of one line, in order; its twin an octave away is Chapter 6.
}

^"identity"{
  chapter: 19
  book: 2
  ring: 6
  title: "The Snails Who Ate the Prices"
  mood: "labyrinth"
  period: "winter"
  logline: "In Bonk City's glaziers' alley, chalk tariffs tick upward for every unbroken hour a pane survives — until pane-snails slowly graze the numbers back into clear glass."
  epigraph: "Light passes straight through unpriced glass, and snags on every corner of a chalk sticker."
}

^"grammar"{
  construct: "*"
  construct_name: "value"
  construct_kind: "operator"
  opening_lens: "concrete artifact, keepsake, or lantern in hand"
  closing_perspective: "invites meeting and exchange (&)"
  represents: "Reified objects and portable tokens"
  next_construct: "& (confluence)"
  observed_open_room: "*[tariff_pane]@glazier"
  observed_close_room: ".{unpriced_glass}@the_land"
  sigils_present: "* @ ."
  sigils_absent: "~ # ? ! & ^ = % $"
}

^"biome"{
  terrain: "glaziers alley lined with framed panes marked with chalk tariffs that tick upward per unbroken hour"
  metabolite: "linseed putty odor, cold pane reflection, and clinking small change"
  symbiotes: "glaziers peering exclusively through panes they can afford, pane-snails slowly erasing price tags"
  irritant: "nobody on the street looking through a window unless a bill has first been attached to its frame"
  circulation: "light bends smoothly through unpriced glass yet catches on sticker corners at dusk"
}

^"craft"{
  modulators: { config: "value (commodity absurdity)" measure: "%pane_hours[ticks]" substrate: "$putty_sand_and_lead_came" }
  compost: "directly braids bane.land priced-window satire into Bonk City winter architecture"
  !watch: "Ring 2 Slot 6 (*): mirror of Ch06 lanterns—let objects stay weird and under-explained"
  mode: "Ionian +6 mediant"
  tonal_role: "bright relative major F4 over glass bells and fairground brass (transposed into Book Two's C-axis continuation)"
}

