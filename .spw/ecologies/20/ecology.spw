# Chapter 20 Ecology — Two Springs Under the Sill
# Composed by .spw/tools/ecology-compose.mjs (npm run spw:ecology) from the chapter JSON, likeness, almanac, pie levels
# and the plates manifest. ^"biome" and ^"craft" are authored and kept; every other block is measured and rewritten.
#>chapter_20_ecology
#:ecology #!book-2
#:layer #!pragmatics
#:status #!live

~<rationale>{
  Chapter 20 measured from its canon. Ring 7 of 13, & confluence: oaths, merges, and non-destructive composition. Its rooms can be read as the stations of one line, in order; its twin an octave away is Chapter 7.
}

^"identity"{
  chapter: 20
  book: 2
  ring: 7
  title: "Two Springs Under the Sill"
  mood: "path"
  period: "winter"
  logline: "At a swollen canal lock where sweetened brine meets bitter orchard runoff, the gates learn to share one chamber by taking turns every third chime — while Mr. BaneWAP sits on the wall tasting bitter jam."
  epigraph: "Two waters need never pretend to be one in order to share a sill."
}

^"grammar"{
  construct: "&"
  construct_name: "confluence"
  construct_kind: "operator"
  opening_lens: "two strands braided without erasing either"
  closing_perspective: "reveals how each side sees the other (@)"
  represents: "Oaths, merges, and non-destructive composition"
  next_construct: "@ (perspective)"
  observed_open_room: "&{canal_lock}@lockkeeper"
  observed_close_room: ".{tide_sill}@lockkeeper"
  sigils_present: "& @ ."
  sigils_absent: "~ # ? ! * ^ = % $"
}

^"biome"{
  terrain: "flooded canal lock where sweetened brine meets bitter orchard runoff"
  metabolite: "brackish swirl, pickled spice mist, and wet oak timber swelling shut"
  symbiotes: "seam-otters knotting rush reeds, a mime paddling without a boat, BaneWAP sampling bitter jam"
  irritant: "locks refusing to balance because one gate belongs to Boon.land and the other invoices tolls"
  circulation: "two incompatible waters share a lock chamber by alternating tide gates every third chime"
}

^"craft"{
  modulators: { config: "confluence (alloyed oath)" measure: "%salinity[split]" substrate: "$canal_oak_and_brine" }
  compost: "tests whether bittersweet compromise holds longer than pure sweetness (ties back to ch07/ch12)"
  !watch: "Ring 2 Slot 7 (&): guard against heavy exposition; let water levels show the merge"
  mode: "Dorian uneven"
  tonal_role: "tonic return darkened into asymmetrical 56% counting (transposed into Book Two's C-axis continuation)"
}

^"stations"[
  s01: { title: "The Swollen Lock" .spw: "&{canal_lock}@lockkeeper" container: "room" $material: "oak" =lean: "bone" %words: 140 %sentences: 6 %paragraphs: 3 }
  s02: { title: "The third chime" .spw: "&<third_chime>@the_land" container: "passage" $material: "ink" =lean: "boon" %words: 173 %sentences: 8 %paragraphs: 3 }
  s03: { title: "The bitter jam" .spw: "@{bitter_jam}@boof" container: "room" $material: "flour" =lean: "bane" %words: 131 %sentences: 9 %paragraphs: 3 }
  s04: { title: "The tide sill" .spw: ".{tide_sill}@lockkeeper" container: "room" $material: "" =lean: "bone" %words: 76 %sentences: 3 %paragraphs: 2 }
]

