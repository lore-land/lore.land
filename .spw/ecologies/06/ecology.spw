# Chapter 06 Ecology — Lanterns of Bonk City
# Composed by .spw/tools/ecology-compose.mjs (npm run spw:ecology) from the chapter JSON, likeness, almanac, pie levels
# and the plates manifest. ^"biome" and ^"craft" are authored and kept; every other block is measured and rewritten.
#>chapter_06_ecology
#:ecology #!book-1
#:layer #!pragmatics
#:status #!live

~<rationale>{
  Chapter 6 measured from its canon. Ring 6 of 13, * value: reified objects and portable tokens. Its rooms can be read as the stations of one line, in order; its twin an octave away is Chapter 19.
}

^"identity"{
  chapter: 6
  book: 1
  ring: 6
  title: "Lanterns of Bonk City"
  mood: "labyrinth"
  period: "spring"
  logline: "In a labyrinth of lantern-light, Mr. BoonWAP — a warm pie who serves himself and is never smaller — asks Boof the one question she cannot answer yet."
  epigraph: "A wish you can't say yet is still proofing."
}

^"grammar"{
  construct: "*"
  construct_name: "value"
  construct_kind: "operator"
  opening_lens: "concrete artifact, keepsake, or lantern in hand"
  closing_perspective: "invites meeting and exchange (&)"
  represents: "Reified objects and portable tokens"
  next_construct: "& (confluence)"
  observed_open_room: "${kiln_gate}@boof"
  observed_close_room: "~<iron_gate>@boof"
  sigils_present: "$ . ^ ? ~"
  sigils_absent: "# ! * & @ = %"
}

^"biome"{
  terrain: "running-bond cobblestone plaza beneath glass kilns and paper gutters"
  metabolite: "molten cullet glow, chime rain, and warm BoonWAP pie steam"
  symbiotes: "pane-snails healing cracks, chimney gutters, Mr. BoonWAP holding court, lost-button sweepers"
  irritant: "the uncounted arithmetic bill: pie never shrinks while stacks of dirty dishes grow off-frame"
  circulation: "glass blown hot cools into panes whose reflections double every lantern on the square"
}

^"craft"{
  modulators: { config: "labyrinth (dense exchange)" measure: "%plates[stacked]" substrate: "$cullet_glass_and_wax" }
  compost: "the uncollected button (recovered in ch15), lost-margin pie slice, and furnace glassing rules"
  !watch: "high density (10 wonders, 6 echoes); serves as Book 1 artifact hub (*)"
  mode: "Ionian +6 mediant"
  tonal_role: "bright relative major F4 over glass bells and fairground brass"
}

^"stations"[
  s01: { title: "The kiln gate" .spw: "${kiln_gate}@boof" container: "room" $material: "brass" =lean: "boon" %words: 360 %sentences: 25 %paragraphs: 8 }
  s02: { title: "The mirrored alley" .spw: ".<mirrored_alley>@the_labyrinth" container: "passage" $material: "glass" =lean: "boon" %words: 169 %sentences: 16 %paragraphs: 5 }
  s03: { title: "The lamp ladder" .spw: "^<lamp_ladder>@the_fool" container: "passage" $material: "brass" =lean: "boon" %words: 54 %sentences: 4 %paragraphs: 2 }
  s04: { title: "The Pie at the Table" .spw: "?(round_plaza)@boonwap" container: "gathering" $material: "steam" =lean: "boon" %words: 836 %sentences: 74 %paragraphs: 20 }
  s05: { title: "The iron gate" .spw: "~<iron_gate>@boof" container: "passage" $material: "glass" =lean: "boon" %words: 212 %sentences: 13 %paragraphs: 4 }
]

