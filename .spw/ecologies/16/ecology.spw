#>chapter_16_ecology
#:ecology #!book-2
#:layer #!pragmatics
#:status #!live

~<rationale>{
  Chapter 16 measured from its canon. Ring 3 of 13, . ground: what holds regardless of opinion. Its rooms can be read as the stations of one line, in order; its twin an octave away is Chapter 3.
}

^"identity"{
  chapter: 16
  book: 2
  ring: 3
  title: "The Second Place"
  mood: "boon"
  period: "winter"
  logline: "Boof wears the city's chosen title for one supper at Mr. BoonWAP's long table, while behind the baize curtain the unnamed figure dries plates beside the washer-up nobody has asked the name of."
  epigraph: "If the pie is never smaller, why do the hands at the sink still tire?"
}

^"grammar"{
  construct: "."
  construct_name: "ground"
  construct_kind: "operator"
  opening_lens: "physical footing, soil, or invariant furniture"
  closing_perspective: "raises an open question (?)"
  represents: "What holds regardless of opinion"
  next_construct: "? (probe)"
  observed_open_room: ".{brass_marker}@boonwap"
  observed_close_room: "?{endless_stack}@the_land"
  sigils_present: ". @ & ?"
  sigils_absent: "~ # ! * ^ = % $"
}

^"biome"{
  terrain: "long banquet trestle laid with coarse linen, brass place markers, and scullery steam"
  metabolite: "dishwater soap suds, warm glaze vapor, and unspoken wrist-ache behind the curtain"
  symbiotes: "the unnamed washer-up drying endless plates, Boof wearing a hat-shadow title she never asked for"
  irritant: "magic arithmetic pretending a pie never shrinks while real hands still wash real plates"
  circulation: "plates circulate from table to tub faster than BoonWAP speeches finish a sentence"
}

^"craft"{
  modulators: { config: "bone (maintenance truth)" measure: "%plates_washed[many]" substrate: "$linen_brass_and_soapsuds" }
  compost: "first explicit view into maintenance labor behind infinite bounty (links into Book 3 commons)"
  !watch: "seeded in wonder-about-pie.spw#c16; ideal Slot 3 (.) chapter grounding invisible physical care"
  mode: "Mixolydian ground"
  tonal_role: "b7 earth pedal beneath dual signals and stones (transposed into Book Two's C-axis continuation)"
}

^"stations"[
  s01: { title: "The Brass Place Marker" .spw: ".{brass_marker}@boonwap" container: "room" $material: "brass" =lean: "boon" %words: 234 %sentences: 15 %paragraphs: 4 }
