  s02: { title: "The eight shards" .spw: "&(eight_shards)@boof" container: "gathering" $material: "glass" =lean: "bane" %words: 125 %sentences: 14 %paragraphs: 2 }
  s03: { title: "The chimney rim" .spw: "~<chimney_rim>@the_fool" container: "passage" $material: "steam" =lean: "" %words: 42 %sentences: 6 %paragraphs: 2 }
  s04: { title: "The Shape with One Hole" .spw: "^{shard_ring}@boof" container: "room" $material: "glass" =lean: "boon" %words: 467 %sentences: 26 %paragraphs: 8 }
  s05: { title: "The pass road" .spw: "=<pass_road>@boof" container: "passage" $material: "glass" =lean: "bone" %words: 103 %sentences: 6 %paragraphs: 2 }
]

