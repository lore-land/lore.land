#:ecology #!book-1
#:layer #!pragmatics
#:status #!live

~<rationale>{
  Chapter 9 measured from its canon. Ring 9 of 13, <> capsule: channels, boundaries, and interfaces. Its rooms can be read as the stations of one line, in order; its twin an octave away is Chapter 22.
}

^"identity"{
  chapter: 9
  book: 1
  ring: 9
  title: "Shards of Nine Honks"
  mood: "puzzle"
  period: "spring"
  logline: "On the ridge, eight honks lie out as shards of sound — and the pieces assemble into a shape with one hole, exactly egg-sized."
  epigraph: "An unspent wish is an unsounded note. Everything else in the set was arranged around its silence."
}

^"grammar"{
  construct: "<>"
  construct_name: "capsule"
  construct_kind: "container"
  opening_lens: "threshold conduit built only to cross through"
  closing_perspective: "empties into a shared gathering (())"
  represents: "Channels, boundaries, and interfaces"
  next_construct: "() (scope)"
  observed_open_room: "#{roof_ridge}@boof"
  observed_close_room: "=<pass_road>@boof"
  sigils_present: "# & ~ ^ ="
  sigils_absent: ". ? ! * @ % $"
}

^"biome"{
  terrain: "tile roofs, narrow brick chimney rims, and wind-cut ridge passes"
  metabolite: "kiln soot, fractured earthenware dust, and brass horn harmonics"
  symbiotes: "jazz-geese calling in triplets, chimney-swifts banking through flues, shard sorters"
  irritant: "nine honks scattering across ten roof corners so no map reconciles the tenth corner"
  circulation: "air rushes up warm flues and flings shards along rooftop passages from lane to lane"
}

^"craft"{
  modulators: { config: "puzzle (syncopated)" measure: "%shards[9]" substrate: "$terracotta_and_soot" }
  compost: "corner-honk topologyfeeding jazz feel and hopper dynamics in /pie/"
  !watch: "opens with # instead of <> capsule, though middle and close rely on <chimney_rim> and <pass_road>"
  mode: "Mixolydian-Blues 9/8"
  tonal_role: "high-swing G4 with the ninth honk missing and warm"
}

^"stations"[
