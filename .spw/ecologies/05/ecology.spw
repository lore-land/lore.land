# Chapter 05 Ecology — Still Paying the Note
# Composed by .spw/tools/ecology-compose.mjs (npm run spw:ecology) from the chapter JSON, likeness, almanac, pie levels
# and the plates manifest. ^"biome" and ^"craft" are authored and kept; every other block is measured and rewritten.
#>chapter_05_ecology
#:ecology #!book-1
#:layer #!pragmatics
#:status #!live

~<rationale>{
  Chapter 5 measured from its canon. Ring 5 of 13, ! action: state transition and consequence. Its rooms can be read as the stations of one line, in order; its twin an octave away is Chapter 18.
}

^"identity"{
  chapter: 5
  book: 1
  ring: 5
  title: "Still Paying the Note"
  mood: "song"
  period: "spring"
  logline: "Two claims pull at one warm egg until the floor itself parts — and the crack beneath the hall is still singing the price of a grand wish granted centuries ago."
  epigraph: "Silence is not empty. It is two wants holding the same breath."
}

^"grammar"{
  construct: "!"
  construct_name: "action"
  construct_kind: "operator"
  opening_lens: "rupture, spark, or irreversible turn"
  closing_perspective: "settles into a durable value (*)"
  represents: "State transition and consequence"
  next_construct: "* (value)"
  observed_open_room: "={arched_hall}@boof"
  observed_close_room: "^<archway>@boof"
  sigils_present: "= ^ $ %"
  sigils_absent: "~ # . ? ! * & @"
}

^"biome"{
  terrain: "arched timber rift split down a desk and quiet stone passage"
  metabolite: "acoustic standing waves trapped in structural cracks"
  symbiotes: "hum-crickets gauging seam width, crack-gauges, musicians listening before hammering"
  irritant: "price tags hung directly over structural fractures instead of shimming them"
  circulation: "pitch drops an octave whenever the hall widens by a millimeter under load"
}

^"craft"{
  modulators: { config: "song (bone-weighted)" measure: "%aperture[mm]" substrate: "$split_oak_and_chord" }
  compost: "the first mimes and acoustic crack discipline feeding Bone.land later in ch10"
  !watch: "lacks direct ! action room despite slot 5 ! role—tension is carried via = and ^"
  mode: "Chromatic leading-tone"
  tonal_role: "-1 semitone below tonic D4: hairline fracture before release"
}

^"stations"[
  s01: { title: "The arched hall" .spw: "={arched_hall}@boof" container: "room" $material: "ink" =lean: "bane" %words: 341 %sentences: 27 %paragraphs: 7 }
  s02: { title: "The note stair" .spw: "^<note_stair>@the_song" container: "passage" $material: "" =lean: "" %words: 85 %sentences: 6 %paragraphs: 2 }
  s03: { title: "The split desk" .spw: "$<split_desk>@the_floor" container: "passage" $material: "" =lean: "boon" %words: 58 %sentences: 5 %paragraphs: 2 }
  s04: { title: "Wish-Physics Over the Crack" .spw: "%{crack_gauge}@genie" container: "room" $material: "brass" =lean: "bone" %words: 495 %sentences: 45 %paragraphs: 9 }
  s05: { title: "The archway" .spw: "^<archway>@boof" container: "passage" $material: "glass" =lean: "boon" %words: 270 %sentences: 17 %paragraphs: 4 }
]

