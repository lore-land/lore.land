# Chapter 08 Ecology — Songs of the Watering Eye
# Composed by .spw/tools/ecology-compose.mjs (npm run spw:ecology) from the chapter JSON, likeness, almanac, pie levels
# and the plates manifest. ^"biome" and ^"craft" are authored and kept; every other block is measured and rewritten.
#>chapter_08_ecology
#:ecology #!book-1
#:layer #!pragmatics
#:status #!live

~<rationale>{
  Chapter 8 measured from its canon. Ring 8 of 13, @ perspective: standpoint and observer-relative truth. Its rooms can be read as the stations of one line, in order; its twin an octave away is Chapter 21.
}

^"identity"{
  chapter: 8
  book: 1
  ring: 8
  title: "Songs of the Watering Eye"
  mood: "game"
  period: "spring"
  logline: "At a tavern leaning over a well that folds every face it has held, the Genie prices wishes for locals — and Boof's small asks come back unpriceable."
  epigraph: "The well keeps every face; the tavern keeps every round. Between them, all debts are known."
}

^"grammar"{
  construct: "@"
  construct_name: "perspective"
  construct_kind: "operator"
  opening_lens: "observer shift—through a beast, mirror, well, or hat"
  closing_perspective: "opens a directional crossing (<>)"
  represents: "Standpoint and observer-relative truth"
  next_construct: "<> (capsule)"
  observed_open_room: ".[folded_faces]@the_well"
  observed_close_room: "~<rocky_ridge>@boof"
  sigils_present: ". % = # ~"
  sigils_absent: "? ! * & @ ^ $"
}

^"biome"{
  terrain: "subterranean limestone wellhead and deep timber winch shaft"
  metabolite: "rising cold well vapor and rope-hemp grease under bucket echoes"
  symbiotes: "remembrancers tending pulley notches, well-winch singers, quiet observers from below"
  irritant: "buckets hauled up full of reflection when readers expected bucketed facts"
  circulation: "singing down the well returns the song slower, pitched to the depth of water left"
}

^"craft"{
  modulators: { config: "game (observer inversion)" measure: "%fathoms[well]" substrate: "$limestone_and_wet_hemp" }
  compost: "sub-surface perspective shift (@) priming ch14 and the subterranean salt under Bonk City"
  !watch: "another low lull (total 5); strong @ observer keeper (@the_well), zero lanes intro yet"
  mode: "Mixolydian reflection"
  tonal_role: "mirrored subtonic C4 echoing depths from the well"
}

^"stations"[
  s01: { title: "The folded faces" .spw: ".[folded_faces]@the_well" container: "window" $material: "ink" =lean: "boon" %words: 364 %sentences: 21 %paragraphs: 5 }
  s02: { title: "The taproom" .spw: "%(taproom)@genie" container: "gathering" $material: "ink" =lean: "bane" %words: 483 %sentences: 35 %paragraphs: 6 }
  s03: { title: "The trapdoor" .spw: "=<trapdoor>@the_fool" container: "passage" $material: "brass" =lean: "bone" %words: 67 %sentences: 2 %paragraphs: 2 }
  s04: { title: "The Unpriceable Want" .spw: "#{well_rim}@the_well" container: "room" $material: "glass" =lean: "boon" %words: 389 %sentences: 34 %paragraphs: 7 }
  s05: { title: "The rocky ridge" .spw: "~<rocky_ridge>@boof" container: "passage" $material: "oak" =lean: "" %words: 124 %sentences: 10 %paragraphs: 2 }
]

