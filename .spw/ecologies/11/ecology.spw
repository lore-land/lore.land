# Chapter 11 Ecology — The Crown Was Wasps
# Composed by .spw/tools/ecology-compose.mjs (npm run spw:ecology) from the chapter JSON, likeness, almanac, pie levels
# and the plates manifest. ^"biome" and ^"craft" are authored and kept; every other block is measured and rewritten.
#>chapter_11_ecology
#:ecology #!book-1
#:layer #!pragmatics
#:status #!live

~<rationale>{
  Chapter 11 measured from its canon. Ring 11 of 13, [] frame: indexing, filtering, and borderline paradox. Its rooms can be read as the stations of one line, in order; its twin an octave away is Chapter 24.
}

^"identity"{
  chapter: 11
  book: 1
  ring: 11
  title: "The Crown Was Wasps"
  mood: "awakening"
  period: "spring"
  logline: "BaneWAP seizes the egg and wishes huge — and the wish grants at once, minimum-viable, an empire hollow as a rented crown."
  epigraph: "A grand wish grants easily. It is the finishing that never comes."
}

^"grammar"{
  construct: "[]"
  construct_name: "frame"
  construct_kind: "container"
  opening_lens: "selective window contrasting paradoxical rules"
  closing_perspective: "accumulates charge inside a body ({})"
  represents: "Indexing, filtering, and borderline paradox"
  next_construct: "{} (body)"
  observed_open_room: "!(bloom_garden)@banewap"
  observed_close_room: "=<blackthorn_gap>@boof"
  sigils_present: "! * $ ~ ="
  sigils_absent: "# . ? & @ ^ %"
}

^"biome"{
  terrain: "rented court garden fenced by blackthorn gaps and cold forcing glass"
  metabolite: "prickly thorn sap, unripe quince scent, and bitter-sweet pollen haze"
  symbiotes: "crown-wasps guarding blooms, early bees braving frost, BaneWAP posting legalisms on petals"
  irritant: "an off switch printed right inside the villainous clause while roses grow across every lane"
  circulation: "frost holds stems stiff until a hopped breath shakes nectar loose from the thorns"
}

^"craft"{
  modulators: { config: "awakening (paradox bloom)" measure: "%thorns[hopped]" substrate: "$blackthorn_and_wasp_wax" }
  compost: "the bloom-garden trial logic in /pie/ and BaneWAP self-refuting clauses"
  !watch: "strong [] paradoxical framing in court rules; opens directly on !(bloom_garden)"
  mode: "Locrian / Raised-6th"
  tonal_role: "pre-cadential B3 anticipating the beat ahead of its seed"
}

^"stations"[
  s01: { title: "The bloom garden" .spw: "!(bloom_garden)@banewap" container: "gathering" $material: "flour" =lean: "bane" %words: 710 %sentences: 57 %paragraphs: 12 }
  s02: { title: "The split crust" .spw: "*[split_crust]@banewap" container: "window" $material: "flour" =lean: "boon" %words: 145 %sentences: 15 %paragraphs: 3 }
  s03: { title: "The throne step" .spw: "$<throne_step>@the_fool" container: "passage" $material: "oak" =lean: "bane" %words: 53 %sentences: 4 %paragraphs: 2 }
  s04: { title: "The Wish That Would Not Finish" .spw: "~{quince_rise}@boof" container: "room" $material: "steam" =lean: "boon" %words: 430 %sentences: 30 %paragraphs: 8 }
  s05: { title: "The blackthorn gap" .spw: "=<blackthorn_gap>@boof" container: "passage" $material: "" =lean: "" %words: 47 %sentences: 4 %paragraphs: 2 }
]

