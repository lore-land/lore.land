# Lore.Land Chapter Ecologies Index (01..26)
# Accounts for every chapter in Ring 1 (Book One: 01..13) and Ring 2 (Book Two: 14..26),
# separated cleanly from the generated .spw/chapters/NN.spw build mirrors.
#>lore_land_ecologies_index
#:canon #!ecologies
#:layer #!pragmatics
#:status #!active

~<rationale>{
  Chapters need distinct internal physiology—substrate, metabolites, symbiotes, irritants, assets, and gut health—rather than flat uniform containers. Organizing folders 01 through 26 under .spw/ecologies/ keeps generated chapter mirrors clean under .spw/chapters/ while letting Books One and Two compare octave resonance (~ # . ? ! * & @ <> () [] {} ^) and balance re-derivations before Book Three opens.
}

^"meta"{
  total_chapters: 26
  books: 2
  sequence: "~ # . ? ! * & @ <> () [] {} ^"
  &world_ecology: ~"../surfaces/ecology.spw#ecology"
  &ring_tour: ~"../surfaces/rooms.spw#ring_tour"
  &book_three: ~"../surfaces/book-three.spw#lore_land_book_three"
  &progression: ~"../audits/progression.spw#lore_land_audits_progression"
}

&[ecologies][
  c01: { title: "Dawn in Boon.land" book: 1 ring: 1 construct: "~" status: "live" &ecology: ~"./01/ecology.spw" }
  c02: { title: "The First Echo" book: 1 ring: 2 construct: "#" status: "live" &ecology: ~"./02/ecology.spw" }
  c03: { title: "Signals in the Sand" book: 1 ring: 3 construct: "." status: "live" &ecology: ~"./03/ecology.spw" }
  c04: { title: "Crosswind Council" book: 1 ring: 4 construct: "?" status: "live" &ecology: ~"./04/ecology.spw" }
  c05: { title: "The Quiet Rift" book: 1 ring: 5 construct: "!" status: "live" &ecology: ~"./05/ecology.spw" }
  c06: { title: "Lanterns of Bonk City" book: 1 ring: 6 construct: "*" status: "live" &ecology: ~"./06/ecology.spw" }
  c07: { title: "Blueberry Oath" book: 1 ring: 7 construct: "&" status: "live" &ecology: ~"./07/ecology.spw" }
  c08: { title: "Songs of the Watering Eye" book: 1 ring: 8 construct: "@" status: "live" &ecology: ~"./08/ecology.spw" }
  c09: { title: "Shards of Nine Honks" book: 1 ring: 9 construct: "<>" status: "live" &ecology: ~"./09/ecology.spw" }
  c10: { title: "Bone.land Resonance" book: 1 ring: 10 construct: "()" status: "live" &ecology: ~"./10/ecology.spw" }
  c11: { title: "Paradox Bloom" book: 1 ring: 11 construct: "[]" status: "live" &ecology: ~"./11/ecology.spw" }
