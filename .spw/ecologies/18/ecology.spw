  sigils_present: "! @ ."
  sigils_absent: "~ # ? * & ^ = % $"
}

^"biome"{
  terrain: "steep wooden stairways and flour-dusted belfry louvres above the city square"
  metabolite: "suspended white bakery haze waiting for a spark or slammed shutter"
  symbiotes: "belfry swifts, dust-drunk moths, a mime leaning against an invisible bell rope"
  irritant: "one accidental stomp releasing a cloud that resets every clock and slows the parade"
  circulation: "vertical updrafts whirl flour past clappers, muffling every warning pulse until strike"
}

