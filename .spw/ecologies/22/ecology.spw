# Chapter 22 Ecology — Three Roofs Higher
# Composed by .spw/tools/ecology-compose.mjs (npm run spw:ecology) from the chapter JSON, likeness, almanac, pie levels
# and the plates manifest. ^"biome" and ^"craft" are authored and kept; every other block is measured and rewritten.
#>chapter_22_ecology
#:ecology #!book-2
#:layer #!pragmatics
#:status #!live

~<rationale>{
  Chapter 22 measured from its canon. Ring 9 of 13, <> capsule: channels, boundaries, and interfaces. Its rooms can be read as the stations of one line, in order; its twin an octave away is Chapter 9.
}

^"identity"{
  chapter: 22
  book: 2
  ring: 9
  title: "Three Roofs Higher"
  mood: "labyrinth"
  period: "winter"
  logline: "Behind the guild basements, a sloped copper parcel chute turns every bundle into a description of what someone else packed, while receipts blow backward up the return duct."
  epigraph: "Never camp inside a chute; gravity takes the bundle, and the draft keeps the paper."
}

^"grammar"{
  construct: "<>"
  construct_name: "capsule"
  construct_kind: "container"
  opening_lens: "threshold conduit built only to cross through"
  closing_perspective: "empties into a shared gathering (())"
  represents: "Channels, boundaries, and interfaces"
  next_construct: "() (scope)"
  observed_open_room: "~<copper_chute>@porter"
  observed_close_room: ".{return_duct}@porter"
  sigils_present: "~ ! * ."
  sigils_absent: "# ? & @ ^ = % $"
}

^"biome"{
  terrain: "sloped copper parcel chute twisting behind kitchen walls and guild basements"
  metabolite: "brass-rubbed static, warm cinnamon air, and sliding parcel twine"
  symbiotes: "the Fool sliding briefly through an unmarked hatch, cellar mice riding ribbon ends"
  irritant: "packets emerging from the far end transformed into descriptions of what someone else packed"
  circulation: "gravity moves parcels one way while slips of paper blow back up the parallel return duct"
}

^"craft"{
  modulators: { config: "capsule (directional transit)" measure: "%chutes[unlogged]" substrate: "$copper_sheeting_and_twine" }
  compost: "pure <> crossing space preparing players for wrapping/channel physics across Ring 2"
  !watch: "Ring 2 Slot 9 (<>): keep Ch09 jagged passage energy; never let travelers camp inside a chute"
  mode: "Mixolydian-Blues 9/8"
  tonal_role: "high-swing G4 with the ninth honk missing and warm (transposed into Book Two's C-axis continuation)"
}

^"stations"[
  s01: { title: "The Copper Drop" .spw: "~<copper_chute>@porter" container: "passage" $material: "flour" =lean: "bane" %words: 152 %sentences: 7 %paragraphs: 3 }
  s02: { title: "The unmarked hatch" .spw: "!<unmarked_hatch>@fool" container: "passage" $material: "brass" =lean: "boon" %words: 131 %sentences: 5 %paragraphs: 3 }
  s03: { title: "The parcel bundle" .spw: "*<parcel_bundle>@the_land" container: "passage" $material: "ink" =lean: "bane" %words: 160 %sentences: 8 %paragraphs: 3 }
  s04: { title: "The return duct" .spw: ".{return_duct}@porter" container: "room" $material: "steam" =lean: "boon" %words: 105 %sentences: 5 %paragraphs: 2 }
]

