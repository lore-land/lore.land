# Chapter 07 Ecology — Blueberry Oath
# Composed by .spw/tools/ecology-compose.mjs (npm run spw:ecology) from the chapter JSON, likeness, almanac, pie levels
# and the plates manifest. ^"biome" and ^"craft" are authored and kept; every other block is measured and rewritten.
#>chapter_07_ecology
#:ecology #!book-1
#:layer #!pragmatics
#:status #!live

~<rationale>{
  Chapter 7 measured from its canon. Ring 7 of 13, & confluence: oaths, merges, and non-destructive composition. Its rooms can be read as the stations of one line, in order; its twin an octave away is Chapter 20.
}

^"identity"{
  chapter: 7
  book: 1
  ring: 7
  title: "Blueberry Oath"
  mood: "shadow"
  period: "spring"
  logline: "At the market stone Boof swears the only oath a wish allows: to spend it when the want is true — and learns the shadow price, that every spent wish owes a coincidence to a stranger."
  epigraph: "Every wish is paid twice: once by the wisher, once by someone who never hears about it."
}

^"grammar"{
  construct: "&"
  construct_name: "confluence"
  construct_kind: "operator"
  opening_lens: "two strands braided without erasing either"
  closing_perspective: "reveals how each side sees the other (@)"
  represents: "Oaths, merges, and non-destructive composition"
  next_construct: "@ (perspective)"
  observed_open_room: "=(oath_stone)@boof"
  observed_close_room: "~<long_alley>@the_stranger"
  sigils_present: "= # * . ~"
  sigils_absent: "? ! & @ ^ % $"
}

^"biome"{
  terrain: "dyed slate alleyways beside berry cooling-stones"
  metabolite: "indigo berry juice staining limestone and cool night dew"
  symbiotes: "oath-moths fluttering toward blue lamps, oath-scale keepers, strangers carrying small coincidences"
  irritant: "vows spoken lightly crystallizing into heavy stoneweights on the pocket hem"
  circulation: "berry stain seeps downward while spoken oaths cool into solid tiles underfoot"
}

^"craft"{
  modulators: { config: "shadow (two-sided)" measure: "%coincidence[1]" substrate: "$blueberry_stain_and_slate" }
  compost: "one unassigned good coincidence left intentionally uncollected until Book Two"
  !watch: "low count lull (total 5) intentionally pacing a quiet oath after ch06 kiln density"
  mode: "Dorian uneven"
  tonal_role: "tonic return darkened into asymmetrical 56% counting"
}

^"stations"[
  s01: { title: "The oath stone" .spw: "=(oath_stone)@boof" container: "gathering" $material: "berry" =lean: "bone" %words: 689 %sentences: 45 %paragraphs: 10 }
  s02: { title: "The oath shadow" .spw: "#[oath_shadow]@genie" container: "window" $material: "ink" =lean: "boon" %words: 132 %sentences: 13 %paragraphs: 3 }
  s03: { title: "The awning beam" .spw: "*<awning_beam>@the_fool" container: "passage" $material: "berry" =lean: "boon" %words: 93 %sentences: 8 %paragraphs: 2 }
  s04: { title: "The Shadow Price" .spw: ".{cooling_stone}@boof" container: "room" $material: "berry" =lean: "bone" %words: 317 %sentences: 20 %paragraphs: 5 }
  s05: { title: "The long alley" .spw: "~<long_alley>@the_stranger" container: "passage" $material: "brass" =lean: "" %words: 43 %sentences: 4 %paragraphs: 2 }
]

