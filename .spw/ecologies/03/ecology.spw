#:ecology #!book-1
#:layer #!pragmatics
#:status #!live

~<rationale>{
  Chapter 3 measured from its canon. Ring 3 of 13, . ground: what holds regardless of opinion. Its rooms can be read as the stations of one line, in order; its twin an octave away is Chapter 16.
}

^"identity"{
  chapter: 3
  book: 1
  ring: 3
  title: "The Salt-Whale Roads"
  mood: "paradox"
  period: "spring"
  logline: "Where two old routes want to be one turn, Boof digs up a Discount Genie who can grant anything — except see what she wants."
  epigraph: "Perfect version costs a miracle. Mediocre version costs one coincidence and a Thursday."
}

^"grammar"{
  construct: "."
