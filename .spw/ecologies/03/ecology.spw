  observed_close_room: "&<one_turn>@boof"
  sigils_present: "? ! * % &"
  sigils_absent: "~ # . @ ^ = $"
}

^"biome"{
  terrain: "salt-crusted dune flats and sand-scoured boundary desks"
  metabolite: "windblown silica, brine evaporation, and bottle-cork amber"
  symbiotes: "salt-whales beneath shallow pans, signal-skinks writing transient dashes, the Genie off-hours"
  irritant: "signals erased by tide before the scale can tally why the want needle swung"
  circulation: "heat draws water up, leaving readable salt ridges that crack into signals"
}

^"craft"{
  modulators: { config: "paradox (double edge)" measure: "%grain[drift]" substrate: "$silica_and_salt" }
