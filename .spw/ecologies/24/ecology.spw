  s02: { title: "The four shutters" .spw: "?[four_shutters]@the_land" container: "window" $material: "ink" =lean: "boon" %words: 160 %sentences: 7 %paragraphs: 3 }
  s03: { title: "The double shutter" .spw: "![double_shutter]@boof" container: "window" $material: "glass" =lean: "boon" %words: 150 %sentences: 7 %paragraphs: 3 }
  s04: { title: "The open courtyard" .spw: ".[open_courtyard]@judge" container: "window" $material: "brass" =lean: "" %words: 87 %sentences: 5 %paragraphs: 2 }
]

