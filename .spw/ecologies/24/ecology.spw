~<rationale>{
  Chapter 24 measured from its canon. Ring 11 of 13, [] frame: indexing, filtering, and borderline paradox. Its rooms can be read as the stations of one line, in order; its twin an octave away is Chapter 11.
}

^"identity"{
  chapter: 24
  book: 2
  ring: 11
  title: "Four Windows in One Wall"
  mood: "labyrinth"
  period: "winter"
  logline: "Four judges peer through four masking shutters cut in the same wall and prove four cleanly opposite laws while the unnamed figure strolls unbroken behind all of them."
  epigraph: "Each shutter proved a flawless law and missed three quarters of the courtyard."
}

^"grammar"{
  construct: "[]"
  construct_name: "frame"
  construct_kind: "container"
  opening_lens: "selective window contrasting paradoxical rules"
  closing_perspective: "accumulates charge inside a body ({})"
