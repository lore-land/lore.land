  observed_close_room: ".[open_courtyard]@judge"
  sigils_present: "= ? ! ."
  sigils_absent: "~ # * & @ ^ % $"
}

^"biome"{
  terrain: "partitioned judging booth with four masking shutters cutting a courtyard scene into incompatible frames"
  metabolite: "paint thinner, shutter hinge squeak, and conflicting scorecards slipping under dividers"
  symbiotes: "judges each watching a different corner of the same lane, a figure passing silently behind all four"
  irritant: "each window proves a cleanly opposite law while covering one quarter of the truth"
  circulation: "opening two shutters at once throws crossing shadows that cancel each frame independently"
}

^"craft"{
  modulators: { config: "frame (contrastive index)" measure: "%shutters[4]" substrate: "$painted_pine_and_felt" }
  compost: "aligns directly with /pie/ split-panel UI and paradoxical rule lenses ([])"
  !watch: "Ring 2 Slot 11 ([]): avoid turning frames into cold riddleboxes—keep visual slapstick vivid"
  mode: "Locrian / Raised-6th"
  tonal_role: "pre-cadential B3 anticipating the beat ahead of its seed (transposed into Book Two's C-axis continuation)"
}

^"stations"[
