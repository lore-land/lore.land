#:ecology #!book-2
#:layer #!pragmatics
#:status #!live

~<rationale>{
  Chapter 14 measured from its canon. Ring 1 of 13, ~ potential: what waits before being named. Its rooms can be read as the stations of one line, in order; its twin an octave away is Chapter 1.
}

^"identity"{
  chapter: 14
  book: 2
  ring: 1
  title: "The Thursday Nobody Kept"
  mood: "path"
  period: "winter"
  logline: "The Genie's price comes due: a Thursday goes missing from every person's week but not from the field — and on the day nobody kept, Boof finds someone standing under the hat."
  epigraph: "A week can lose a day. A field never has."
}

^"grammar"{
  construct: "~"
  construct_name: "potential"
  construct_kind: "operator"
  opening_lens: "unspent latency without a receipt"
  closing_perspective: "invites an external mark (#)"
  represents: "What waits before being named"
  next_construct: "# (annotation)"
  observed_open_room: "?{kitchen_door}@boof"
  observed_close_room: "=<field_edge>@boof"
  sigils_present: "? . = @ * & !"
  sigils_absent: "~ # ^ % $"
}

^"biome"{
  terrain: "frozen white lane ruling straight across empty pasture under teal winter glare"
  metabolite: "unspent Thursday silence, beeswax ember, and clean snow unbroken by footprints"
  symbiotes: "page-foxes skirting margins, hob-deer leaping fences, torch-ant line-crews lit from an arm tip"
  irritant: "a calendar day missing from every townsfolk pocket, leaving Friday crowded at the border"
  circulation: "one figure steps at 90 degrees across frozen contours, lighting a dead ant-torch with his own short arm"
}

^"craft"{
  modulators: { config: "path (zero-person day)" measure: "%absent[thursday]" substrate: "$winter_frost_and_ember" }
  compost: "a shortened right arm warming an ant-street and a gap left rectangular in the hawthorn hedge"
  !watch: "slot 1 (~) chapter currently has 0 ~ rooms (?{kitchen_door} opens; @{warm_furrow} mid)—prime re-derivation candidate"
  mode: "Lydian #4"
  tonal_role: "suspended shimmer opening a held wish before it is receipted"
}

