?probes[
  c11_lane: "long paragraphs are captioned where the leg is taut (caption strain 0.38); ease ~pace there, or let the paragraph be read off the road"
  c14_cap: "the leg is held at 480 cobbles, so its captions run at 30.1 characters a cobble against 22"
  c15_lane: "long paragraphs are captioned where the leg is taut (caption strain 0.44); ease ~pace there, or let the paragraph be read off the road"
  c15_cap: "the leg is held at 480 cobbles, so its captions run at 27.9 characters a cobble against 22"
  c17_title: "Ledger of Unasked Questions — under half its words are in the prose (0.33)"
  twins_weight: "11 of 13 octave twins differ in weight by more than half: 16 at 0.52 of 3, 17 at 0.35 of 4, 18 at 0.45 of 5, 19 at 0.32 of 6, 20 at 0.41 of 7, 21 at 0.36 of 8, 22 at 0.47 of 9, 23 at 0.38 of 10, 24 at 0.38 of 11, 25 at 0.35 of 12, 26 at 0.42 of 13"
]

^"prints"{
  .note: "what each consumer reads from this cache; a new print adds a row here before it reads anything"
  page: "chapter pages read the chapter JSON directly; this cache only describes them"
  lanes: "pie-levels.spw ~pace is read against caption_load: a leg eases where its paragraphs are long, so captions can be read between dodges"
  share_cards: "assets:brand sets the title; title_on_page counts how many title words the page or its epigraph holds, which says nothing about whether the title is right"
  trope_wiki: "tropes per chapter, octave twins and lean give a trope page its crossings and its two registers"
  autonomous_feedback: "shape and sentences_per_paragraph are counts a feedback route could ask beside; whether a reader loses the thread there is what the route asks, not what the count says"
}
