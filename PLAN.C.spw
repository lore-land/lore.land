}

^synthesis_and_governance{
  summary_emit: "book/audits/chrome-updates/summary-52.spw"
  risk_emit: "book/audits/chrome-updates/risk-register.spw"
  summary_columns: {
    feature: required
    first_appeared: required
    stable_support: required
    shadow_dom_relevance: required
    implementation_cost: required
    risk: required
    adoption_decision: required
  }
  adoption_buckets: { adopt_now: supported, adopt_with_guardrails: supported, monitor: supported, reject: supported }
  .note: "the synthesis artifact joins shadow DOM track findings with chrome milestone track data —
          features scored 'adopt-now' in the milestone track that address gaps identified in the
          shadow DOM track are prioritized in the final recommendation"
}

^acceptance_criteria{
  phase_total: equals_65
  shadow_track: equals_13
  chrome_track: equals_52
  emit_paths: deterministic_and_complete
  implementation_code: excluded
  .note: "Plan C is audit-only — no implementation code is produced;
          implementation decisions feed into PLAN.A and PLAN.D"
}

^assumptions{
  latest_updates_scope: latest_52_major_stable_milestones
  source_of_truth: official_chrome_release_channels
  output_mode: spw_artifacts
  .note: "milestone range M94-M145 covers September 2021 through February 2026 —
          this window captures the full lifecycle of modern shadow DOM features
          from origin trial through stable shipping"
}

#>wonder_plan_c_binding_through_sigil
?["Does a dark binding leave a chapter sigil light on light?"]{
  #:depth #!material
  ~#lens: "weather through a boundary"
  ~#expect: "Under slate and starfield the sigil's title and meaning turn near-white (--color-text-main follows --text-color-main, #ebe8de and #eef3ff) over the literal white panel and fall below AA; the phrase block keeps its own #142036 night and reads."
  ~#probe(read)
  !probe{ "Read createTemplate's style in chapter-sigil.mjs against the slate and starfield blocks in chapter/bindings.css, then open a chapter with ?binding=starfield and the scribe's desk on, and measure the sigil's ink against its panel." }
  $%[ink.contrast, panel.literals, tokens.read]
}

#>wonder_plan_c_lens_keeps_citation
?["If a paragraph wore a shadow lens, would line-share still cite it?"]{
  #:depth #!experiential
  ~#lens: "the words as common ground"
  ~#expect: "Yes while the words are slotted: they stay in the light tree, so PROSE_SELECTOR, window.getSelection and a text fragment all still reach them. Words moved inside the root drop out of line-share and may not take a fragment at all."
  ~#probe(read)
  !probe{ "In an untracked scratch page, put one paragraph slotted through a lens and one written inside a root; select each, build its #:~:text= link the way line-share.mjs does, open it, and try find in page." }
  $%[cite.slotted, cite.inside, find.slotted, find.inside]
}

#>wonder_plan_c_built_sigil
?["Can chapters:build write a chapter's sigil into the page without a second renderer?"]{
  #:depth #!structural
  ~#lens: "one renderer for build and browser"
  ~#expect: "Yes, once createTemplate builds a string the way chamber-seals.mjs does: the build stamps a shadowrootmode template into the aside, the browser keeps only the reinterpret handler, the reader tier still hides it with scripts off (the whitelist is CSS), and the AL-005 mirror moves into built HTML where a diff can see it drift."
  ~#probe(read)
  !probe{ "Read where build-chapters.mjs and chapter-render.mjs write the aside, and count what createTemplate builds with el() that a string would have to say." }
  $%[renderers, el_calls, aside_writers]
}

#>wonder_plan_c_slot_withholding
?["Can a probe tell a lens that frames prose from one that can withhold it?"]{
  #:depth #!educational
  ~#lens: "a slot as a promise"
  ~#expect: "Yes, by reading templates as text: a root that passes prose through one default slot with no rule hiding it cannot withhold words, while named slots, a slot inside a toggled container, or display none on a slot or ::slotted mark one that can. Run on the parent of 38d136b, it would have flagged the voices AL-012 caught by hand."
  ~#probe(read)
  !probe{ "Read every attachShadow template in book/scripts, and the old voices with git show 38d136b^:book/scripts/custom; count default slots, named slots, slots inside a toggled container, and rules that hide a slot." }
  $%[slot.default, slot.named, slot.toggled, slot.hidden]
}

#>wonder_plan_c_window_drift
?["How far has Chrome stable moved since M145?"]{
  #:depth #!temporal
  ~#lens: "the window as a dated record"
  ~#expect: "About nine milestones: at the four-week cadence from M145 on 2026-02-10, stable on 2026-11-08 is near M154, so a rolling 52 would read M103–M154 and let M94–M102 go."
  ~#probe(read)
  !probe{ "After the local files, read the Chrome Releases stable-channel posts since February 2026 and record the latest stable major and its date in ^verified_context's shape." }
  $%[stable.latest, milestones.since_145]
}

#>plan_c_relay
^relay{
  .note: "How the next session takes a turn on Plan C. Claude or any other model may take it; the creator closes branches."
  rungs: ["seed: said once, worth keeping", "sketch: worked through, its strains named", "probe: a check exists that reads or runs", "landed: in code or canon, in a commit the creator asked for"]
  turn: [
    "Pick one branch from ~branches and say the axis it varies.",
    "Move one claim one step (seed, sketch, probe, landed) and say where it is rooted: live, proposed, prototype or imagined, citing the file you read.",
    "Read and grep the code before writing a root; a root from memory is a seed.",
    "Leave the other branches standing; a branch closes by the creator's word or a probe's receipt.",
    "Add a dated line to turns."
  ]
  keep: [
    "Plan C stays audit-only (^acceptance_criteria implementation_code: excluded); a probe that reads files is not implementation.",
    "lore.land commits only when the creator asks; scripts that write tracked files (build, chapters:build, spw:export, spw:probes, assets:*) wait for a turn that is asked to run them.",
    "spw:lint walks .spw/ only, so parse this file by hand in the prose profile. The plan's 59 wrapped strings are its 118 standing errors; reflowing each onto one line is a turn of its own."
  ]
  &neighbors: ["PLAN.E.spw (L11 faces, L18 engine)", ".spw/state/alignment-ledger.spw#AL-005", ".spw/state/alignment-ledger.spw#AL-012", ".spw/surfaces/folios.spw", "PLAN.D.spw"]
  turns: [
    "2026-11-08 — sketch — a Claude session, at the creator's ask to grow the plan's theory generatively: roots read from code for all 13 shadow phases and six epochs, eight branches by axis, the aspiration, five wonders with guesses, and this relay; CSS nesting's first milestone set to M112 on its two lines."
  ]
}
