      "icons": [
        {
          "src": "/book/pwa/icons/icon-192.png",
          "sizes": "192x192",
          "type": "image/png"
        }
      ],
      "description": "Pick up where you left off, search the book, keep it offline, see when the next chapter lands, and write to the scribes."
