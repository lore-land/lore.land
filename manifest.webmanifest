{
  "id": "/",
  "name": "Lore.Land",
  "short_name": "Lore.Land",
  "description": "A living serial you can read in a nook, a small game that carries the whole book, and the atlas it was grown from: Boof, a warm egg the maps will not admit, and chapters that keep their place for you.",
  "start_url": "/?source=pwa",
  "scope": "/",
  "display": "standalone",
  "display_override": [
    "standalone",
    "minimal-ui"
  ],
  "launch_handler": {
    "client_mode": [
      "navigate-existing",
      "auto"
    ]
  },
  "background_color": "#2F483A",
  "theme_color": "#f3ede1",
  "lang": "en-US",
  "dir": "ltr",
