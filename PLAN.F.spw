#>plan_f
#:layer #!pragmatics
#:status #!working

~<rationale>{
  Plan F asks how lore.land keeps changing without wearing out its maker, its readers, or its
  meaning. A serial is a publishing ecosystem: prose, structure, world, rules and the language
  itself all evolve at different speeds, and readers leave marks that evolve with them. Each of
  these is a dimension of narrative semantic evolution. The plan names each one, gives it a unit
  small enough to ship on an ordinary evening, a file that carries it, a check that guards it, and
  a way for its change to be read back as meaning rather than as a diff. The scarce resource is
  the attention of the person making the book; every tool here should cost less of it than it saves.
}

^meta{
  source: "PLAN.F.spw (written 2026-11-08)"
  dialect: spw_native
  status: "2026-11-10: every open increment carries its operation, files, who decides, and the command that checks it. Those fields, and f15 and f16, are an agent's proposals, for the maker to keep or strike"
  do_not: "Do not start a slice with no check. Do not widen a slice to finish a neighbour."
  style: dimensions_and_increments
  normative_voice: direction
  &reader: "the maker of lore.land, a writing table helping them, or a future book poured into the engine"
  &follows: ~"PLAN.E.spw#plan_e"
  &rooms: ~".spw/surfaces/rooms.spw"
  &stress: ~".spw/surfaces/spw-stress.spw#lore_land_surfaces_spw_stress"
  &rules: ~".spw/runtime/pie-rules.spw#lore_land_runtime_pie_rules"
}

&plan_contracts{
  small_stones: "the unit of release is the smallest thing a reader can finish: a room, a palette, a card, a rule; a chapter is a set of rooms released over several stones"
  meaning_first: "every release says what changed in meaning (rooms set, wonders added, leans moved, rules retuned) before it says what files changed"
  readers_keep_theirs: "nothing a reader has kept (marks, carries, palettes, cards, provenance) is lost or reinterpreted by a release; a rule change applies forward"
  canon_in_text: "everything that evolves is text the maker can read and diff: JSON for prose, Spw for structure, rules and canon"
  cheap_checks: "every dimension has a check that runs in under a minute and needs no network: book:check, spw:lint, spw:probes, dist:verify"
  #invariant: the_attention_of_the_maker_is_the_budget
}

^"dimensions"{
  .note: "Each dimension: what evolves, its unit, the file that carries it, the check that guards it, and how its change is read back."
  prose: {
    evolves: "the words of the book, variant zero first, tellings after"
    unit: "a room (one section), released by flipping its status from drafting to set"
    carrier: ~"book/content/chapters"
    check: "book:check (rooms, slots, signatures), the prerender, search and semantic rebuilt"
    read_back: "a room set is named in the release note by its signature and its air"
  }
  structure: {
    evolves: "how the book is shaped: rooms, chapters, books, the order a reader meets them"
    unit: "a room signature in Spw (its container, its motion, its observer)"
    carrier: ~".spw/surfaces/rooms.spw"
    check: "every signature parses with the vendored parser; container is one of the four"
    read_back: "the room strip on each chapter; a structural change shows as a changed signature, never a silent move"
  }
  valence: {
    evolves: "how chapters lean among fairy tale, absurd reality and low magic, by the book and by each reader"
    unit: "a weight in =lean{} (pie-rules.spw) or a lean on a paragraph"
    carrier: ~".spw/runtime/pie-rules.spw"
    check: "the bench reads it; the stress panel compares readers; a carry says why a chapter leans"
    read_back: "each chapter page says why it leans, in the reader words of what they did"
  }
  world: {
    evolves: "the nouns and places: wonders, materials, palettes, berries, harmonies, plates, folios"
    unit: "one entry (a wonder, a palette, a harmony, a card)"
    carrier: "book/content/world/*.json and their canon surfaces"
    check: "book:check (wonders), probes (plates), lint (canon)"
    read_back: "the almanac shelves and Boof map grow by entry; a new entry is said in the release note"
  }
  rules: {
    evolves: "how the game plays: tuning, knocks, powers, the lean weights"
    unit: "one spell in pie-rules.spw"
    carrier: ~".spw/runtime/pie-rules.spw"
    check: "the real parser reads it whole; the small reader agrees; every power survives a round trip"
    read_back: "cards show the spell they run on; provenance cards say which rules a carry ran on and whose"
  }
  grammar: {
    evolves: "Spw itself, upstream in spw-workbench"
    unit: "a finding (stress), a pin bump (submodule), a re-bundled parser"
    carrier: ~".spw/surfaces/spw-stress.spw"
    check: "spw:seed-bundle:verify; lint stays at its known warnings; the game stress panel stays quiet"
    read_back: "findings travel upstream as issues; a pin bump lists which findings it answers"
  }
  marks: {
    evolves: "what each reader has kept: carries, cards, palettes, sightings, tellings, provenance"
    unit: "a mark in the reader browser"
    carrier: "localStorage keys named lore.*.v1"
    check: "begin again clears them on request; a release never rewrites them"
    read_back: "the almanac, the deck, the keepsakes at a chapter end, the projection spell"
  }
  tables: {
    evolves: "what other people propose: a telling, a spell, a rule, a QA note"
    unit: "a link (?spell=, ?rules=) or a copied Spw note"
    carrier: "the reader visit (sessionStorage), then the maker inbox"
    check: "a proposal is read by the same parser as the canon before anyone reads it by eye"
    read_back: "a proposal accepted into canon is credited in the release note by its table"
  }
}

^"ecosystem"{
  cadence: "stones on the 13th and 26th stay the promise; a stone may be a room, a palette, a rule or a chapter, and a chapter completes over several stones. Missing a stone is allowed; breaking a promise to a reader is not"
  release_protocol: "write → set the room (or add the entry) → npm run chapters:build → book:check, spw:lint, spw:probes, build, dist:verify → one line of meaning in changes.json → commit → push"
  semantic_ledger: "each release keeps a small snapshot of meaning (rooms set, wonders, leans, rules) so the next release can say what changed in meaning, not only in files"
  provenance: "the folio archive lives on spwashi.com; lore.land links and never copies; every carry, palette and card can say where it came from"
  continuity: "returning readers keep their way of reading: new modes are trials or switches (c019), and the default read is unchanged unless they choose"
  sustenance: "the work is sustained by folios (originals with a low chance of fulfilment, interpretations, prints), priced by an auditable spell, never by ledgering the land in the story"
  durability: "static pages, no runtime services, offline reading, print; the canon is text in a git repository; a parser that cannot load falls back to a smaller one"
  upstream: "the language is made in spw-workbench; lore.land is its heaviest reader, and sends back what it learns"
}

^premium{
  .note: "the premium is a handful of game mechanics, each one sentence with a landing page, unlocked by weight (f13); written so that what is free stays free"
  &layers: ~".spw/surfaces/layers.spw#lore_land_surfaces_layers"
  &registers: ~".spw/runtime/bias.spw#lore_land_runtime_bias"
  never: "the story is whole and free: no room, chapter, ending, palette or card is ever behind a payment; the audience gate (late table, household key) is care, never commerce; no ads, no tracking, no streaks, no points to buy"
  mechanic: "Spw spells that bias how the land answers: a reader casts a meme register as a bias edge (=meme[pov]{ pop toast %often[0.5] }) and the game pops, toasts, tags, spills, reveals, points and settle receipts may answer in it, never the story (book/scripts/modules/spw-bias.mjs). One house register for a visit is free, and so is any spell a link or a paste brings; choosing two at the desk is the first unlock (two_registers)"
  unlocks: "the premium is mechanics, not a plan: each is easy to say in one sentence and has a landing page (pie/unlocks/<page>/, written from .spw/runtime/mechanics.spw by npm run unlocks:build) saying what it does, how it unlocks and what nobody loses. A mechanic unlocks by weight: rooms read, wonders kept, cards turned, rhythms found and carries finished, each weighted for that mechanic (carries capped, so reading counts most). Any mechanic can be tried for a visit from a link (?try=its-page); whoever had carried a pie before it became an unlock keeps it (book/scripts/modules/unlocks.mjs)"
  layering: "features stack in layers from the floor up (ground, reader, visit, trial, table, bias, keeper, maker); each says what it may touch, what it never touches, how it is undone and where it is kept; every mechanic is placed with premium: unlock, and the combinations of bias with another layer are candidates for more mechanics, each with its free floor (layers.spw); spw:probes premium_floor fails if anything on the ground is marked premium"
  for_tables: "a table that changes the game together: named rule sets, tunings and a table’s own meme registers kept and synced across devices, a shared QA log of card notes, proposals gathered for the maker (f6), all of it exportable as Spw so nothing is locked in"
  for_keepers: "printed cards and folio prints that carry their spell and provenance, read back by the parser; a printed deck is the same deck the reader turned"
  for_makers: "the engine with its checks and tools as a starter for another book (L18), with the rules dialect, rooms and the loom"
  patronage: "patrons are credited in a release note line by their own words; a patron may hear a room the evening before it opens, never instead of anyone"
  pricing: "every price is a spell anyone can read and audit (folio value, f8): what was measured, what moved it, within -25% to +15%"
  data: "marks stay in the reader browser unless they choose to carry or sync them; a sync is a Spw card the reader can read before it goes anywhere"
  test: "a mechanic passes only if a reader can say in one sentence what it does and how it unlocks, and nobody loses anything they had"
}

!"increments"[
  f1: { dimension: [prose, structure], release: "2026_11_08.J", note: "rooms as a unit: a Spw signature and an air for every room, a personality by kind, progress by room, room by room as a trial, and releasing a room at a time (status drafting, due)" }
  f2: { dimension: [rules, valence, grammar], release: "2026_11_08.J", note: "the game reads its rules with the real parser (tune, knocks, powers, lean), dispatches references, and stress-tests the language; cards show their spells, lit" }
  f3: { dimension: [valence], release: "next", done_when: "a release note can say for each chapter which way readers carried it, from counts the reader chose to share, never from tracking", operation: "prime", files: "book/scripts/modules/pie-carries.mjs, the autonomous.feedback client", decides: "the maker: whether readers are asked at all", check: "a shared count is a card the reader sees before sending; the network tab shows nothing without it" }
  f4: { dimension: [prose, world, rules], release: "next", done_when: "npm run book:meaning compares this release with the last (rooms set, wonders, palettes, harmonies, rules) and writes the first draft of its changes.json line", operation: "contract", files: "a new book/scripts/tools/book-meaning.mjs, reading catalog.json, almanac.json and pie-rules.spw at the last tag", decides: "the agent; the maker edits the draft", check: "npm run book:meaning prints what changed in meaning since the last release" }
  f5: { dimension: [grammar], release: "next", done_when: "every finding in spw-stress.spw has an upstream issue drafted, and a pin bump says which it answers", operation: "audit", receipt: "2026-11-10: pin be2df2f; lint warnings 18 to 11; valence_words_reserved answered in part; probe_list_newline re-tested and still open", files: ".spw/surfaces/spw-stress.spw, one upstream: field a finding", decides: "the maker files upstream", check: "every finding has an upstream: field; a pin bump adds an answered: field" }
  f6: { dimension: [tables], release: "next", done_when: "a link of rules or a telling can be saved as a proposal in .spw/state/proposals.spw, read by the parser, and accepted with credit", operation: "prime", files: ".spw/state/proposals.spw, book/scripts/home/pie-spw.mjs", decides: "the maker accepts each proposal", check: "a link of rules saved as a proposal reads whole with the interpreter under book:check" }
  f7: { dimension: [marks], release: "next", done_when: "a reader can carry their marks to another device as one Spw card they copy and paste, read back by the parser, never sent anywhere", operation: "contract", files: "book/scripts/modules/collection.mjs, begin-again.mjs READING_MARKS", decides: "the agent", check: "a card pasted in a fresh headless profile restores the marks, and no request carries it" }
  f8: { dimension: [world], release: "next", done_when: "the folio value spell (formula only, %fulfill, -25% to +15%) is auditable from a carry provenance card", operation: "contract", files: "book/scripts/modules/projection.mjs, .spw/surfaces/projection.spw", decides: "the maker: the formula and the tiers", check: "a carry provenance card shows the spell that produced the price" }
  f9: { dimension: [structure, world, rules], release: "2026_11_08.K", note: "the sigil × chapter audit plan, generated from the canon (npm run spw:sigil-audit → .spw/audits/sigil-chapter-audit.spw): rooms by sigil and kind, wonders first met, materials, harmonies, and the four lenses (components, creatures, ecology, interaction) for every sigil" }
  f10: { dimension: [rules, tables, grammar], release: "2026_11_08.K", note: "Spw as play: spells heard (spw-sound), turned (scrubbable dials, the tuning desk), copied with #from and pasted where they belong, read aloud by the card interpreter, worn as textures; stories as spells woven on the loom; whimsy and scenes in the rules; card sections open to a design table (?design); what this repository asks of the workbench" }
  f11: { dimension: [tables, marks], release: "next", done_when: "the first premium feature (named rule sets and meme registers kept and synced for a table) passes the premium test: nobody who never pays loses anything they had", operation: "prime", files: "book/scripts/modules/unlocks.mjs, .spw/surfaces/layers.spw", decides: "the maker: whether anything is ever paid for", check: "book:check premium floor holds with the feature on and off" }
  f12: { dimension: [rules, tables, grammar], release: "2026_11_08.N", note: "the bias layer: eight house meme registers (bias.spw), each with a palette, a material and a sigil of its own, cast as Spw bias edges that lean how the land answers (pops, toasts, tags, spills, reveals, points, receipts) and never the story; one house register for a visit is free, a combination is the premium plan, open to everyone as a trial (the bias switch, ?bias=); every feature placed in a layer and the premium combinations written with their free floor (layers.spw); spw:probes premium_floor guards the ground; three parser findings logged in spw-stress.spw" }
  f13: { dimension: [rules, marks, pages], release: "2026_11_09.L", note: "premium as mechanics, not a plan: three mechanics (two registers at once, the rhythm groove, in the pocket), each one sentence with a landing page under pie/unlocks/, unlocked by weight from what a reader already keeps (mechanics.spw, unlocks.mjs); tried for a visit by ?try=, kept by anyone who had carried before; layers.spw premium words never, floor, unlock" }
  f14: { dimension: [structure, marks, grammar], release: "2026_11_10.A", note: "tooling: one door (npm run check, read from ci.yml), the workbench CLI mounted read-only (npm run spw), the vendored parser tree-shaken from 634 KB to 174 KB, reader way lines" }
  f15: { dimension: [grammar, tables], release: "proposed", done_when: "a way or a spell can travel in a fragment, so it never reaches a server", operation: "prime", files: "book/scripts/modules/way-through.mjs, projection.mjs, ebook-navigation.mjs (which reads the hash)", decides: "the agent", check: "headless: opening a fragment link sets the visit and the request log has no line in it" }
  f16: { dimension: [structure], release: "proposed", done_when: "a model-neutral AGENTS.md is the gate, CLAUDE.md a short adapter, and a word budget fails the check", operation: "contract", files: "AGENTS.md, CLAUDE.md, book/scripts/tools/check.mjs", decides: "the maker: whether tracked agent settings and hooks belong in a public tree", check: "npm run check fails past the budget" }
  f17: { dimension: [structure], release: "proposed", done_when: "book-check, build-chapters and export-chapters carry // @ts-check under strict, using the types in book-types.mjs", operation: "align", files: "book/scripts/tools/book-check.mjs, book/scripts/tools/build-chapters.mjs, .spw/tools/export-chapters.mjs", decides: "the agent", check: "npm run types passes with the pragma added" }
  f18: { dimension: [structure], release: "proposed", done_when: "the runtime modules that hold data shapes are typed, one reader release at a time", operation: "align", files: "book/scripts/modules/way-through.mjs, characters.mjs, chapter-render.mjs", decides: "the agent; each edit is a reader release", check: "npm run types and npm run smoke" }
  f19: { dimension: [world, grammar], release: "proposed", done_when: "with the Genie under the hat, a pause can show a slip that prices a real change to the board from the panel plan, with no line he has not already said", operation: "prime", files: ".spw/surfaces/genie-practice.spw, book/scripts/home/pie-panels.mjs, book/scripts/home/pie-game.mjs", decides: "the maker: which variant, if any, and every word on the slip", check: "headless: the lanes share on a slip matches planPanels for that change, and book:check finds no new quoted line" }
  f20: { dimension: [pages, grammar], release: "next", done_when: "seen in a browser on a phone held up, a phone on its side and a tablet: Fill fills the display, the lanes stand on the ground, nothing covers a lane in play, the haze shows no row sooner, and the ^board line round-trips through Copy and Read", operation: "realize", files: "book/scripts/home/pie-frame.mjs, book/scripts/home/pie-game.mjs, book/scripts/home/pie-panels.mjs, book/scripts/home/pie-show.mjs, book/styles/home/pie.css", decides: "the maker: whether Fill becomes the default for new players once seen, and the words of each hold", check: "npm run board:check" }
  f21: { dimension: [world, pages, marks], release: "proposed", done_when: "with Pieces of texture.website on in the switches, a room opening or a carry ending finds at most one piece per carry, and its address ?/texture.website/*piece shows the scan from spwashi.com", operation: "prime", files: "book/scripts/modules/texture-finds.mjs, book/scripts/home/pie-game.mjs, book/scripts/home/texture-page.mjs, book/content/packs/texture.website/@spwashi/folios.json", decides: "the maker: which sets join, whether panels join, the switch's words", check: "npm run texture:finds:check" }
  f22: { dimension: [serial, pages, grammar], release: "proposed", done_when: "event routes answer through the ?/ door (day.lore.land, stone.lore.land, and a first promotional entry in book/content/events.json the maker writes), each linked where the maker chooses", operation: "prime", files: "book/content/events.json, book/scripts/modules/route-events.mjs, book/scripts/home/texture-page.mjs, book/scripts/home/day-view.mjs, book/scripts/modules/daily.mjs", decides: "the maker: event names, the first promotion and its window, where each is linked", check: "npm run book:check" }
  f23: { dimension: [world, grammar], release: "proposed", done_when: "the maker has chosen among the proposed inventions, liminal mechanics and prompts, and the chosen ones are slices of their own; the folded weight in the cast is read and kept or cut", operation: "prime", files: "book/scripts/modules/characters.mjs, .spw/surfaces/inventions.spw, .spw/surfaces/liminal-physics.spw, .spw/surfaces/prompts.spw", decides: "the maker: every invention, mechanic and prompt, and each line of the weight", check: "npm run book:check" }
  f24: { dimension: [grammar, play], release: "proposed", done_when: "formulas and the land's answers are cast at the desk in a browser, and the maker has written or left open each mind's row", operation: "prime", files: "book/scripts/modules/spw-formulas.mjs, book/scripts/modules/land-answers.mjs, book/scripts/modules/scriptorium-desk.mjs, .spw/surfaces/formulas.spw", decides: "the maker: which minds have tables, whether the land answers in the lanes, <boon>.land as a surface", check: "npm run formulas:check" }
  f25: { dimension: [grammar, play], release: "proposed", done_when: "one projection is playable from a line written at the desk", operation: "prime", files: "book/scripts/modules/spw-play-graph.mjs, book/scripts/modules/spw-gradients.mjs, .spw/surfaces/ast-play.spw, .spw/surfaces/gradients.spw", decides: "the maker: which projection first, the container reading, the weights", check: "npm run play-graph:check" }
  f26: { dimension: [world, play], release: "proposed", done_when: "the maker has chosen which rooms, twins and realm forms enter chapters or the lanes, and each chosen one is a slice", operation: "prime", files: ".spw/surfaces/three-lands.spw, .spw/surfaces/realm-powers.spw, book/content/world/berries.json", decides: "the maker: rooms, forms, and where the bowl is seen", check: "npm run spw:lint" }
  f27: { dimension: [world, play], release: "proposed", done_when: "with the mimes-remember trial on, seen in a browser: a mime's wall breaks with no tilt, the grudge is kept across carries and makes later marches likelier, a bakery mime leaves flour, Ask says who each mime was; clown and mime pairs are a slice of their own", operation: "prime", files: "book/scripts/home/pie-mimes.mjs, book/scripts/home/pie-game.mjs, book/scripts/modules/reading-switches.mjs", decides: "the maker: the former lives, the grudge's pace, whether the trial becomes a default", check: "npm run book:check" }
  f28: { dimension: [world, play, grammar], release: "proposed", done_when: "with the shelves trial on, seen in a browser: deeds feed the vector each room, BaneWAP's scheme is drawn from the odds, a chain firing is said in the lanes, Ask shows whose and why", operation: "prime", files: "book/scripts/modules/valence-shelves.mjs, book/scripts/home/pie-reasons.mjs, book/scripts/home/pie-game.mjs, .spw/surfaces/shelves.spw", decides: "the maker: the weights, the firmness a new reader starts at, which branches carry signatures next", check: "npm run shelves:check" }
  f29: { dimension: [grammar, play, sound], release: "proposed", done_when: "a line cast at the desk with the land-answers trial on shows its ring, is heard in Boof's time and in another's on a press, and ?cast= reopens it; heard by a person", operation: "prime", files: "book/scripts/modules/spw-cadence.mjs, book/scripts/modules/scriptorium-desk.mjs, .spw/surfaces/cadences.spw", decides: "the maker: each character's cadence, whether found lane rhythms become kept lines", check: "npm run cadence:check" }
  f30: { dimension: [world, play], release: "proposed", done_when: "with the anthills trial on, seen in a browser: an anthill bumps and gossips without a spill, ants roll a boonberry home, a crow takes a gift at the edge, a mime eats or waits by the order, Ask says whose and why", operation: "prime", files: "book/scripts/home/pie-ants.mjs, book/scripts/modules/wish-kitchen.mjs, book/scripts/home/pie-game.mjs, .spw/surfaces/gossip-and-kitchens.spw", decides: "the maker: the special chef, the regional dish, the corvids' names, whether wished dishes reach the desk", check: "npm run kitchen:check" }
]

?open{
  room_cadence: "is a stone a room, or a chapter in rooms? the plan allows both and watches which the maker can keep"
  shared_counts: "how to let readers share what their carries did without tracking them (f3)"
  proposal_trust: "how a table proposal is reviewed before it reaches a reader (f6)"
}
