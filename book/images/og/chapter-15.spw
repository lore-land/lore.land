# Chapter Fifteen, Pupil, Parcel, or Door: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil.
#>share_chapter_15
!card{
  *chapter_15{
    .file["chapter-15.jpg"]
    .plate["book/images/15.png"]
    #title["Pupil, Parcel, or Door"]
    #in_which["one stranger is written down three ways, and all three are right"]
    #says["Chapter Fifteen, Pupil, Parcel, or Door: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil."]
    %width[1200]
    %height[630]
    %brightness[92]
    %saturation[96]
    %quality[93]
    =@fit{ @cover }
    =@grade{ @softer }
    =@veil{ @leaf_dark }
    =@type{ @georgia }
    =@sigil{ @bud }
    =@codec{ @jpeg }
  }
}
