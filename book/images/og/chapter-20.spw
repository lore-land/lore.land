# Chapter Twenty, Two Springs Under the Sill: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil.
#>share_chapter_20
!card{
  *chapter_20{
    .file["chapter-20.jpg"]
    .plate["book/images/20.png"]
    #title["Two Springs Under the Sill"]
    #in_which["two canal gates share a swollen sill by taking turns every third chime, while Mr. BaneWAP tastes bitter jam"]
    #says["Chapter Twenty, Two Springs Under the Sill: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil."]
    %width[1200]
    %height[630]
    %brightness[92]
    %saturation[96]
    %quality[93]
    =@fit{ @cover }
    =@grade{ @softer }
    =@veil{ @leaf_dark }
    =@type{ @georgia }
    =@sigil{ @bud }
    =@codec{ @jpeg }
  }
}
