# Chapter Twenty-Five, Before the Vault Opens Itself: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil.
#>share_chapter_25
!card{
  *chapter_25{
    .file["chapter-25.jpg"]
    .plate["book/images/25.png"]
    #title["Before the Vault Opens Itself"]
    #in_which["every unfinished ingredient from the season simmers under one bakehouse vault while hungry clowns wait politely outside"]
    #says["Chapter Twenty-Five, Before the Vault Opens Itself: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil."]
    %width[1200]
    %height[630]
    %brightness[92]
    %saturation[96]
    %quality[93]
    =@fit{ @cover }
    =@grade{ @softer }
    =@veil{ @leaf_dark }
    =@type{ @georgia }
    =@sigil{ @bud }
    =@codec{ @jpeg }
  }
}
