# Chapter Twenty-Three, Pi at the Night School: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil.
#>share_chapter_23
!card{
  *chapter_23{
    .file["chapter-23.jpg"]
    .plate["book/images/23.png"]
    #title["Pi at the Night School"]
    #in_which["grown-ups gather by tallow light to measure a circle with string and dividers that refuses to close evenly"]
    #says["Chapter Twenty-Three, Pi at the Night School: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil."]
    %width[1200]
    %height[630]
    %brightness[92]
    %saturation[96]
    %quality[93]
    =@fit{ @cover }
    =@grade{ @softer }
    =@veil{ @leaf_dark }
    =@type{ @georgia }
    =@sigil{ @bud }
    =@codec{ @jpeg }
  }
}
