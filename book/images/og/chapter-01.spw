# Chapter One, Dawn in Boon.land: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil.
#>share_chapter_01
!card{
  *chapter_01{
    .file["chapter-01.jpg"]
    .plate["book/images/01.png"]
    #title["Dawn in Boon.land"]
    #in_which["a dog finds an egg the maps will not admit"]
    #says["Chapter One, Dawn in Boon.land: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil."]
    %width[1200]
    %height[630]
    %brightness[92]
    %saturation[96]
    %quality[93]
    =@fit{ @cover }
    =@grade{ @softer }
    =@veil{ @leaf_dark }
    =@type{ @georgia }
    =@sigil{ @bud }
    =@codec{ @jpeg }
  }
}
