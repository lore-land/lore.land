# Chapter Thirteen, The Shell-Shaped Door: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil.
#>share_chapter_13
!card{
  *chapter_13{
    .file["chapter-13.jpg"]
    .plate["book/images/13.png"]
    #title["The Shell-Shaped Door"]
    #in_which["the last door is shaped like a shell, and stays open"]
    #says["Chapter Thirteen, The Shell-Shaped Door: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil."]
    %width[1200]
    %height[630]
    %brightness[92]
    %saturation[96]
    %quality[93]
    =@fit{ @cover }
    =@grade{ @softer }
    =@veil{ @leaf_dark }
    =@type{ @georgia }
    =@sigil{ @bud }
    =@codec{ @jpeg }
  }
}
