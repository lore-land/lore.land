# Chapter Eighteen, Flour in the Bell-Tower: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil.
#>share_chapter_18
!card{
  *chapter_18{
    .file["chapter-18.jpg"]
    .plate["book/images/18.png"]
    #title["Flour in the Bell-Tower"]
    #in_which["one misplaced step fills the belfry with flour, and the city’s loudest bell strikes in white silence"]
    #says["Chapter Eighteen, Flour in the Bell-Tower: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil."]
    %width[1200]
    %height[630]
    %brightness[92]
    %saturation[96]
    %quality[93]
    =@fit{ @cover }
    =@grade{ @softer }
    =@veil{ @leaf_dark }
    =@type{ @georgia }
    =@sigil{ @bud }
    =@codec{ @jpeg }
  }
}
