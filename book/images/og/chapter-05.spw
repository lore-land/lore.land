# Chapter Five, The Quiet Rift: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil.
#>share_chapter_05
!card{
  *chapter_05{
    .file["chapter-05.jpg"]
    .plate["book/images/05.png"]
    #title["The Quiet Rift"]
    #in_which["two slips try to be one harvest"]
    #says["Chapter Five, The Quiet Rift: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil."]
    %width[1200]
    %height[630]
    %brightness[92]
    %saturation[96]
    %quality[93]
    =@fit{ @cover }
    =@grade{ @softer }
    =@veil{ @leaf_dark }
    =@type{ @georgia }
    =@sigil{ @bud }
    =@codec{ @jpeg }
  }
}
