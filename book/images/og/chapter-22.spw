# Chapter Twenty-Two, Through the Chute With No Receipt: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil.
#>share_chapter_22
!card{
  *chapter_22{
    .file["chapter-22.jpg"]
    .plate["book/images/22.png"]
    #title["Through the Chute With No Receipt"]
    #in_which["parcels slide down a copper chute as descriptions of someone else’s bundle while receipts blow up the return duct"]
    #says["Chapter Twenty-Two, Through the Chute With No Receipt: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil."]
    %width[1200]
    %height[630]
    %brightness[92]
    %saturation[96]
    %quality[93]
    =@fit{ @cover }
    =@grade{ @softer }
    =@veil{ @leaf_dark }
    =@type{ @georgia }
    =@sigil{ @bud }
    =@codec{ @jpeg }
  }
}
