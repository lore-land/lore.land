# Chapter Two, The First Echo: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil.
#>share_chapter_02
!card{
  *chapter_02{
    .file["chapter-02.jpg"]
    .plate["book/images/02.png"]
    #title["The First Echo"]
    #in_which["the grove answers a beat late, and will not swear to it"]
    #says["Chapter Two, The First Echo: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil."]
    %width[1200]
    %height[630]
    %brightness[92]
    %saturation[96]
    %quality[93]
    =@fit{ @cover }
    =@grade{ @softer }
    =@veil{ @leaf_dark }
    =@type{ @georgia }
    =@sigil{ @bud }
    =@codec{ @jpeg }
  }
}
