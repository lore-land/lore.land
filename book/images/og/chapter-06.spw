# Chapter Six, Lanterns of Bonk City: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil.
#>share_chapter_06
!card{
  *chapter_06{
    .file["chapter-06.jpg"]
    .plate["book/images/06.png"]
    #title["Lanterns of Bonk City"]
    #in_which["glass shows a light it does not own"]
    #says["Chapter Six, Lanterns of Bonk City: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil."]
    %width[1200]
    %height[630]
    %brightness[92]
    %saturation[96]
    %quality[93]
    =@fit{ @cover }
    =@grade{ @softer }
    =@veil{ @leaf_dark }
    =@type{ @georgia }
    =@sigil{ @bud }
    =@codec{ @jpeg }
  }
}
