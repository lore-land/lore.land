# Chapter Eleven, Paradox Bloom: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil.
#>share_chapter_11
!card{
  *chapter_11{
    .file["chapter-11.jpg"]
    .plate["book/images/11.png"]
    #title["Paradox Bloom"]
    #in_which["a garden blooms before its seed arrives"]
    #says["Chapter Eleven, Paradox Bloom: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil."]
    %width[1200]
    %height[630]
    %brightness[92]
    %saturation[96]
    %quality[93]
    =@fit{ @cover }
    =@grade{ @softer }
    =@veil{ @leaf_dark }
    =@type{ @georgia }
    =@sigil{ @bud }
    =@codec{ @jpeg }
  }
}
