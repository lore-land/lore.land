# Chapter Twenty-Four, Four Windows in One Wall: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil.
#>share_chapter_24
!card{
  *chapter_24{
    .file["chapter-24.jpg"]
    .plate["book/images/24.png"]
    #title["Four Windows in One Wall"]
    #in_which["four masking shutters prove four opposite laws until two open at once and show the unbroken courtyard"]
    #says["Chapter Twenty-Four, Four Windows in One Wall: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil."]
    %width[1200]
    %height[630]
    %brightness[92]
    %saturation[96]
    %quality[93]
    =@fit{ @cover }
    =@grade{ @softer }
    =@veil{ @leaf_dark }
    =@type{ @georgia }
    =@sigil{ @bud }
    =@codec{ @jpeg }
  }
}
