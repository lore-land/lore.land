# Chapter Eight, Songs of the Watering Eye: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil.
#>share_chapter_08
!card{
  *chapter_08{
    .file["chapter-08.jpg"]
    .plate["book/images/08.png"]
    #title["Songs of the Watering Eye"]
    #in_which["water keeps a face without stealing it"]
    #says["Chapter Eight, Songs of the Watering Eye: the plate covered to 1200 by 630, softened, veiled leaf-dark, and set in Georgia with the bud sigil."]
    %width[1200]
    %height[630]
    %brightness[92]
    %saturation[96]
    %quality[93]
    =@fit{ @cover }
    =@grade{ @softer }
    =@veil{ @leaf_dark }
    =@type{ @georgia }
    =@sigil{ @bud }
    =@codec{ @jpeg }
  }
}
