# The third round: the crust again, so a WAP is never one recording.
#>sound_wap_3
!take{
  *3{
    .file["3.m4a"]
    .event["wap"]
    #says["The third round: the crust again, so a WAP is never one recording."]
    #means["crust"]
    %gain[1]
    %duration[0.2]
    %cap[0.2]
    %hear[1000]
    %q[0.7]
    &source[~"https://github.com/sgossner/VCSL/tree/c1ea7bcc3c7309650ab0da9d15c9cd1fbc4a4c7e/Idiophones/Struck%20Idiophones/Slapstick"]
    #license["CC0-1.0"]
    #author["Versilian Studios LLC"]
    #retrieved["2026-11-09"]
    =@channels{ @mono }
    =@window{ @loudest }
    =@edges{ @fade }
    =@peak{ @minus3 }
    =@codec{ @aac }
    =@heard{ @highpass }
  }
}
