# Another struck round: the field, not a thud.
#>sound_step_field_3
!take{
  *3{
    .file["3.m4a"]
    .event["step-field"]
    #says["Another struck round: the field, not a thud."]
    #means["grass"]
    %gain[0.75]
    %duration[0.28]
    %cap[0.28]
    %hear[1300]
    %q[0.7]
    &source[~"https://github.com/sgossner/VCSL/tree/c1ea7bcc3c7309650ab0da9d15c9cd1fbc4a4c7e/Idiophones/Struck%20Idiophones/Guiro"]
    #license["CC0-1.0"]
    #author["Versilian Studios LLC"]
    #retrieved["2026-11-09"]
    =@channels{ @mono }
    =@window{ @loudest }
    =@edges{ @fade }
    =@peak{ @minus3 }
    =@codec{ @aac }
    =@heard{ @bandpass }
  }
}
