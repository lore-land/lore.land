# A smaller drum: the same arrival, less of it.
#>sound_land_3
!take{
  *3{
    .file["3.m4a"]
    .event["land"]
    #says["A smaller drum: the same arrival, less of it."]
    #means["weight"]
    %gain[0.8]
    %duration[0.28]
    %cap[0.28]
    %hear[1100]
    %q[0.7]
    &source[~"https://github.com/sgossner/VCSL/tree/c1ea7bcc3c7309650ab0da9d15c9cd1fbc4a4c7e/Membranophones/Struck%20Membranophones/Frame%20Drum"]
    #license["CC0-1.0"]
    #author["Versilian Studios LLC"]
    #retrieved["2026-11-09"]
    =@channels{ @mono }
    =@window{ @loudest }
    =@edges{ @fade }
    =@peak{ @minus3 }
    =@codec{ @aac }
    =@heard{ @lowpass }
  }
}
