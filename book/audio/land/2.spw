# The same drum, the other hand.
#>sound_land_2
!take{
  *2{
    .file["2.m4a"]
    .event["land"]
    #says["The same drum, the other hand."]
    #means["weight"]
    %gain[0.85]
    %duration[0.32]
    %cap[0.32]
    %hear[1100]
    %q[0.7]
    &source[~"https://github.com/sgossner/VCSL/tree/c1ea7bcc3c7309650ab0da9d15c9cd1fbc4a4c7e/Membranophones/Struck%20Membranophones/Frame%20Drum"]
    #license["CC0-1.0"]
    #author["Versilian Studios LLC"]
    #retrieved["2026-11-09"]
    =@channels{ @mono }
    =@window{ @loudest }
    =@edges{ @fade }
    =@peak{ @minus3 }
    =@codec{ @aac }
    =@heard{ @lowpass }
  }
}
