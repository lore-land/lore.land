# The full-bleed gold bud inside the maskable safe zone, 512 pixels.
#>icon_maskable
!icon{
  *icon_maskable{
    .file["icon-maskable-512.png"]
    #says["The full-bleed gold bud inside the maskable safe zone, 512 pixels."]
    %size[512]

    =@sigil{ @bud }
    =@field{ @cover }
    =@scale{ @safe }
  }
}
