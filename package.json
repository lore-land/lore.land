{
  "name": "lore.land",
  "version": "1.0.0",
  "type": "module",
  "description": "A worldbuilding monument: seeded chapters, inspectable craft, and a living serial.",
  "scripts": {
    "predev": "npm run chapters:build",
    "dev": "vite",
    "chapters:build": "node book/scripts/tools/build-chapters.mjs && node book/scripts/tools/build-unlocks.mjs && node book/scripts/tools/feedback-client.mjs",
    "unlocks:build": "node book/scripts/tools/build-unlocks.mjs",
    "sounds:fetch": "node book/scripts/tools/sound-library.mjs",
    "sounds:prepare": "node book/scripts/tools/prepare-pie-sounds.mjs",
    "spw:export": "node .spw/tools/export-chapters.mjs",
    "spw:project": "node .spw/tools/project-public-spw.mjs",
    "spw:verify": "node .spw/tools/project-public-spw.mjs --verify",
    "dist:static": "node book/scripts/tools/project-dist-static.mjs",
    "dist:verify": "node book/scripts/tools/project-dist-static.mjs --verify && npm run spw:verify",
    "build": "npm run chapters:build && npm run spw:export && npm run canon:build && vite build && npm run spw:project && npm run dist:static",
    "preview": "vite preview",
    "font": "node book/scripts/tools/font/build.mjs",
    "font:trace": "node book/scripts/tools/font/hand/trace-alphabet.mjs",
    "font:hand": "node book/scripts/tools/font/hand/build-hand.mjs",
    "texture:mine": "node book/scripts/tools/texture/mine-folios.mjs",
    "assets:optimize": "node book/scripts/tools/assets/optimize-assets.mjs",
    "assets:optimize:dry": "node book/scripts/tools/assets/optimize-assets.mjs --dry-run",
    "assets:brand": "node book/scripts/tools/assets/brand-assets.mjs",
    "assets:studies": "node book/scripts/tools/assets/artifact-studies.mjs",
    "book:check": "node book/scripts/tools/book-check.mjs",
    "check": "node book/scripts/tools/check.mjs",
    "types": "tsc -p tsconfig.tools.json",
    "smoke": "node book/scripts/tools/browser-smoke.mjs",
    "tools:test": "node --test --test-timeout=180000 \"tools/browser-harness/test/*.test.mjs\" \".spw/tools/*.test.mjs\"",
    "spw": "node .spw/tools/spw-cli.mjs",
    "canon:build": "npm run spw:characters && npm run spw:way && npm run spw:likeness && npm run spw:sigil-audit && npm run spw:progression",
    "tokens:align": "node book/scripts/tools/align-tokens.mjs",
    "spw:probes": "node .spw/tools/alignment-probes.mjs",
    "spw:plates": "node .spw/tools/plates-manifest.mjs",
    "spw:lint": "tsx .spw/tools/spw-lint.mjs",
    "spw:seed-bundle": "node book/scripts/tools/bundle-spw-seed.mjs",
    "spw:seed-bundle:verify": "node book/scripts/tools/bundle-spw-seed.mjs --verify",
    "spw:trope-prompt": "node .spw/tools/trope-prompt.mjs",
    "spw:sigil-audit": "node .spw/tools/sigil-audit.mjs",
    "spw:characters": "node .spw/tools/characters-canon.mjs",
    "spw:plans": "node .spw/tools/plan-gate.mjs",
    "board:check": "node book/scripts/tools/board-check.mjs",
    "texture:finds:build": "node book/scripts/tools/texture-finds-build.mjs",
    "texture:finds:check": "node book/scripts/tools/texture-finds-check.mjs",
    "formulas:check": "node book/scripts/tools/formulas-check.mjs",
    "shelves:check": "node book/scripts/tools/shelves-check.mjs",
    "cadence:check": "node book/scripts/tools/cadence-check.mjs",
    "kitchen:check": "node book/scripts/tools/kitchen-check.mjs",
    "daily:check": "node book/scripts/tools/daily-check.mjs",
    "play-graph:check": "node book/scripts/tools/play-graph-check.mjs",
    "spw:way": "node .spw/tools/way-canon.mjs",
    "spw:likeness": "node .spw/tools/likeness-index.mjs",
    "spw:progression": "node .spw/tools/progression-audit.mjs",
    "css:audit": "node book/scripts/tools/css-audit.mjs"
  },
  "keywords": [],
  "author": "Sam Washington",
  "license": "ISC",
  "devDependencies": {
    "@types/node": "22.20.5",
    "esbuild": "0.28.2",
    "opentype.js": "^1.3.4",
    "tsx": "^4.23.1",
    "typescript": "5.9.3",
    "vite": "^7.3.1"
  }
}
