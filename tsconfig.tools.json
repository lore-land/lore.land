{
  "compilerOptions": {
    "target": "ES2023",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "allowJs": true,
    "checkJs": false,
    "noEmit": true,
    "strict": true,
    "skipLibCheck": true,
    "types": ["node"],
    "lib": ["ES2023", "DOM", "DOM.Iterable"]
  },
  "include": ["book/schema/*.mjs", "book/scripts/tools/**/*.mjs", ".spw/tools/*.mjs", "tools/**/*.mjs"],
  "exclude": ["book/scripts/vendor/**", "tools/audio_synthesis/**", ".spw/_workbench/**", "node_modules/**"]
}
